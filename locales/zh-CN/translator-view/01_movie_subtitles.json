  "entries": [
    {
      "id": "ep01::EP01_CP1_01::0",
      "jp": "197６年 日本の山奥で一つの村が消えた",
      "zh": "1976年，日本深山中的一个村落消失了。"
    },
    {
      "id": "ep01::EP01_CP1_02::0",
      "jp": "それから数十年を経て人気の絶えたこの村を訪れた米国ＴVクルー一行は",
      "zh": "此后数十年，\n一队美国电视台摄制组造访了这座人迹绝迹的村庄。"
    },
    {
      "id": "ep01::EP01_CP1_03::0",
      "jp": "理解し難い光景に遭遇する",
      "zh": "遭遇了难以理解的光景"
    },
    {
      "id": "ep01::EP01_CP1_04::0",
      "jp": "「うわっ……何だよ 何だよこれ」",
      "zh": "「哇啊……什么啊，这是什么啊。」"
    },
    {
      "id": "ep01::EP01_CP1_05::0",
      "jp": "「ねえ さっき変な感じじやなかった？ 一瞬 揺れたような……」",
      "zh": "「喂，刚才的感觉好奇怪，好像被什么东西拉了一下……」"
    },
    {
      "id": "ep01::EP01_CP1_06::0",
      "jp": "「あっ！ あの人達 何やってるの？」",
      "zh": "「啊！那些人在干什么？」"
    },
    {
      "id": "ep01::EP01_CP1_07::0",
      "jp": "「村人は消えたんじやなかったの？何なのこの人達？」",
      "zh": "「村民不是都消失了吗？\n这些人到底是什么？」"
    },
    {
      "id": "ep01::EP01_CP1_08::0",
      "jp": "「しいーっ！」",
      "zh": "「嘘——！」"
    },
    {
      "id": "ep01::EP01_CP1_09::0",
      "jp": "「やめて！」",
      "zh": "「住手！」"
    },
    {
      "id": "ep01::EP01_CP1_10::0",
      "jp": "「ちくしよう！ マジでまずいそ！ やりやがったよ！ くそっ！」",
      "zh": "「可恶！这下真不妙了！他们动手了！混蛋！」"
    },
    {
      "id": "ep01::EP01_CP1_11::0",
      "jp": "「ねえ 嘘でしよう？あの子本当に殺されたの？ 信じられない！」",
      "zh": "「喂，骗人的吧？\n那孩子真的被杀了？难以置信！」"
    },
    {
      "id": "ep01::EP01_CP1_12::0",
      "jp": "「やめて！ 酷い！ こんな事を神は望まれていない！」",
      "zh": "「住手！太过分了！神不会希望发生这种事的！」"
    },
    {
      "id": "ep01::EP01_CP1_13::0",
      "jp": "「しいーっ！ 彼らに聞こえる！ もっと静かに」",
      "zh": "「嘘——！会被他们听见的！再小声一点！」"
    },
    {
      "id": "ep01::EP01_CP1_14::0",
      "jp": "「いやっ！ あの女の子も殺されちやう！」",
      "zh": "「不要！那个女孩也会被杀掉的！」"
    },
    {
      "id": "ep01::EP01_CP1_15::0",
      "jp": "「くそっ！ 何とかしないと！」",
      "zh": "「混蛋！得想办法才行！」"
    },
    {
      "id": "ep01::EP01_CP1_16::0",
      "jp": "「もう嫌……」",
      "zh": "「我受够了…」"
    },
    {
      "id": "ep01::EP01_CP1_17::0",
      "jp": "「あの女の子逃げたわ！」",
      "zh": "「那个女孩逃走了！」"
    },
    {
      "id": "ep01::EP01_CP1_18::0",
      "jp": "「おい！ 何やってんだよ！ やめろ！」",
      "zh": "「喂！你在干什么！住手！」"
    },
    {
      "id": "ep01::EP01_CP1_19::0",
      "jp": "「お おい！ あいつ止めに入ったそ！」",
      "zh": "「喂、喂！那家伙冲上去阻拦了！」"
    },
    {
      "id": "ep01::EP01_CP1_20::0",
      "jp": "「バカ野郎っ！」",
      "zh": "「笨蛋！」"
    },
    {
      "id": "ep01::EP01_CP1_21::0",
      "jp": "「まずいそ！ 早く警察に連絡！」",
      "zh": "「不妙了！快报警！」"
    },
    {
      "id": "ep01::EP01_CP1_22::0",
      "jp": "「携帯義がらない……」",
      "zh": "「手机连不上……」"
    },
    {
      "id": "ep01::EP01_CP1_23::0",
      "jp": "「嫌 もう見たくない！」",
      "zh": "「我不想再看了！」"
    },
    {
      "id": "ep01::EP01_CP1_24::0",
      "jp": "「ねえ あれ日本で用意した役者？」",
      "zh": "「喂，那些是日本请来的演员吗？」"
    },
    {
      "id": "ep01::EP01_CP1_25::0",
      "jp": "「くそっ！ あいつらよくもあんなことを！人殺し野郎共 頭イカれてるよ！」",
      "zh": "「混蛋！那些家伙居然做出那种事！\n杀人凶手，全都疯了！」"
    },
    {
      "id": "ep01::EP01_CP1_26::0",
      "jp": "「くそっ！ くそっ！」",
      "zh": "「可恶！可恶！」"
    },
    {
      "id": "ep01::EP01_CP1_27::0",
      "jp": "同日 同じく村を訪れていた少年ハワード・ライトは",
      "zh": "与此同时，同样造访村庄的少年霍华德·莱特，"
    },
    {
      "id": "ep01::EP01_CP1_28::0",
      "jp": "同日 同じく村を訪れていた少年ハワード・ライトは",
      "zh": "与此同时，同样造访村庄的少年霍华德·莱特，"
    },
    {
      "id": "ep01::EP01_CP1_29::0",
      "jp": "これを境に恐るべき怪異に巻き込まれていく",
      "zh": "以此为契机，被卷入了可怕的怪异物之中。"
    },
    {
      "id": "ep01::EP01_CP1_30::0",
      "jp": "「助けて！ 女の人が刺されたんだ！」",
      "zh": "「救命！有个女人被杀了！」"
    },
    {
      "id": "ep01::EP01_CP1_31::0",
      "jp": "「たすけて！ ひとがしんだ！」",
      "zh": "「救命！有人死了！」"
    },
    {
      "id": "ep01::EP01_CP1_32::0",
      "jp": " ",
      "zh": " "
    },
    {
      "id": "ep01::EP01_CP1_33::0",
      "jp": "「くそっ！ どこ行ってんだよ！」",
      "zh": "「混蛋！跑哪去了！」"
    },
    {
      "id": "ep01::EP01_CP3_01::0",
      "jp": "「マミィが怖いのはわかるけど 泣かないで」",
      "zh": "「我知道你怕妈咪，但别哭了。」"
    },
    {
      "id": "ep01::EP01_CP3_02::0",
      "jp": "「それより何よその古臭い眼鏡！離婚したらプレゼントも捨てなさいよ！」",
      "zh": "「比起这个，那老土的东西算什么！\n既然分手了，连礼物也该一起扔掉！」"
    },
    {
      "id": "ep01::EP01_CP3_03::0",
      "jp": "「別れた妻のプレゼントを平気で使い続けるその神経が耐えられない！」",
      "zh": "「分手了还若无其事地用着对方送的礼物，\n这种神经我实在无法理解！」"
    },
    {
      "id": "ep01::EP01_CP3_04::0",
      "jp": "「返ぜ！ 捨てろ！」",
      "zh": "「还回来！扔掉！」"
    },
    {
      "id": "ep01::EP01_CP3_05::0",
      "jp": "「おい やめろよ！ 代えが無いんだよ！」",
      "zh": "「喂，住手！我没有能替换的！」"
    },
    {
      "id": "ep01::EP01_CP3_06::0",
      "jp": "「おい やめろよ！ 代えが無いんだよ！」",
      "zh": "「喂，住手！我没有能替换的！」"
    },
    {
      "id": "ep01::EP01_CP3_07::0",
      "jp": "「おいおいおい 何やってんだよ二人とも！人が死んでるんだそ？」",
      "zh": "「喂喂喂，你们两个在干什么！\n有人死了啊？」"
    },
    {
      "id": "ep01::EP01_CP3_08::0",
      "jp": "「こんな時にくだらない喧嘩やめてくれよ！」",
      "zh": "「都这种时候了，别为无聊的事吵架了！」"
    },
    {
      "id": "ep01::EP01_CP3_09::0",
      "jp": "「何でこんな事になっちやうんだよ……」",
      "zh": "「为什么会变成这样……」"
    },
    {
      "id": "ep01::EP01_CP3_10::0",
      "jp": "「なんだよこれ？」",
      "zh": "「这是怎么回事？」"
    },
    {
      "id": "ep01::EP01_CP2_1_01::0",
      "jp": "「了解 射殺します」",
      "zh": "「明白，开枪射击。」"
    },
    {
      "id": "ep01::EP01_CP2_1_02::0",
      "jp": "「お おい！ ちよっと待っ……」",
      "zh": "「喂、喂！等一下……」"
    },
    {
      "id": "ep01::EP01_CP2_1_03::0",
      "jp": "「くそっ！」",
      "zh": "「混蛋！」"
    },
    {
      "id": "ep01::EP01_CP2_2_01::0",
      "jp": "「くそっ！ くそっ！」",
      "zh": "「可恶！可恶！」"
    },
    {
      "id": "ep01::EP01_CP2_2_02::0",
      "jp": "「大人しくしなさい！」",
      "zh": "「老实点！」"
    },
    {
      "id": "ep01::EP01_CP2_2_03::0",
      "jp": "「くそっ！」",
      "zh": "「可恶！」"
    },
    {
      "id": "ep02::EP02_CP1_01::0",
      "jp": "「ちくしよう！ マジでまずいそ！ やりやがったよ！ くそっ！」",
      "zh": "「可恶！这下真不妙了！他们动手了！混蛋！」"
    },
    {
      "id": "ep02::EP02_CP1_02::0",
      "jp": "「ねえ 嘘でしよう？あの子本当に殺されたの？ 信じられない！」",
      "zh": "「喂，骗人的吧？\n那孩子真的被杀了？难以置信！」"
    },
    {
      "id": "ep02::EP02_CP1_03::0",
      "jp": "「くそっ！ あいつらよくもあんなことを！人殺し野郎共 頭イカれてるよ！」",
      "zh": "「混蛋！那些家伙居然做出那种事！\n杀人凶手，全都疯了！」"
    },
    {
      "id": "ep02::EP02_CP1_04::0",
      "jp": " ",
      "zh": ""
    },
    {
      "id": "ep02::EP02_CP1_05::0",
      "jp": "「了解 射殺します」",
      "zh": "「明白，开枪射击。」"
    },
    {
      "id": "ep02::EP02_CP1_06::0",
      "jp": "「大人しくしなさい！」",
      "zh": "「老实点！」"
    },
    {
      "id": "ep02::EP02_CP1_07::0",
      "jp": "「どこだここは……くそっ まさか番組のやらぜか？」",
      "zh": "「这是哪儿……可恶，难道是节目组安排的假戏？」"
    },
    {
      "id": "ep02::EP02_CP1_08::0",
      "jp": "「あの馬鹿共のやる事は良く分からんからな」",
      "zh": "「那帮蠢货干的事，我实在搞不懂。」"
    },
    {
      "id": "ep02::EP02_CP1_09::0",
      "jp": "「ベラ！ メリッサ！」",
      "zh": "「贝拉！梅丽莎！」"
    },
    {
      "id": "ep02::EP02_CP1_10::0",
      "jp": "「血？」",
      "zh": "「血？」"
    },
    {
      "id": "ep02::EP02_CP3_01::0",
      "jp": "「なんで？ 夢……じやないよな？」",
      "zh": "「为什么？这……不是梦吧？」"
    },
    {
      "id": "ep02::EP02_CP3_02::0",
      "jp": "「くそっ！ なんだ今の？」",
      "zh": "「可恶！刚才那是什么？」"
    },
    {
      "id": "ep02::EP02_CP3_03::0",
      "jp": "「あなた大丈夫？」",
      "zh": "「你没事吧？」"
    },
    {
      "id": "ep02::EP02_CP3_04::0",
      "jp": "「あんた あいつらの仲間だろ？」",
      "zh": "「你是那伙人的同伙吧？」"
    },
    {
      "id": "ep02::EP02_CP3_05::0",
      "jp": "「待って！」",
      "zh": "「等等！」"
    },
    {
      "id": "ep02::EP02_CP3_06::0",
      "jp": "「なんで……」",
      "zh": "「为什么……」"
    },
    {
      "id": "ep02::EP02_CP3_07::0",
      "jp": "「なんて酷い怪我 歩けますか？」",
      "zh": "「伤得这么重，能动吗？」"
    },
    {
      "id": "ep02::EP02_CP3_08::0",
      "jp": "「独りじや危ないです 私と一緒に安全な場所に」",
      "zh": "「一个人太危险了，跟我一起到安全的地方去吧。」"
    },
    {
      "id": "ep02::EP02_CP3_09::0",
      "jp": "「独りじや危ないです 私と一緒に安全な場所に」",
      "zh": "「一个人太危险了，跟我一起到安全的地方去吧。」"
    },
    {
      "id": "ep02::EP02_CP3_10::0",
      "jp": "「大丈夫」",
      "zh": "我没事"
    },
    {
      "id": "ep02::EP02_CP5_01::0",
      "jp": "「死んでも死にきれないとは報われないな」",
      "zh": "「死不瞑目，真是太不值得了。」"
    },
    {
      "id": "ep02::EP02_CP5_02::0",
      "jp": "「死んでも死にきれないとは報われないな」",
      "zh": "「死不瞑目，真是太不值得了。」"
    },
    {
      "id": "ep02::EP02_CP5_03::0",
      "jp": "「心臓を貫かれたとしても それでも……？」",
      "zh": "「就算心脏被贯穿，也还是要……？」"
    },
    {
      "id": "ep02::EP02_CP5_04::0",
      "jp": "「心臓を貫かれたとしても それでも……？」",
      "zh": "「就算心脏被贯穿，也还是要……？」"
    },
    {
      "id": "ep02::EP02_CP5_05::0",
      "jp": "「そんな調子じや逃げ切れないですよ 美耶古様」",
      "zh": "「照这个样子是逃不掉的哦，美耶古大人。」"
    },
    {
      "id": "ep02::EP02_CP5_06::0",
      "jp": "「死ぬなんて嫌……絶対に嫌……！」",
      "zh": "我才不要死……绝对不要！"
    },
    {
      "id": "ep02::EP02_CP7_01::0",
      "jp": "「聖堂に行こうと思います」",
      "zh": "「我想去圣堂。」"
    },
    {
      "id": "ep02::EP02_CP7_02::0",
      "jp": "「聖堂って……あの殺人宗教の祈りの場？」",
      "zh": "「圣堂……那个杀人宗教举行仪式的场所？」"
    },
    {
      "id": "ep02::EP02_CP7_03::0",
      "jp": "「違う！ 違います！ あれは何かの間違いなんです！」",
      "zh": "「不！不是的！那一定是哪里搞错了！」"
    },
    {
      "id": "ep02::EP02_CP7_04::0",
      "jp": "「いやあああ一！」",
      "zh": "不要啊啊——！"
    },
    {
      "id": "ep02::EP02_CP7_05::0",
      "jp": "「おい！ どこだよ！？ 何だよ今の？」",
      "zh": "「喂！你在哪！？刚才那是什么？」"
    },
    {
      "id": "ep02::EP02_CP7_06::0",
      "jp": "「あの子をこんなとこに連れて来るなんて何考えてるの？」",
      "zh": "「把那个孩子带到这种地方来，你到底在想什么？」"
    },
    {
      "id": "ep02::EP02_CP7_07::0",
      "jp": "「だからさっきも説明一一」",
      "zh": "我刚才不是解释过——"
    },
    {
      "id": "ep02::EP02_CP7_08::0",
      "jp": "「うるさい！ 研究取り上げたらただの役立たずのくぜに！」",
      "zh": "「闭嘴！不过是个研究被否了的没用的废物！」"
    },
    {
      "id": "ep02::EP02_CP7_09::0",
      "jp": "「私一人であの子を探す！」",
      "zh": "「我一个人去找那孩子！」"
    },
    {
      "id": "ep02::EP02_CP7_10::0",
      "jp": "「おい！」",
      "zh": "「喂！」"
    },
    {
      "id": "ep02::EP02_CP7_11::0",
      "jp": "「くそっ！ 何だこれは？」",
      "zh": "「可恶！这是什么？」"
    },
    {
      "id": "ep02::EP02_CP7_12::0",
      "jp": "「走れ！ 振り返るな！」",
      "zh": "「快跑！别回头！」"
    },
    {
      "id": "ep02::EP02_CP7_13::0",
      "jp": "「かくれんぼだよベラ！ 上手に隠れられるかな？」",
      "zh": "「来玩捉迷藏哦，贝拉！能好好躲起来吗？」"
    },
    {
      "id": "ep02::EP02_CP7_14::0",
      "jp": "「絶対見つけるよ 約束だ！」",
      "zh": "我一定会找到你，约定了！"
    },
    {
      "id": "ep02::EP02_CP7_15::0",
      "jp": "「お化けなんかいないんだ」",
      "zh": "「根本没有什么鬼。」"
    },
    {
      "id": "ep02::EP02_CP7_16::0",
      "jp": "「お化けは全部嘘っぱち！ だってダディが言ってたもん！」",
      "zh": "「鬼全是骗人的！因为爸爸是这么说的嘛！」"
    },
    {
      "id": "ep03::EP03_CP1_01::0",
