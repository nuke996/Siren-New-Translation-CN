      "zh": "「来玩捉迷藏哦，贝拉！能好好躲起来吗？」"
    },
    {
      "id": "ep03::EP03_CP1_08::0",
      "jp": "「絶対見つけるよ 約束だ！」",
      "zh": "我一定会找到你，约定了！"
    },
    {
      "id": "ep03::EP03_CP1_09::0",
      "jp": "「お化けなんかいないんだ」",
      "zh": "「根本没有什么鬼。」"
    },
    {
      "id": "ep03::EP03_CP1_10::0",
      "jp": "「お化けは全部嘘っぱち！ だってダディが言ってたもん！」",
      "zh": "「鬼全是骗人的！因为爸爸是这么说的嘛！」"
    },
    {
      "id": "ep03::EP03_CP3_01::0",
      "jp": "「ベラ！？」",
      "zh": "「贝拉！？」"
    },
    {
      "id": "ep03::EP03_CP3_02::0",
      "jp": "「ねえベイビー！ 眺ずかしがらないで！」",
      "zh": "「喂，宝贝！别害羞嘛！」"
    },
    {
      "id": "ep03::EP03_CP3_03::0",
      "jp": "「おいっ！」",
      "zh": "「喂！」"
    },
    {
      "id": "ep03::EP03_CP3_04::0",
      "jp": "「大丈夫？」",
      "zh": "你没事吧"
    },
    {
      "id": "ep03::EP03_CP3_05::0",
      "jp": "「美耶古様 ご自分のお役目をお忘れですか？」",
      "zh": "「美耶古大人，您忘了自己的使命吗？」"
    },
    {
      "id": "ep03::EP03_CP3_06::0",
      "jp": "「いやっ！ 放ぜ！」",
      "zh": "「不要！放开我！」"
    },
    {
      "id": "ep03::EP03_CP3_07::0",
      "jp": "「おい！ やめろよ！」",
      "zh": "「喂！住手！」"
    },
    {
      "id": "ep03::EP03_CP3_08::0",
      "jp": "「又 邪鬼する気か？」",
      "zh": "「你又想捣乱吗？」"
    },
    {
      "id": "ep03::EP03_CP3_09::0",
      "jp": "「あんた……さっきの儀式に？」",
      "zh": "「你……刚才的仪式上？」"
    },
    {
      "id": "ep03::EP03_CP3_10::0",
      "jp": "「この少女は呪われた贄だそ」",
      "zh": "「这个少女是被诅咒的祭品。」"
    },
    {
      "id": "ep03::EP03_CP3_11::0",
      "jp": "「災いの根源だ」",
      "zh": "是诅咒之源。"
    },
    {
      "id": "ep03::EP03_CP3_12::0",
      "jp": "「私は 私は生贄なんかじやない！」",
      "zh": "「我、我才不是什么祭品！」"
    },
    {
      "id": "ep03::EP03_CP3_13::0",
      "jp": "「運命に抗ってみますか？ ご自由に」",
      "zh": "「要试着违抗命运吗？随你自由。」"
    },
    {
      "id": "ep03::EP03_CP3_14::0",
      "jp": "「早く連れて行け」",
      "zh": "「快把她带走！」"
    },
    {
      "id": "ep03::EP03_CP5_01::0",
      "jp": "「何？」",
      "zh": "什么"
    },
    {
      "id": "ep03::EP03_CP5_02::0",
      "jp": "「一体どうしてここに？」",
      "zh": "「究竟为什么会在这里？」"
    },
    {
      "id": "ep03::EP03_CP5_03::0",
      "jp": "「神よ……私は何をすべきなのでしようか」",
      "zh": "「神啊……我究竟该做什么才好？」"
    },
    {
      "id": "ep03::EP03_CP5_04::0",
      "jp": "「そんな……まさかここまでとは」",
      "zh": "没想到……竟到了这种地步。"
    },
    {
      "id": "ep03::EP03_CP5_05::0",
      "jp": "「また外国人か？」",
      "zh": "「又是外国人吗？」"
    },
    {
      "id": "ep04::EP04_CP1_01::0",
      "jp": "「助けて！ ダディ！ マミィ！ どこにいるの？」",
      "zh": "「救命！爸爸！妈妈！你们在哪？」"
    },
    {
      "id": "ep04::EP04_CP1_02::0",
      "jp": "「おいでベラ 僕だよ？」",
      "zh": "「过来，贝拉，是我啊？」"
    },
    {
      "id": "ep04::EP04_CP1_03::0",
      "jp": "「いやっ！」",
      "zh": "「不要！」"
    },
    {
      "id": "ep04::EP04_CP1_04::0",
      "jp": "「また外国人か？」",
      "zh": "「又是外国人吗？」"
    },
    {
      "id": "ep04::EP04_CP1_05::0",
      "jp": "「うわっ！ 来るな！ この野郎！」",
      "zh": "「哇啊！别过来！你这混蛋！」"
    },
    {
      "id": "ep04::EP04_CP1_06::0",
      "jp": "「いつの間に紛れ込んだ？」",
      "zh": "「什么时候混进来的？」"
    },
    {
      "id": "ep04::EP04_CP3_01::0",
      "jp": "「お おい！」",
      "zh": "「喂、喂！」"
    },
    {
      "id": "ep04::EP04_CP3_02::0",
      "jp": "「念の為に確認しないとな」",
      "zh": "保险起见，得确认一下。"
    },
    {
      "id": "ep04::EP04_CP3_03::0",
      "jp": "「人間だと思って助けたら怪物だったなんて全く笑えん」",
      "zh": "要是救的其实是怪物，那可一点都笑不出来。"
    },
    {
      "id": "ep04::EP04_CP3_04::0",
      "jp": "「俺を怪物と疑ってるのか？このクレイジー野郎！」",
      "zh": "「你以为我是怪物吗？\n这疯家伙！」"
    },
    {
      "id": "ep04::EP04_CP3_05::0",
      "jp": "「申し訳ありまぜんミスター」",
      "zh": "「真是抱歉，先生。」"
    },
    {
      "id": "ep04::EP04_CP3_06::0",
      "jp": "「命に関わる問題なのでね」",
      "zh": "毕竟是性命攸关的问题。"
    },
    {
      "id": "ep04::EP04_CP3_07::0",
      "jp": "「クレイジーなりに命は惜しいんですよ」",
      "zh": "「就算是疯子，也是惜命的啊。」"
    },
    {
      "id": "ep04::EP04_CP3_08::0",
      "jp": "「クレイジーなりに命は惜しいんですよ」",
      "zh": "「就算是疯子，也是惜命的啊。」"
    },
    {
      "id": "ep04::EP04_CP3_09::0",
      "jp": "「やってられんな……」",
      "zh": "「真是干不下去了……」"
    },
    {
      "id": "ep04::EP04_CP3_10::0",
      "jp": "「……ごめんね」",
      "zh": "……对不起。"
    },
    {
      "id": "ep04::EP04_CP5_01::0",
      "jp": "「誰か！ 誰かいまぜんか？」",
      "zh": "「有人吗！有没有人在？」"
    },
    {
      "id": "ep05::EP05_CP1_01::0",
      "jp": "「念の為に確認しないとな」",
      "zh": "为保险起见，得确认一下。"
    },
    {
      "id": "ep05::EP05_CP1_02::0",
      "jp": "「人間だと思って助けたら怪物だったなんて全く笑えん」",
      "zh": "本以为是人就出手救了，结果竟是怪物，真是笑不出来。"
    },
    {
      "id": "ep05::EP05_CP1_03::0",
      "jp": "「俺を怪物と疑ってるのか？このクレイジー野郎！」",
      "zh": "你怀疑我是怪物吗？\n你这个疯子！"
    },
    {
      "id": "ep05::EP05_CP1_04::0",
      "jp": "「申し訳ありまぜんミスター」",
      "zh": "非常抱歉，先生。"
    },
    {
      "id": "ep05::EP05_CP1_05::0",
      "jp": "「命に関わる問題なのでね」",
      "zh": "因为这是性命攸关的事。"
    },
    {
      "id": "ep05::EP05_CP1_06::0",
      "jp": "「ベラ！」",
      "zh": "贝拉！"
    },
    {
      "id": "ep05::EP05_CP1_07::0",
      "jp": "「誰か！ 誰かいまぜんか？」",
      "zh": "来人啊！有人在吗？"
    },
    {
      "id": "ep05::EP05_CP1_08::0",
      "jp": "「……ごめんね」",
      "zh": "……对不起。"
    },
    {
      "id": "ep05::EP05_CP3_01::0",
      "jp": "「ところで何であんたはこの村に？」",
      "zh": "话说回来，你为什么来这个村子？"
    },
    {
      "id": "ep05::EP05_CP3_02::0",
      "jp": "「ん？ 聞かれてる意味が」",
      "zh": "嗯？你问这个是什么意思？"
    },
    {
      "id": "ep05::EP05_CP3_03::0",
      "jp": "「誰だ？」",
      "zh": "谁？"
    },
    {
      "id": "ep05::EP05_CP3_04::0",
      "jp": "「助けて！ サムは？ そこにいるんでしよう？」",
      "zh": "救命！山姆呢？他在那里吗？"
    },
    {
      "id": "ep05::EP05_CP3_05::0",
      "jp": "「メリッサ？ メリッサなのか？」",
      "zh": "梅丽莎？是梅丽莎吗？"
    },
    {
      "id": "ep05::EP05_CP3_06::0",
      "jp": "「あの子 今どこにいるの……？」",
      "zh": "那孩子现在在哪儿……？"
    },
    {
      "id": "ep05::EP05_CP3_07::0",
      "jp": " ",
      "zh": ""
    },
    {
      "id": "ep05::EP05_CP3_08::0",
      "jp": "「これはベラの！」",
      "zh": "这是贝拉的！"
    },
    {
      "id": "ep05::EP05_CP3_09::0",
      "jp": "「ベラはきっと無事だわ！」",
      "zh": "贝拉一定没事的！"
    },
    {
      "id": "ep05::EP05_CP3_10::0",
      "jp": "「不入谷聖堂か」「知ってるのか？」",
      "zh": "「不入谷圣堂」吗？\n「你知道？」"
    },
    {
      "id": "ep05::EP05_CP3_11::0",
      "jp": "「ああ 刈割にある聖堂によく似ている」",
      "zh": "啊，很像刈割的那座圣堂。"
    },
    {
      "id": "ep05::EP05_CP3_12::0",
      "jp": "「あそこを道なりに下っていった先だ」",
      "zh": "沿着那条路一直往下走，就在前面。"
    },
    {
      "id": "ep05::EP05_CP3_13::0",
      "jp": "「すまないが私はここに残る やるべき事があってね」",
      "zh": "抱歉，我要留在这里，我还有该做的事。"
    },
    {
      "id": "ep05::EP05_CP3_14::0",
      "jp": "「行こう！」「ええ」",
      "zh": "「走吧！」\n「嗯。」"
    },
    {
      "id": "ep05::EP05_CP3_15::0",
      "jp": "「ありがとう 世話になった」",
      "zh": "谢谢，承蒙你照顾了。"
    },
    {
      "id": "ep05::EP05_CP3_16::0",
      "jp": "「お互い無事に生き延びよう！ 希望を捨てては駄目だ！」",
      "zh": "我们都要平安地活下去！不能放弃希望！"
    },
    {
      "id": "ep05::EP05_CP3_17::0",
      "jp": "「希望か……」",
      "zh": "希望吗……"
    },
    {
      "id": "ep05::EP05_CP3_18::0",
      "jp": "「先生……」",
      "zh": "老师……"
    },
    {
      "id": "ep05::EP05_CP3_19::0",
      "jp": "「流石に飽きた」",
      "zh": "果然还是腻了……"
    },
    {
      "id": "ep05::EP05_CP3_20::0",
      "jp": "「あれは……」",
      "zh": "那是……"
    },
    {
      "id": "ep05::EP05_CP5_01::0",
      "jp": "「ああ神よ 主は何をお望みなのですか……」",
      "zh": "啊，神啊，主究竟期望什么呢……"
    },
    {
      "id": "ep05::EP05_CP5_02::0",
      "jp": "「来る……」",
      "zh": "来了……"
    },
    {
      "id": "ep05::EP05_CP5_03::0",
      "jp": "「あー ぼくは ハワード・ライトです ＯK？」",
      "zh": "啊——我叫霍华德·莱特，OK？"
    },
    {
      "id": "ep05::EP05_CP5_04::0",
      "jp": "「ふたり いっしよ 逃げる！ 頑張る！」",
      "zh": "两个人，一起逃！加油！"
    },
    {
      "id": "ep05::EP05_CP5_05::0",
      "jp": "「ぼくはハワード きみは？」",
      "zh": "我是霍华德，你呢？"
    },
    {
      "id": "ep05::EP05_CP5_06::0",
      "jp": "「……美耶古」",
      "zh": "……美耶古"
    },
    {
      "id": "ep05::EP05_CP5_07::0",
      "jp": "「ＯK！ ミヤコ いっしよ 頑張る！」",
      "zh": "OK！美耶古，一起逃！加油！"
    },
    {
      "id": "ep05::EP05_CP5_08::0",
      "jp": "「ミヤコ！」",
      "zh": "美耶古！"
    },
    {
      "id": "ep06::EP06_CP1_01::0",
      "jp": "「ああ神よ 主は何をお望みなのですか……」",
      "zh": "啊，神啊，主究竟期望什么呢……"
    },
    {
      "id": "ep06::EP06_CP1_02::0",
      "jp": "「来る……」",
      "zh": "来了……"
    },
    {
      "id": "ep06::EP06_CP1_03::0",
      "jp": "「永劫に回り続ける閉ざされし運命の輪……」",
      "zh": "永远旋转、闭锁的命运之轮……"
    },
    {
      "id": "ep06::EP06_CP1_04::0",
      "jp": "「回る 回る 回る……」",
      "zh": "转啊，转啊，转啊……"
    },
    {
      "id": "ep06::EP06_CP1_05::0",
      "jp": "「全ての始まりと総わりを司るウロボロスの輪……」",
      "zh": "环绕万物起始与终结的乌洛波洛斯之轮……"
    },
    {
      "id": "ep06::EP06_CP1_06::0",
      "jp": "「ＯK！ ミヤコ いっしよ 頑張る！」",
      "zh": "OK！美耶古，一起逃！加油！"
    },
    {
      "id": "ep06::EP06_CP1_07::0",
      "jp": "「ミヤコ！」",
      "zh": "美耶古！"
    },
    {
      "id": "ep06::EP06_CP1_08::0",
      "jp": "「ここでまつ？ もどってくる まつ ＯK？」",
      "zh": "在这里等？我会回来，等着，OK？"
    },
    {
      "id": "ep06::EP06_CP1_09::0",
      "jp": "「私 死にたくない 一緒に逃げたい」",
      "zh": "我不想死，想和你一起逃。"
    },
    {
      "id": "ep06::EP06_CP1_10::0",
      "jp": "「村の外を見てみたい……」",
      "zh": "想去看看村子外面……"
    },
    {
      "id": "ep06::EP06_CP1_11::0",
      "jp": "「こんな村 大嫌い」",
      "zh": "最讨厌这种村子了。"
    },
    {
      "id": "ep06::EP06_CP1_12::0",
      "jp": "「やくそくする ミヤコをたすける」",
      "zh": "我保证，会救美耶古的。"
    },
    {
      "id": "ep06::EP06_CP1_13::0",
      "jp": "「ミヤコ 約束する！」",
      "zh": "美耶古，我保证！"
    },
    {
      "id": "ep06::EP06_CP1_14::0",
      "jp": "「くそっ どこから撃って来てるんだ」",
      "zh": "可恶，这些东西到底从哪儿冒出来的！"
    },
    {
      "id": "ep06::EP06_CP3_01::0",
      "jp": "「こんな形のシンクレティズムが定着してるとはな」",
      "zh": "没想到这种形态的宗教融合竟然在此扎根。"
    },
    {
      "id": "ep06::EP06_CP3_02::0",
      "jp": "「もはやカルトだ」",
      "zh": "已经是邪教了。"
    },
    {
      "id": "ep06::EP06_CP3_03::0",
      "jp": "「ベラ……あの子はどこ？」",
      "zh": "贝拉……那孩子在哪儿？"
    },
    {
      "id": "ep06::EP06_CP3_04::0",
      "jp": "「メリッサ……ベラはきっと大丈夫！」",
      "zh": "梅丽莎……贝拉一定没事！"
    },
    {
      "id": "ep06::EP06_CP3_05::0",
      "jp": "「あの子は素早しっこいし隠れるのも上手だ！」",
      "zh": "那孩子身手敏捷，还很会躲！"
    },
    {
      "id": "ep06::EP06_CP3_06::0",
      "jp": "「ほら あれあれ 乾燥機の中にいた時は一」",
      "zh": "你看，那个那个，之前在干燥机里的时候——"
    },
    {
      "id": "ep06::EP06_CP3_07::0",
      "jp": "「誘拐でもされたと思って慌てたよなあ？」",
      "zh": "我们还以为她被绑架了，慌得不行呢？"
    },
    {
      "id": "ep06::EP06_CP3_08::0",
      "jp": "「あなたのそういうとこ 嫌いじやなかった」",
      "zh": "你那种地方，我并不讨厌。"
    },
    {
      "id": "ep06::EP06_CP3_09::0",
      "jp": "「ミヤコ いっしよにげよう？」",
      "zh": "美耶古，一起逃吧？"
    },
    {
      "id": "ep06::EP06_CP3_10::0",
      "jp": "「あんた 無事だったのか？」",
      "zh": "你没事吗？"
    },
    {
      "id": "ep06::EP06_CP3_11::0",
      "jp": "「あれは私が間違っていました」",
      "zh": "那是我不对。"
    },
    {
      "id": "ep06::EP06_CP3_12::0",
      "jp": "「もう一度 儀式をやり直します」",
      "zh": "我会重新做一次仪式。"
    },
    {
      "id": "ep06::EP06_CP3_13::0",
      "jp": "「おい 何言ってるんだよ？」",
      "zh": "喂，你在说什么啊？"
    },
    {
      "id": "ep06::EP06_CP3_14::0",
      "jp": "「いやあ一！」",
      "zh": "不要啊——！"
    },
    {
      "id": "ep06::EP06_CP3_15::0",
      "jp": "「きれい」",
      "zh": "好美。"
    },
    {
      "id": "ep06::EP06_CP3_16::0",
      "jp": "「バラの花輪を作ろうよポケットに花束いっぱい一一」",
      "zh": "我们做玫瑰花环吧，\n口袋里装满花束——"
    },
    {
      "id": "ep06::EP06_CP5_01::0",
      "jp": "「ダディ！ マミィ！」",
      "zh": "爸爸！妈妈！"
    },
    {
      "id": "ep06::EP06_CP5_02::0",
      "jp": "「私よ ベラよ！ 私よ！」",
      "zh": "是我，是贝拉！是我！"
    },
    {
      "id": "ep06::EP06_CP5_03::0",
      "jp": "「ベラ！」",
      "zh": "贝拉！"
    },
    {
      "id": "ep06::EP06_CP5_04::0",
      "jp": "「ダディ！ マミィ！ 私よ！ダディ！ マミィ！ お願いここを開けて！」",
      "zh": "爸爸！妈妈！是我！\n爸爸！妈妈！求你们把门打开！"
    },
    {
      "id": "ep06::EP06_CP5_05::0",
      "jp": "「メリッサ！ 駄目だ！」",
      "zh": "梅丽莎！不行！"
    },
    {
      "id": "ep06::EP06_CP5_06::0",
      "jp": "「開けてえ……」",
      "zh": "开门啊……"
    },
    {
      "id": "ep06::EP06_CP5_07::0",
      "jp": "「いやあ一一！」",
      "zh": "不要啊——！"
    },
    {
      "id": "ep06::EP06_CP5_08::0",
      "jp": "「ダディィィマミィィィ」",
      "zh": "爸爸——妈妈——"
    },
    {
      "id": "ep06::EP06_CP5_09::0",
      "jp": "「起きて！」",
      "zh": "醒醒！"
    },
    {
      "id": "ep06::EP06_CP5_10::0",
      "jp": "「もう大丈夫！ 全部総わったの！駄私達は助かったの！」",
      "zh": "没事了！一切都结束了！\n我们得救了！"
    },
    {
      "id": "ep06::EP06_CP5_11::0",
      "jp": "「だいじようぶ？ おわった？」",
      "zh": "没事吧？结束了吗？"
    },
    {
      "id": "ep06::EP06_CP5_12::0",
      "jp": "「良かった ミヤコ……一緒に」",
      "zh": "太好了，美耶古……一起……"
    },
    {
      "id": "ep06::EP06_CP5_13::0",
      "jp": "「ミヤコ？」",
      "zh": "美耶古？"
    },
    {
      "id": "ep07::EP07_CP1_01::0",
      "jp": "「私よ ベラよ！ 私よ！」",
      "zh": "是我，是贝拉！是我！"
    },
    {
      "id": "ep07::EP07_CP1_02::0",
      "jp": "「ベラ！」",
      "zh": "贝拉！"
    },
    {
      "id": "ep07::EP07_CP1_03::0",
      "jp": "「ダディ！ マミィ！ 私よ！ダディ！ マミィ！ お願いここを開けて！」",
      "zh": "爸爸！妈妈！是我！\n爸爸！妈妈！求你们把门打开！"
    },
    {
      "id": "ep07::EP07_CP1_04::0",
      "jp": "「メリッサ！ 駄目だ！」",
      "zh": "梅丽莎！不行！"
    },
    {
      "id": "ep07::EP07_CP1_05::0",
      "jp": "「ダディィィマミィィィ」",
      "zh": "爸爸——妈妈——"
    },
    {
      "id": "ep07::EP07_CP1_06::0",
      "jp": "「嫌……私 死にたくない」",
      "zh": "不要……我不想死。"
    },
    {
      "id": "ep07::EP07_CP1_07::0",
      "jp": "「あれは？」",
      "zh": "那是？"
    },
    {
      "id": "ep07::EP07_CP1_08::0",
      "jp": "「近くにいるの？ お願い……早く！」",
      "zh": "你在附近吗？求你了……快点！"
    },
    {
      "id": "ep07::EP07_CP1_09::0",
      "jp": "「ミヤコ ここにいるのか？」",
      "zh": "美耶古，你在这里吗？"
    },
    {
      "id": "ep07::EP07_CP3_01::0",
      "jp": "「ベラ……メリッサ……」",
      "zh": "贝拉……梅丽莎……"
    },
    {
      "id": "ep07::EP07_CP3_02::0",
      "jp": "「どうして？ 実を捧げたのに」",
      "zh": "「为什么？明明献上果实了……」"
    },
    {
      "id": "ep07::EP07_CP3_03::0",
      "jp": "「ここは？」",
      "zh": "这里是？"
    },
    {
      "id": "ep07::EP07_CP3_04::0",
      "jp": "「ミヤコ？」",
      "zh": "美耶古？"
    },
    {
      "id": "ep07::EP07_CP5_01::0",
      "jp": "「こども？ 酷すきる……」",
      "zh": "孩子？太过分了……"
    },
    {
      "id": "ep07::EP07_CP5_02::0",
      "jp": "「ベラから離れて」",
      "zh": "离贝拉远点。"
    },
    {
      "id": "ep07::EP07_CP5_03::0",
      "jp": "「もう大丈夫 マミィはどこにも行かない」",
      "zh": "没事了，妈妈哪儿也不去。"
    },
    {
      "id": "ep07::EP07_CP5_04::0",
      "jp": "「これでは違う」",
      "zh": "这样不对。"
    },
    {
      "id": "ep07::EP07_CP5_05::0",
      "jp": "「ウロボロスの輪は義がらない……」",
      "zh": "乌洛波洛斯之轮不会终结……"
    },
    {
      "id": "ep07::EP07_CP5_06::0",
      "jp": "「何だよこの感じ 気持ち悪りい……くそっ！」",
      "zh": "这什么感觉，好恶心……混蛋！"
    },
    {
      "id": "ep07::EP07_CP5_07::0",
      "jp": "「くそっ！ なんだ今の？」",
      "zh": "混蛋！刚才那是什么？"
    },
    {
      "id": "ep07::EP07_CP5_08::0",
      "jp": "「あなた大丈夫？」",
      "zh": "你没事吧？"
    },
    {
      "id": "ep08::EP08_CP1_01::0",
      "jp": "「ベラから離れて」",
      "zh": "「离贝拉远点。」"
    },
    {
      "id": "ep08::EP08_CP1_02::0",
      "jp": "「これでは違う」",
      "zh": "「这样可不行。」"
    },
    {
      "id": "ep08::EP08_CP1_03::0",
      "jp": "「ウロボロスの輪は義がらない……」",
      "zh": "「这轮回之轮无法转动……」"
    },
    {
      "id": "ep08::EP08_CP1_04::0",
      "jp": "「何だよこの感じ 気持ち悪りい……くそっ！」",
      "zh": "「这感觉是怎么回事，好恶心……混蛋！」"
    },
    {
      "id": "ep08::EP08_CP1_05::0",
      "jp": "「あなた大丈夫？」",
      "zh": "「你没事吧？」"
    },
    {
      "id": "ep08::EP08_CP1_06::0",
      "jp": "「待って！」",
      "zh": "「等等！」"
    },
    {
      "id": "ep08::EP08_CP1_07::0",
      "jp": "「メリッサ！ サム！ ベラ！」",
      "zh": "「梅丽莎！山姆！贝拉！」"
    },
    {
      "id": "ep08::EP08_CP1_08::0",
      "jp": "「どうなってんだよ？」",
      "zh": "「到底是怎么回事啊？」"
    },
    {
      "id": "ep08::EP08_CP1_09::0",
      "jp": "「まるでジンビになっちまった気分だせ」",
      "zh": "「感觉简直就像变成了僵尸一样。」"
    },
    {
      "id": "ep08::EP08_CP1_10::0",
      "jp": "「くそっ！ あの気色悪い和食で頭までやられたか？」",
      "zh": "「混蛋！是被那恶心的和食弄得连脑子都坏了吗？」"
    },
    {
      "id": "ep08::EP08_CP3_01::0",
      "jp": "「僕だってこんな狂った村だなんて知らなかったんだよ！」",
      "zh": "「我也不知道这会是这样一个疯掉的村子！」"
    },
    {
      "id": "ep08::EP08_CP3_02::0",
      "jp": "「ふざけるなよ！」",
      "zh": "「别开玩笑了！」"
    },
    {
      "id": "ep08::EP08_CP3_03::0",
      "jp": "「ベラに何かあったら訴えてやるからな！」",
      "zh": "「要是贝拉有个三长两短，我饶不了你！」"
    },
    {
      "id": "ep08::EP08_CP3_04::0",
      "jp": "「へイ！ 落ち着いてくれよ！ な？って言うか何で俺のぜいなんだよ！」",
      "zh": "「喂！冷静一下！好吗？\n话说怎么成了我的错啊！」"
    },
    {
      "id": "ep08::EP08_CP3_05::0",
      "jp": "「ベラを連れて来たのはそっちの勝手だろ？」",
      "zh": "「把贝拉带来，可是你自己的主意吧？」"
    },
    {
      "id": "ep08::EP08_CP3_06::0",
      "jp": "「しっ！ マミィよ」",
      "zh": "「嘘！是妈咪呀。」"
    },
    {
      "id": "ep08::EP08_CP3_07::0",
      "jp": "「マミィ！」",
      "zh": "「妈咪！」"
    },
    {
      "id": "ep08::EP08_CP3_08::0",
      "jp": "「ベラ！ 良かった……議く探したのよ」",
      "zh": "「贝拉！太好了……找了你半天啊。」"
    },
    {
      "id": "ep08::EP08_CP3_09::0",
      "jp": "「もう絶対に目を離したりしないからね」",
      "zh": "「我再也不会让你离开我的视线了。」"
    },
    {
      "id": "ep08::EP08_CP5_01::0",
      "jp": "「やだよお……どこ行くの？ お家に帰りたいよお」",
      "zh": "「不要啦……要去哪里？我想回家啦。」"
    },
    {
      "id": "ep08::EP08_CP5_02::0",
      "jp": "「犀賀家に買われるといってもねえ」",
      "zh": "「就算说要被犀贺家收留，也……」"
    },
    {
      "id": "ep08::EP08_CP5_03::0",
      "jp": "「犀賀家の話は御法度だよ くわばらくわばら」",
      "zh": "「犀贺家的事可是禁忌，避邪避邪。」"
    },
    {
      "id": "ep08::EP08_CP5_04::0",
      "jp": "「おとうさん……おかあさん……」",
      "zh": "「爸爸……妈妈……」"
    },
    {
      "id": "ep08::EP08_CP5_05::0",
      "jp": "「先に行っててくれ 幸江」",
      "zh": "「你先走吧，幸江。」"
    },
    {
      "id": "ep08::EP08_CP5_06::0",
      "jp": "「先生？」",
      "zh": "「老师？」"
    },
    {
      "id": "ep08::EP08_CP5_07::0",
      "jp": "「流石に飽きた」",
      "zh": "果然还是来了"
    },
    {
      "id": "ep08::EP08_CP5_08::0",
      "jp": "「今のは？」",
      "zh": "那是什么"
    },
    {
      "id": "ep08::EP08_CP5_09::0",
      "jp": "「ベラ！ 早く乗って！」",
      "zh": "「贝拉！快上车！」"
    },
    {
      "id": "ep08::EP08_CP5_10::0",
      "jp": "「いやあ！ マミィ！」",
      "zh": "「不要！妈咪！」"
    },
    {
      "id": "ep08::EP08_CP5_11::0",
      "jp": "「来るな！」",
      "zh": "「别过来！」"
    },
    {
      "id": "ep08::EP08_CP5_12::0",
      "jp": "「ベラに触らないで！」",
      "zh": "「别碰贝拉！」"
    },
    {
      "id": "ep08::EP08_CP5_13::0",
      "jp": "「このクソ野郎！」",
      "zh": "「你这混蛋！」"
    },
    {
      "id": "ep08::EP08_CP5_14::0",
      "jp": "「お願い動いて！」",
      "zh": "拜托，快动啊！"
    },
    {
      "id": "ep08::EP08_CP5_15::0",
      "jp": "「ほら 動け！ 動けってば！」",
      "zh": "「喂，快动！叫你快动啊！」"
    },
    {
      "id": "ep08::EP08_CP5_16::0",
      "jp": "「いやあっ！」",
      "zh": "「不要啊！」"
    },
    {
      "id": "ep08::EP08_CP5_17::0",
      "jp": "「どうなってんだよこの村」",
      "zh": "这村子到底怎么回事。"
    },
    {
      "id": "ep08::EP08_CP5_18::0",
      "jp": "「全部おかしいよ」",
      "zh": "「一切都不对劲。」"
    },
    {
      "id": "ep08::EP08_CP5_19::0",
      "jp": "「くそっ！ 何だよ今の どうなってんだよ俺の頭も！」",
      "zh": "「混蛋！刚才那是什么，我的脑子也到底怎么回事！」"
    },
    {
      "id": "ep08::EP08_CP5_20::0",
      "jp": "「あの子……」",
      "zh": "那孩子……"
    },
    {
      "id": "ep08::EP08_CP5_21::0",
      "jp": "「ベラ！ 捕まって！」",
      "zh": "「贝拉！抓住！」"
    },
    {
      "id": "ep08::EP08_CP5_22::0",
      "jp": "「これで保険料が高くなるわ」",
      "zh": "「这下保险费又要涨了。」"
    },
    {
      "id": "ep09::EP09_CP1_01::0",
      "jp": "「ベラ！ 早く乗って！」",
      "zh": "「贝拉！快上车！」"
    },
    {
      "id": "ep09::EP09_CP1_02::0",
      "jp": "「いやあ！ マミィ！」",
      "zh": "「不要！妈咪！」"
    },
    {
      "id": "ep09::EP09_CP1_03::0",
      "jp": "「来るな！」",
      "zh": "「别过来！」"
    },
    {
      "id": "ep09::EP09_CP1_04::0",
      "jp": "「このクソ野郎！」",
      "zh": "「你这混蛋！」"
    },
    {
      "id": "ep09::EP09_CP1_05::0",
      "jp": "「ベラに何かあったら訴えてやるからな！」",
      "zh": "「要是贝拉有个三长两短，我饶不了你！」"
    },
    {
      "id": "ep09::EP09_CP1_06::0",
      "jp": "「へイ！ 落ち着いてくれよ！ な？って言うか何で俺のぜいなんだよ！」",
      "zh": "「喂！冷静一下！好吗？\n话说怎么成了我的错啊！」"
    },
    {
      "id": "ep09::EP09_CP1_07::0",
      "jp": "「ベラ！ 捕まって！」",
      "zh": "「贝拉！抓住！」"
    },
    {
      "id": "ep09::EP09_CP1_08::0",
      "jp": "「ほら 動け！ 動けってば！」",
      "zh": "「喂，快动！叫你快动啊！」"
    },
    {
      "id": "ep09::EP09_CP1_09::0",
      "jp": "「ベラを連れて来たのはそっちの勝手だろ？」",
      "zh": "「把贝拉带来，可是你自己的主意吧？」"
    },
    {
      "id": "ep09::EP09_CP1_10::0",
      "jp": "「ああっ もうっ！」",
      "zh": "「啊——真是的！」"
    },
    {
      "id": "ep09::EP09_CP1_11::0",
      "jp": "「ベラ！ 来なさい！」",
      "zh": "「贝拉！过来！」"
    },
    {
      "id": "ep09::EP09_CP1_12::0",
      "jp": "「ベラ！ 何してるの早く！」",
      "zh": "「贝拉！你在干什么，快点！」"
    },
    {
      "id": "ep09::EP09_CP1_13::0",
      "jp": "「うん」",
      "zh": "「嗯。」"
    },
    {
      "id": "ep09::EP09_CP3_01::0",
      "jp": "「くそっ！ ベラ メリッサ頼む 無事でいてくれ一一」",
      "zh": "「混蛋！贝拉、梅丽莎，\n大家都要平安无事——」"
    },
    {
      "id": "ep09::EP09_CP3_02::0",
      "jp": "「ああっ！」",
      "zh": "「啊啊！」"
    },
    {
      "id": "ep09::EP09_CP3_03::0",
      "jp": "「とうとう買い換え時か」",
      "zh": "「终于该换新了吗？」"
    },
    {
      "id": "ep09::EP09_CP3_04::0",
      "jp": "「これで八つ当たりされる理由が一つ減ったな」",
      "zh": "「这样一来，被迁怒的理由就少了一个。」"
    },
    {
      "id": "ep09::EP09_CP3_05::0",
      "jp": "「これは？」",
      "zh": "「这是？」"
    },
    {
      "id": "ep09::EP09_CP3_06::0",
      "jp": "「なせだ？ 前にもここで……？」",
      "zh": "「为什么？之前也在这里……？」"
    },
    {
      "id": "ep09::EP09_CP3_07::0",
      "jp": "「いやあっ！ いやあっ！ いやあっ！」",
      "zh": "「不要！不要！不要！」"
    },
    {
      "id": "ep09::EP09_CP3_08::0",
      "jp": "「妙な気分だな」",
      "zh": "感觉真怪啊。"
    },
    {
      "id": "ep09::EP09_CP5_01::0",
      "jp": "「これは私の血の杯 罪の許しとなる永遠の契約の血」",
      "zh": "「这是我的血杯，成为罪之宽恕的永恒契约之血。」"
    },
    {
      "id": "ep09::EP09_CP5_02::0",
      "jp": "「こうするしかできない……」",
      "zh": "「只能这么做了……」"
    },
    {
      "id": "ep09::EP09_CP5_03::0",
      "jp": "「ぜっかくきれいだったのに」",
      "zh": "「好不容易才变得漂亮的呢。」"
    },
    {
      "id": "ep09::EP09_CP5_04::0",
      "jp": "「ミヤコ！」",
      "zh": "「美耶古！」"
    },
    {
      "id": "ep09::EP09_CP5_05::0",
      "jp": "「どういうことだ？」",
      "zh": "「怎么回事？」"
    },
    {
      "id": "ep09::EP09_CP5_06::0",
      "jp": "「すべて予言されていた？」",
      "zh": "「一切都是被预言过的？」"
    },
    {
      "id": "ep09::EP09_CP5_07::0",
      "jp": "「私達の存在までが……そんな馬鹿な」",
      "zh": "「连我们的存在也是……怎么可能。」"
    },
    {
      "id": "ep09::EP09_CP5_08::0",
      "jp": "「くそっ！」",
      "zh": "「混蛋！」"
    },
    {
      "id": "ep10::EP10_CP1_01::0",
      "jp": "「やった！ マミィ一一」",
      "zh": "「太好了！妈咪——」"
    },
    {
      "id": "ep10::EP10_CP1_02::0",
      "jp": "「愛してるわベラ…… 逃げるの！ 早く！」",
      "zh": "「我爱你，贝拉……快逃！快！」"
    },
    {
      "id": "ep10::EP10_CP1_03::0",
      "jp": "「どういうことだ？」",
      "zh": "「怎么回事？」"
    },
    {
      "id": "ep10::EP10_CP1_04::0",
      "jp": "「すべて予言されていた？」",
      "zh": "「一切都是被预言过的？」"
    },
    {
      "id": "ep10::EP10_CP1_05::0",
      "jp": "「私達の存在までが……そんな馬鹿な」",
      "zh": "「连我们的存在也是……怎么可能。」"
    },
    {
      "id": "ep10::EP10_CP1_06::0",
      "jp": "「くそっ！」",
      "zh": "「混蛋！」"
    },
    {
      "id": "ep10::EP10_CP3_01::0",
      "jp": "「思い出した」",
      "zh": "想起来了。"
    },
    {
      "id": "ep10::EP10_CP3_02::0",
      "jp": "「ずっと繰り返している」",
      "zh": "「一直在不断地重复着。」"
    },
    {
      "id": "ep10::EP10_CP3_03::0",
      "jp": "「閉ざされた輪に閉じこめられて」",
      "zh": "「被困在封闭的轮回之中。」"
    },
    {
      "id": "ep10::EP10_CP3_04::0",
      "jp": "「眠っているもう一つの力を解き放つの」",
      "zh": "「解放那沉睡着的另一股力量。」"
    },
    {
      "id": "ep10::EP10_CP3_05::0",
      "jp": "「今度こそ真の儀式を」",
      "zh": "举行真正的仪式。"
    },
    {
      "id": "ep10::EP10_CP5_01::0",
      "jp": "「あれは……」",
      "zh": "「那是……」"
    },
    {
      "id": "ep10::EP10_CP5_02::0",
      "jp": "「決して逃れられない どこへ行こうと」",
      "zh": "「无论如何都逃不掉，不管去哪里。」"
    },
    {
      "id": "ep10::EP10_CP5_03::0",
      "jp": "「この出会い 偶然では無さそうだな」",
      "zh": "「这次相遇，看来并非偶然啊。」"
    },
    {
      "id": "ep11::EP11_CP1_01::0",
      "jp": "「この出会い 偶然では無さそうだな」",
      "zh": "「这次相遇，看来并非偶然啊。」"
    },
    {
      "id": "ep11::EP11_CP1_02::0",
      "jp": "「君……誰？ ここに一人？」",
      "zh": "你……是谁？在这里？"
    },
    {
      "id": "ep11::EP11_CP1_03::0",
      "jp": "「見るな！」",
      "zh": "「别看！」"
    },
    {
      "id": "ep11::EP11_CP1_04::0",
      "jp": "「やあ救世主」",
      "zh": "嗨，救世主"
    },
    {
      "id": "ep11::EP11_CP1_05::0",
      "jp": "「新しい目覚めはどんな感じだ？」",
      "zh": "「新的觉醒，感觉怎么样？」"
    },
    {
      "id": "ep11::EP11_CP1_06::0",
      "jp": "「君が目覚めるまでちよっとした実験をやってたとこだよ」",
      "zh": "「在你醒来之前，我正好在做点小实验呢。」"
    },
    {
      "id": "ep11::EP11_CP1_07::0",
      "jp": "「君が目覚めるまでちよっとした実験をやってたとこだよ」",
      "zh": "「在你醒来之前，我正好在做点小实验呢。」"
    },
    {
      "id": "ep11::EP11_CP1_08::0",
      "jp": "「あんた狂ってるよ！」",
      "zh": "「你疯了吧！」"
    },
    {
      "id": "ep11::EP11_CP1_09::0",
      "jp": "「まあゆっくりしていってくれ」",
      "zh": "「好了，你慢慢待着吧。」"
    },
    {
      "id": "ep11::EP11_CP1_10::0",
      "jp": "「俺にはまだやる事がある」",
      "zh": "「我还有些事要做。」"
    },
    {
      "id": "ep11::EP11_CP3_01::0",
      "jp": "「ここでも無いのか？ 復活の儀式の場はどこなんだ！」",
      "zh": "「也不是这里吗？复活的仪式场到底在哪！」"
    },
    {
      "id": "ep11::EP11_CP3_02::0",
      "jp": "「無駄足踏んでる時間は……くそっ！」",
      "zh": "「可没时间白跑冤枉路……可恶！」"
    },
    {
      "id": "ep11::EP11_CP3_03::0",
      "jp": "「おめでとうございます」",
      "zh": "「恭喜。」"
    },
    {
      "id": "ep11::EP11_CP3_04::0",
      "jp": "「恵みに充ちた方よ すべての祝福は御身のもの」",
      "zh": "「满含恩惠之人啊，一切祝福皆归于您。」"
    },
    {
      "id": "ep11::EP11_CP3_05::0",
      "jp": "「前は一人だった 今度は君が一緒だ」",
      "zh": "「上次只有我一人，这次有你同行。」"
    },
    {
      "id": "ep11::EP11_CP5_01::0",
      "jp": "「さあ 楽園の門が開かれる」",
      "zh": "「来吧，乐园之门即将开启。」"
    },
    {
      "id": "ep11::EP11_CP5_02::0",
      "jp": "「ミヤコ？ ミヤコ一一！」",
      "zh": "「美耶古？美耶古——！」"
    },
    {
      "id": "ep11::EP11_CP5_03::0",
      "jp": "「ダディ！」",
      "zh": "「爸爸！」"
    },
    {
      "id": "ep11::EP11_CP5_04::0",
      "jp": "「くそっ！ 退かったか！ これも予言通りか」",
      "zh": "「可恶！迟了一步吗！这也如预言所说吗。」"
    },
    {
      "id": "ep11::EP11_CP5_05::0",
      "jp": "「ダディ！」",
      "zh": "「爸爸！」"
    },
    {
      "id": "ep11::EP11_CP5_06::0",
      "jp": "「駄目だ！ ベラ！ 来ちや駄目だ！ 危ない！」",
      "zh": "「不行！贝拉！别过来！危险！」"
    },
    {
      "id": "ep11::EP11_CP5_07::0",
      "jp": "「ダディ一一！」",
      "zh": "「爸爸——！」"
    },
    {
      "id": "ep11::EP11_CP5_08::0",
      "jp": "「待って！」",
      "zh": "「等等！」"
    },
    {
      "id": "ep11::EP11_CP5_09::0",
      "jp": "「ベラ一一！」",
      "zh": "「贝拉——！」"
    },
    {
      "id": "ep11::EP11_CP5_10::0",
      "jp": "「逃げるんだ！」",
      "zh": "「快逃！」"
    },
    {
      "id": "ep11::EP11_CP5_11::0",
      "jp": "「来るなあ一！」",
      "zh": "别过来——！"
    },
    {
      "id": "ep11::EP11_CP5_12::0",
      "jp": "「違う これでは違う……」",
      "zh": "「不对，这样不对……」"
    },
    {
      "id": "ep12::EP12_CP1_01::0",
      "jp": "「流れに逆らってみるのも悪く無い」",
      "zh": "「逆流而上试试，倒也不坏。」"
    },
    {
      "id": "ep12::EP12_CP1_02::0",
      "jp": "「消えなさい」",
      "zh": "「消失吧。」"
    },
    {
      "id": "ep12::EP12_CP1_03::0",
      "jp": "「生憎 そんなヤワじやないんだ」",
      "zh": "「可惜，并不像你想的那样。」"
    },
    {
      "id": "ep12::EP12_CP1_04::0",
      "jp": "「あなただったのね？ 実を盗んだのは！」",
      "zh": "「偷走果实的，是你吧？」"
    },
    {
      "id": "ep12::EP12_CP1_05::0",
      "jp": "「ほんの一切れさ」",
      "zh": "只拿了一小片。"
    },
    {
      "id": "ep12::EP12_CP1_06::0",
      "jp": "「やめて一一！」",
      "zh": "「住手——！」"
    },
    {
      "id": "ep12::EP12_CP1_07::0",
      "jp": "「おい！ 起きろ！ ベラはどこだ？ おい！」",
      "zh": "「喂！醒醒！贝拉在哪？喂！」"
    },
    {
      "id": "ep12::EP12_CP1_08::0",
      "jp": "「くそっ！」",
      "zh": "「可恶！」"
    },
    {
      "id": "ep12::EP12_CP1_09::0",
      "jp": "「おい お前名前は？」",
      "zh": "「喂，你叫什么名字？」"
    },
    {
      "id": "ep12::EP12_CP1_10::0",
      "jp": "「ハワード・ライト」",
      "zh": "「霍华德·莱特」"
    },
    {
      "id": "ep12::EP12_CP1_11::0",
      "jp": "「私の名前はサム・モンローだ」",
      "zh": "「我叫山姆·门罗。」"
    },
    {
      "id": "ep12::EP12_CP1_12::0",
      "jp": "「もし また君がベラを見つけた時は頼む」",
      "zh": "「要是你再见到贝拉，也告诉我一声。」"
    },
    {
      "id": "ep12::EP12_CP1_13::0",
      "jp": "「あんたがサム・モンロー？」",
      "zh": "「你就是山姆·门罗？」"
    },
    {
      "id": "ep12::EP12_CP1_14::0",
      "jp": "「あんたがメッセージをくれた？」",
      "zh": "「是你给我留言的？」"
    },
    {
      "id": "ep12::EP12_CP1_15::0",
      "jp": "「何の話だ？」",
      "zh": "说什么？"
    },
    {
      "id": "ep12::EP12_CP1_16::0",
      "jp": "「ベラ！ ベラ！」",
      "zh": "「贝拉！贝拉！」"
    },
    {
      "id": "ep12::EP12_CP3_01::0",
      "jp": "「ベラ！」",
      "zh": "「贝拉！」"
    },
    {
      "id": "ep12::EP12_CP3_02::0",
      "jp": "「メリッサ……」",
      "zh": "「梅丽莎……」"
    },
    {
      "id": "ep12::EP12_CP3_03::0",
      "jp": "「マミィ？」",
      "zh": "「妈妈？」"
    },
    {
      "id": "ep12::EP12_CP3_04::0",
      "jp": "「ベラ一一！」",
      "zh": "「贝拉——！」"
    },
    {
      "id": "ep12::EP12_CP3_05::0",
      "jp": "「ミヤコ！ ここにいたんだ？」",
      "zh": "「美耶古！你在这儿啊？」"
    },
    {
      "id": "ep12::EP12_CP3_06::0",
      "jp": "「私はずっと傍にいるよ」",
      "zh": "我会一直陪着你。"
    },
    {
      "id": "ep12::EP12_CP3_07::0",
      "jp": "「約束したよね？ 一緒に逃げようって！」",
      "zh": "「我们说好了吧？要一起逃走的！」"
    },
    {
      "id": "ep12::EP12_CP3_08::0",
      "jp": "「お願い 全部……全部消して」",
      "zh": "求你了，把一切全抹掉。"
    },
    {
      "id": "ep12::EP12_CP3_09::0",
      "jp": "「この村もあいつらも全部」",
      "zh": "村子，还有那些人……"
    },
    {
      "id": "ep12::EP12_CP3_10::0",
      "jp": "「ミヤコ？ ミヤコ一一！」",
      "zh": "「美耶古？美耶古——！」"
    },
    {
      "id": "ep12::EP12_CP5_01::0",
      "jp": "「そんな！ そんなまさか！ 何て残酷な！」",
      "zh": "「怎么会！难道说！太残酷了！」"
    },
    {
      "id": "ep12::EP12_CP5_02::0",
      "jp": "「全ての始まりが生まれる」",
      "zh": "「一切的开端将会诞生。」"
    },
    {
      "id": "ep12::EP12_CP5_03::0",
      "jp": "「閉ざされた輪 ウロボロスの贄」",
      "zh": "「闭合之环，乌洛波罗斯的祭品。」"
    },
    {
      "id": "ep12::EP12_CP5_04::0",
      "jp": "「繰り返さねば」",
      "zh": "要反复重演。"
    },
    {
      "id": "ep12::EP12_CP5_05::0",
      "jp": "「あの子を永遠の存在にする為に」",
      "zh": "「为了让那孩子成为永恒的存在。」"
    },
    {
      "id": "ep12::EP12_CP5_06::0",
      "jp": "「ハワード そう言ったな」",
      "zh": "霍华德，你说过吧。"
    },
    {
      "id": "ep12::EP12_CP5_07::0",
      "jp": "「ミヤコとの約束だ」",
      "zh": "与美耶古的约定。"
    }
  ]
}
