{
  "note": "EP12 剧情对白简体中文草稿（AI 起草，待用户审校）。src = 从字形表解出的日文原文，◇为译码缺字。※ 标注不确定处。※ 存疑条目：EP12_CP1_01（流れに◇らって）、EP12_CP1_12（嘲も）、EP12_CP5_03（りロボロス）。",
  "glossary": {
    "ハワート・ライト": "霍华德·莱特",
    "メリッサ・ゲイル": "梅丽莎·盖尔",
    "サム・モンロー": "山姆·门罗",
    "ベラ・モンロー": "贝拉·门罗",
    "ソル・ジャクソン": "索尔·杰克逊",
    "美耶古": "美耶古",
    "アマナ": "阿玛娜",
    "羽生蛇村": "羽生蛇村"
  },
  "lines": [
    {
      "name": "EP12_CP1_01",
      "src": "「流れに逆らってみるのも悪く無い」",
      "text": "「逆流而上试试，倒也不坏。」"
    },
    {
      "name": "EP12_CP1_02",
      "src": "「消えなさい」",
      "text": "「消失吧。」"
    },
    {
      "name": "EP12_CP1_03",
      "src": "「生憎 そんなヤワじやないんだ」",
      "text": "「可惜，并不像你想的那样。」"
    },
    {
      "name": "EP12_CP1_04",
      "src": "「あなただったのね？ 実を盗んだのは！」",
      "text": "「偷走果实的，是你吧？」"
    },
    {
      "name": "EP12_CP1_05",
      "src": "「ほんの一切れさ」",
      "text": "只拿了一小片。"
    },
    {
      "name": "EP12_CP1_06",
      "src": "「やめて一一！」",
      "text": "「住手——！」"
    },
    {
      "name": "EP12_CP1_07",
      "src": "「おい！ 起きろ！ ベラはどこだ？ おい！」",
      "text": "「喂！醒醒！贝拉在哪？喂！」"
    },
    {
      "name": "EP12_CP1_08",
      "src": "「くそっ！」",
      "text": "「可恶！」"
    },
    {
      "name": "EP12_CP1_09",
      "src": "「おい お前名前は？」",
      "text": "「喂，你叫什么名字？」"
    },
    {
      "name": "EP12_CP1_10",
      "src": "「ハワード・ライト」",
      "text": "「霍华德·莱特」"
    },
    {
      "name": "EP12_CP1_11",
      "src": "「私の名前はサム・モンローだ」",
      "text": "「我叫山姆·门罗。」"
    },
    {
      "name": "EP12_CP1_12",
      "src": "「もし また君がベラを見つけた時は頼む」",
      "text": "「要是你再见到贝拉，也告诉我一声。」"
    },
    {
      "name": "EP12_CP1_13",
      "src": "「あんたがサム・モンロー？」",
      "text": "「你就是山姆·门罗？」"
    },
    {
      "name": "EP12_CP1_14",
      "src": "「あんたがメッセージをくれた？」",
      "text": "「是你给我留言的？」"
    },
    {
      "name": "EP12_CP1_15",
      "src": "「何の話だ？」",
      "text": "说什么？"
    },
    {
      "name": "EP12_CP1_16",
      "src": "「ベラ！ ベラ！」",
      "text": "「贝拉！贝拉！」"
    },
    {
      "name": "EP12_CP3_01",
      "src": "「ベラ！」",
      "text": "「贝拉！」"
    },
    {
      "name": "EP12_CP3_02",
      "src": "「メリッサ……」",
      "text": "「梅丽莎……」"
    },
    {
      "name": "EP12_CP3_03",
      "src": "「マミィ？」",
      "text": "「妈妈？」"
    },
    {
      "name": "EP12_CP3_04",
      "src": "「ベラ一一！」",
      "text": "「贝拉——！」"
    },
    {
      "name": "EP12_CP3_05",
      "src": "「ミヤコ！ ここにいたんだ？」",
      "text": "「美耶古！你在这儿啊？」"
    },
    {
      "name": "EP12_CP3_06",
      "src": "「私はずっと傍にいるよ」",
      "text": "我会一直陪着你。"
    },
    {
      "name": "EP12_CP3_07",
      "src": "「約束したよね？ 一緒に逃げようって！」",
      "text": "「我们说好了吧？要一起逃走的！」"
    },
    {
      "name": "EP12_CP3_08",
      "src": "「お願い 全部……全部消して」",
      "text": "求你了，把一切全抹掉。"
    },
    {
      "name": "EP12_CP3_09",
      "src": "「この村もあいつらも全部」",
      "text": "村子，还有那些人……"
    },
    {
      "name": "EP12_CP3_10",
      "src": "「ミヤコ？ ミヤコ一一！」",
      "text": "「美耶古？美耶古——！」"
    },
    {
      "name": "EP12_CP5_01",
      "src": "「そんな！ そんなまさか！ 何て残酷な！」",
      "text": "「怎么会！难道说！太残酷了！」"
    },
    {
      "name": "EP12_CP5_02",
      "src": "「全ての始まりが生まれる」",
      "text": "「一切的开端将会诞生。」"
    },
    {
      "name": "EP12_CP5_03",
      "src": "「閉ざされた輪 ウロボロスの贄」",
      "text": "「闭合之环，乌洛波罗斯的祭品。」"
    },
    {
      "name": "EP12_CP5_04",
      "src": "「繰り返さねば」",
      "text": "要反复重演。"
    },
    {
      "name": "EP12_CP5_05",
      "src": "「あの子を永遠の存在にする為に」",
      "text": "「为了让那孩子成为永恒的存在。」"
    },
    {
      "name": "EP12_CP5_06",
      "src": "「ハワード そう言ったな」",
      "text": "霍华德，你说过吧。"
    },
    {
      "name": "EP12_CP5_07",
      "src": "「ミヤコとの約束だ」",
      "text": "与美耶古的约定。"
    }
  ]
}
