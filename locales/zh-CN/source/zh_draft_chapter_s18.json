    {
      "name": "CHA_CAUTION1_HNM_1",
      "src": "「怪シィジオオ？」",
      "text": "「好奇怪啊？」"
    },
    {
      "name": "CHA_CAUTION1_HNM_2",
      "src": "「誰ダ？ 誰ダア！」",
      "text": "「谁？谁啊！」"
    },
    {
      "name": "CHA_CAUTION1_SM1_0",
      "src": "「誰かいるのかあ？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM1_1",
      "src": "「ん？ 誰だあ？」",
      "text": "「嗯？是谁？」"
    },
    {
      "name": "CHA_CAUTION1_SM1_2",
      "src": "「ああ？ 何だあ？」",
      "text": "「啊？干什么？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_0",
      "src": "「ん～？ 誰だあ～？」",
      "text": "「嗯～？是谁呀～？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_1",
      "src": "「おい……誰かいるのかあ？」",
      "text": "「喂……有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_2",
      "src": "「何だあ？ おい？」",
      "text": "「干什么？喂？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_1",
      "src": "「そこかあ～？」",
      "text": "「在那边吗～？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_2",
      "src": "「ああ？ 誰だあ？」",
      "text": "「啊？是谁？」"
    },
    {
      "name": "CHA_CAUTION2_HNM_0",
      "src": "「イナイ！ イナイジオ！」",
      "text": "「不在！不在这儿啊！」"
    },
    {
      "name": "CHA_CAUTION2_HNM_1",
      "src": "「オイ！ ドコダア！」",
      "text": "「喂！在哪儿啊！」"
    },
    {
      "name": "CHA_CAUTION2_HNM_2",
      "src": "「戻レ！ 卑怯ダジオ！」",
      "text": "「回来！卑怯的达里奥！」"
    },
    {
      "name": "CHA_CAUTION2_SM1_0",
      "src": "「出てこいよお～」",
      "text": "「出来呀～」"
    },
    {
      "name": "CHA_CAUTION2_SM1_1",
      "src": "「どこ行ったあ？」",
      "text": "「跑哪去了？」"
    },
    {
      "name": "CHA_CAUTION2_SM1_2",
      "src": "「隠れても無駄だそお～」",
      "text": "「躲起来也没用哦～」"
    },
    {
      "name": "CHA_CAUTION2_SM2_0",
      "src": "「戻って……来いよお」",
      "text": "「回来……啊」"
    },
    {
      "name": "CHA_CAUTION2_SM2_1",
      "src": "「どこ……行ったあ？」",
      "text": "「跑哪……去了？」"
    },
    {
      "name": "CHA_CAUTION2_SM2_2",
      "src": "「無駄だよお」",
      "text": "「没用的」"
    },
    {
      "name": "CHA_CAUTION2_SM4_0",
      "src": "「こらあ！ 出て来いい！」",
      "text": "「喂！出来！」"
    },
    {
      "name": "CHA_CAUTION2_SM4_1",
      "src": "「どこ行ったあ……」",
      "text": "「跑哪去了……」"
    },
    {
      "name": "CHA_CAUTION2_SM4_2",
      "src": "「くそお……逃げ足の早い……」",
      "text": "「可恶……跑得真快……」"
    },
    {
      "name": "CHA_FINISH_KYU_0",
      "src": "「許して……」",
      "text": "「原谅我……」"
    },
    {
      "name": "CHA_FINISH_KYU_1",
      "src": "「どうか安らかに……」",
      "text": "「愿你安息……」"
    },
    {
      "name": "CHA_FINISH_KYU_2",
      "src": "「許して……」",
      "text": "「原谅我……」"
    },
    {
      "name": "CHA_ST18EVENT1_HNM_0",
      "src": "「泥棒ガ出タジオ～」",
      "text": "「小偷出现啦～」"
    },
    {
      "name": "CHA_ST18EVENT1_HNM_1",
      "src": "「マナ字架サマラ盗セエ～」",
      "text": "玛娜字架大人被偷走啦～"
    },
    {
      "name": "CHA_ST18EVENT1_HNM_2",
      "src": "「大変ダア！ 大変ダア～！」",
      "text": "「不好啦！不好啦～！」"
    },
    {
      "name": "CHA_ST18EVENT1_KYU",
      "src": "「過去の幻？ でも……なせ？」",
      "text": "过去的幻影？可是……为何？"
    },
    {
      "name": "CHA_ST18EVENT1_SF1_0",
      "src": "「無いわ……無いわ……」",
      "text": "「不见了……不见了……」"
    },
    {
      "name": "CHA_ST18EVENT1_SF1_1",
      "src": "「マナ字架さまが無いわ……」",
      "text": "「玛娜字架大人不见了……」"
    },
    {
      "name": "CHA_ST18EVENT1_SF1_2",
      "src": "「どうしよう……困ったわ……」",
      "text": "「怎么办……真伤脑筋……」"
    },
    {
      "name": "CHA_ST18EVENT1_SF2_0",
      "src": "「ああ大変だあ……大変だあ……」",
      "text": "「啊啊不好啦……不好啦……」"
    },
    {
      "name": "CHA_ST18EVENT1_SF2_1",
      "src": "「マナ字架さまがあ盗まれちまったよお……」",
      "text": "「玛娜字架大人被人偷走了呀……」"
    },
    {
      "name": "CHA_ST18EVENT1_SF2_2",
      "src": "「どこじやあ……マナ字架さまあ……どこじやあ……」",
      "text": "「在哪里呀……玛娜字架大人……在哪里呀……」"
    },
    {
      "name": "CHA_ST18EVENT1_SM1_0",
      "src": "「ああ……大変だ……大変だ……マナ字架さまがねえよお……」",
      "text": "「啊啊……不好啦……不好啦……玛娜字架大人不见了呀……」"
    },
    {
      "name": "CHA_ST18EVENT1_SM1_1",
      "src": "「くそお……盗人め……マナ字架さまを返ぜえ……」",
      "text": "「可恶……小偷……把玛娜字架大人还回来……」"
    },
    {
      "name": "CHA_ST18EVENT1_SM1_2",
      "src": "「誰だよお……マナ字架さま盗んだのはよお……」",
      "text": "「到底是谁……偷了玛娜字架大人啊……」"
    },
    {
      "name": "CHA_ST18EVENT1_SM2_0",
      "src": "「マナ字架さまがねえよお」",
      "text": "「玛娜字架大人不见了呀」"
    },
    {
      "name": "CHA_ST18EVENT1_SM2_1",
      "src": "「誰だあ……マナ字架さま盗ったのはあ……」",
      "text": "「是谁啊……偷了玛娜字架大人的……」"
    },
    {
      "name": "CHA_ST18EVENT1_SM2_2",
      "src": "「罰当たりな盗人めえ……」",
      "text": "「遭报应的小偷……」"
    },
    {
