{
  "note": "EP09 剧情对白简体中文草稿（AI 起草，待用户审校）。src = 从字形表解出的日文原文，◇为译码缺字。※ 不确定处：EP09_CP3_01、EP09_CP3_03、EP09_CP5_01。",
  "glossary": {
    "ハワート・ライト": "霍华德·莱特",
    "メリッサ・ゲイル": "梅丽莎·盖尔",
    "サム・モンロー": "山姆·门罗",
    "ベラ・モンロー": "贝拉·门罗",
    "ソル・ジャクソン": "索尔·杰克逊",
    "美耶古": "美耶古",
    "アマナ": "阿玛娜",
    "羽生蛇村": "羽生蛇村"
  },
  "lines": [
    {
      "name": "EP09_CP1_01",
      "src": "「ベラ！ 早く乗って！」",
      "text": "「贝拉！快上车！」"
    },
    {
      "name": "EP09_CP1_02",
      "src": "「いやあ！ マミィ！」",
      "text": "「不要！妈咪！」"
    },
    {
      "name": "EP09_CP1_03",
      "src": "「来るな！」",
      "text": "「别过来！」"
    },
    {
      "name": "EP09_CP1_04",
      "src": "「このクソ野郎！」",
      "text": "「你这混蛋！」"
    },
    {
      "name": "EP09_CP1_05",
      "src": "「ベラに何かあったら訴えてやるからな！」",
      "text": "「要是贝拉有个三长两短，我饶不了你！」"
    },
    {
      "name": "EP09_CP1_06",
      "src": "「へイ！ 落ち着いてくれよ！ な？って言うか何で俺のぜいなんだよ！」",
      "text": "「喂！冷静一下！好吗？\n话说怎么成了我的错啊！」"
    },
    {
      "name": "EP09_CP1_07",
      "src": "「ベラ！ 捕まって！」",
      "text": "「贝拉！抓住！」"
    },
    {
      "name": "EP09_CP1_08",
      "src": "「ほら 動け！ 動けってば！」",
      "text": "「喂，快动！叫你快动啊！」"
    },
    {
      "name": "EP09_CP1_09",
      "src": "「ベラを連れて来たのはそっちの勝手だろ？」",
      "text": "「把贝拉带来，可是你自己的主意吧？」"
    },
    {
      "name": "EP09_CP1_10",
      "src": "「ああっ もうっ！」",
      "text": "「啊——真是的！」"
    },
    {
      "name": "EP09_CP1_11",
      "src": "「ベラ！ 来なさい！」",
      "text": "「贝拉！过来！」"
    },
    {
      "name": "EP09_CP1_12",
      "src": "「ベラ！ 何してるの早く！」",
      "text": "「贝拉！你在干什么，快点！」"
    },
    {
      "name": "EP09_CP1_13",
      "src": "「うん」",
      "text": "「嗯。」"
    },
    {
      "name": "EP09_CP3_01",
      "src": "「くそっ！ ベラ メリッサ頼む 無事でいてくれ一一」",
      "text": "「混蛋！贝拉、梅丽莎，\n大家都要平安无事——」"
    },
    {
      "name": "EP09_CP3_02",
      "src": "「ああっ！」",
      "text": "「啊啊！」"
    },
    {
      "name": "EP09_CP3_03",
      "src": "「とうとう買い換え時か」",
      "text": "「终于该换新了吗？」"
    },
    {
      "name": "EP09_CP3_04",
      "src": "「これで八つ当たりされる理由が一つ減ったな」",
      "text": "「这样一来，被迁怒的理由就少了一个。」"
    },
    {
      "name": "EP09_CP3_05",
      "src": "「これは？」",
      "text": "「这是？」"
    },
    {
      "name": "EP09_CP3_06",
      "src": "「なせだ？ 前にもここで……？」",
      "text": "「为什么？之前也在这里……？」"
    },
    {
      "name": "EP09_CP3_07",
      "src": "「いやあっ！ いやあっ！ いやあっ！」",
      "text": "「不要！不要！不要！」"
    },
    {
      "name": "EP09_CP3_08",
      "src": "「妙な気分だな」",
      "text": "感觉真怪啊。"
    },
    {
      "name": "EP09_CP5_01",
      "src": "「これは私の血の杯 罪の許しとなる永遠の契約の血」",
      "text": "「这是我的血杯，成为罪之宽恕的永恒契约之血。」"
    },
    {
      "name": "EP09_CP5_02",
      "src": "「こうするしかできない……」",
      "text": "「只能这么做了……」"
    },
    {
      "name": "EP09_CP5_03",
      "src": "「ぜっかくきれいだったのに」",
      "text": "「好不容易才变得漂亮的呢。」"
    },
    {
      "name": "EP09_CP5_04",
      "src": "「ミヤコ！」",
      "text": "「美耶古！」"
    },
    {
      "name": "EP09_CP5_05",
      "src": "「どういうことだ？」",
      "text": "「怎么回事？」"
    },
    {
      "name": "EP09_CP5_06",
      "src": "「すべて予言されていた？」",
      "text": "「一切都是被预言过的？」"
    },
    {
      "name": "EP09_CP5_07",
      "src": "「私達の存在までが……そんな馬鹿な」",
      "text": "「连我们的存在也是……怎么可能。」"
    },
    {
      "name": "EP09_CP5_08",
      "src": "「くそっ！」",
      "text": "「混蛋！」"
    }
  ]
}
