    {
      "name": "CHA_CAUTION1_SF2_0",
      "src": "「んっ？ 誰だい？」",
      "text": "「嗯？是谁啊？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_1",
      "src": "「誰かいるのかあ？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_2",
      "src": "「そこに誰かいるねえ？」",
      "text": "「那边有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM1_0",
      "src": "「誰かいるのかあ？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM1_1",
      "src": "「ん？ 誰だあ？」",
      "text": "「嗯？是谁啊？」"
    },
    {
      "name": "CHA_CAUTION1_SM1_2",
      "src": "「ああ？ 何だあ？」",
      "text": "「啊啊？什么啊？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_1",
      "src": "「そこかあ～？」",
      "text": "「在那儿吗～？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_2",
      "src": "「ああ？ 誰だあ？」",
      "text": "「啊啊？是谁啊？」"
    },
    {
      "name": "CHA_CAUTION2_SF2_0",
      "src": "「ああっ！ 頭に来るねえ……」",
      "text": "「啊啊！真让人火大……」"
    },
    {
      "name": "CHA_CAUTION2_SF2_1",
      "src": "「こらあ！ 出て来い」",
      "text": "「喂！出来！」"
    },
    {
      "name": "CHA_CAUTION2_SF2_2",
      "src": "「じっとしてなって言ってんだよお！」",
      "text": "「叫你别动听不懂吗！」"
    },
    {
      "name": "CHA_CAUTION2_SM1_0",
      "src": "「出てこいよお～」",
      "text": "「出来呀～」"
    },
    {
      "name": "CHA_CAUTION2_SM1_1",
      "src": "「どこ行ったあ？」",
      "text": "「跑哪儿去了？」"
    },
    {
      "name": "CHA_CAUTION2_SM1_2",
      "src": "「隠れても無駄だそお～」",
      "text": "「躲着也没用哦～」"
    },
    {
      "name": "CHA_CAUTION2_SM4_0",
      "src": "「こらあ！ 出て来いい！」",
      "text": "「喂！快出来！」"
    },
    {
      "name": "CHA_CAUTION2_SM4_1",
      "src": "「どこ行ったあ……」",
      "text": "「跑哪儿去了……」"
    },
    {
      "name": "CHA_CAUTION2_SM4_2",
      "src": "「くそお……逃げ足の早い……」",
      "text": "「可恶……跑得真快……」"
    },
    {
      "name": "CHA_EVENT1_CAM_0",
      "src": "「早くしてくれよサム…… まあ あまり頼りになる相手じやなさそうだけどな……」",
      "text": "「快点啊山姆……\n不过看起来不太靠得住就是了……」"
    },
    {
      "name": "CHA_EVENT1_CAM_1",
      "src": "「くそっ！ 何でこんなとこに来ちまったんだ？」",
      "text": "「可恶！为什么会跑到这种地方来？」"
    },
    {
      "name": "CHA_EVENT1_CAM_2",
      "src": "「メリッサ……無事に会えたら絶対に気持ちを伝えるよ！」",
      "text": "「梅丽莎……要是能平安见到你，我一定把心意告诉你！」"
    },
    {
      "name": "CHA_EVENT1_CAM_3",
      "src": "「今すくバーガーにかぶりつきたいせ……」",
      "text": "「现在就想咬一大口汉堡……」"
    },
    {
      "name": "CHA_EVENT2_CAM_0",
      "src": "「はっはあ！ 感謝しろよ！」",
      "text": "「哈哈！佩服我吧！」"
    },
    {
      "name": "CHA_FINISH_CAM_0",
      "src": "「やったせ！」",
      "text": "「成功了！」"
    },
    {
      "name": "CHA_FINISH_CAM_1",
      "src": "「運が悪かったな」",
      "text": "「算你运气不好。」"
    },
    {
      "name": "CHA_FINISH_GAK_0",
      "src": "「どうだ！？」",
      "text": "「怎么样！？」"
    },
    {
      "name": "CHA_FINISH_GAK_1",
      "src": "「悪く思うな……！」",
      "text": "「别怪我……！」"
    },
    {
      "name": "CHA_SCREAM_GAK_0",
      "src": "「おい！ 大丈夫か！？」",
      "text": "「喂！你没事吧！？」"
    },
    {
      "name": "CHA_SCREAM_GAK_1",
      "src": "「立て！ 逃げるんだ！」",
      "text": "「站起来！快逃！」"
    },
    {
      "name": "CHA_SCREAM_GAK_2",
      "src": "「おい！ ふざけてる場合じやないそ！？」",
      "text": "「喂！现在不是胡闹的时候吧！？」"
    },
    {
      "name": "CHA_SCREAM_GAK_3",
      "src": "「ソル！」",
      "text": "「索尔！」"
    },
    {
      "name": "CHA_SCREAM_GAK_4",
      "src": "「メリッサ！」",
      "text": "「梅丽莎！」"
    },
    {
      "name": "CHA_ST13EVENT1_GAK_0",
      "src": "「ここはどこだ？ 皆どこへ行った？」",
      "text": "「这是哪里？大家都去哪儿了？」"
    },
    {
      "name": "CHA_ST13EVENT1_GAK_1",
      "src": "「俺は……一体？」",
      "text": "「我……怎么了？」"
    },
    {
      "name": "CHA_ST13EVENT1_GAK_2",
      "src": "「何なんだこの村は」",
      "text": "这村子到底是什么？"
    },
    {
      "name": "CHA_ST13EVENT1_SM1_0",
      "src": "「おおい……あんたかあ？ 電気消したのあんたかあ？」",
      "text": "「喂……是你啊？是你关的灯吗？」"
    },
    {
      "name": "CHA_ST13EVENT1_SM4_0",
      "src": "「ああ？ 何だってえ？ ああ？ ああ？ ああ？」",
      "text": "「啊啊？你说什么？啊啊？啊啊？啊啊？」"
    },
    {
      "name": "CHA_ST13EVENT2_GAK_0",
      "src": "「あいつさえ何とかなればな……」",
      "text": "「只要那家伙能解决就好了……」"
    },
    {
      "name": "CHA_ST13EVENT2_GAK_1",
      "src": "「くそっ！ 邪鬼な奴が……」",
      "text": "可恶！真是个邪门家伙……"
    },
    {
      "name": "CHA_ST13EVENT2_GAK_2",
      "src": "「他に道はないのか……」",
      "text": "「没有别的路了吗……」"
    },
    {
      "name": "CHA_ST13EVENT4_GAK_0",
      "src": "「しかし何なんだここは……前に来た事があるような……」",
      "text": "「可这到底是哪里……好像以前来过……」"
    },
    {
      "name": "CHA_ST13EVENT4_GAK_1",
      "src": "「前にも来たことがあるような……何でだ？」",
      "text": "「好像以前也来过……为什么？」"
    },
    {
      "name": "CHA_ST13EVENT4_GAK_2",
      "src": "「この感覚……デジャグって奴か？」",
      "text": "这种感觉……就是既视感吗？"
    },
    {
      "name": "CHA_ST13EVENT5_GAK_0",
      "src": "「くそっ やっかいだそ」",
      "text": "「可恶，真麻烦。」"
    },
    {
      "name": "CHA_ST13EVENT5_GAK_1",
      "src": "「邪鬼ばかりだ」",
      "text": "尽是邪门东西"
    },
    {
      "name": "CHA_ST13EVENT5_GAK_2",
      "src": "「くそっ ここもか！ 他に道はないのか？」",
      "text": "「可恶，这里也是吗！没有别的路了吗？」"
    },
    {
      "name": "CHA_ST13EVENT6_GAK_0",
      "src": "「助かった！ とにかくここを出よう！」",
      "text": "「得救了！总之先离开这里吧！」"
    },
    {
      "name": "CHA_ST18EVENT1_SM1_0",
      "src": "「ああ……大変だ……大変だ……マナ字架さまがねえよお……」",
      "text": "「啊啊……不得了……不得了……真鱼字架大人不见了啊……」"
    },
    {
      "name": "CHA_ST18EVENT1_SM1_1",
      "src": "「くそお……盗人め……マナ字架さまを返ぜえ……」",
      "text": "「可恶……小偷……快把真鱼字架大人还回来……」"
    },
    {
      "name": "CHA_ST18EVENT1_SM1_2",
      "src": "「誰だよお……マナ字架さま盗んだのはよお……」",
      "text": "「是谁啊……偷走真鱼字架大人的家伙……」"
    },
    {
      "name": "CHA_STARTST13_GAK_0",
      "src": "「どうすりやいいんだ」",
      "text": "「该怎么办才好。」"
    },
    {
      "name": "CHA_START_CAM_0",
      "src": "「楽な仕事のはずだったのに……」",
      "text": "「明明是份轻松的工作……」"
    },
    {
      "name": "CHA_START_CAM_1",
      "src": "「メリッサ……ベラ……無事でいてくれよ」",
      "text": "「梅丽莎……贝拉……你们要平安无事啊。」"
    },
    {
      "name": "CHA_START_CAM_2",
      "src": "「どうなってるんだよ……妙な気分だせ……」",
      "text": "「到底怎么回事……感觉怪怪的。」"
    },
