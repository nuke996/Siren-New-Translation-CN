    {
      "name": "S13_MESSAGE001",
      "src": "電源は来ているはずだが、ランプが消えている。故障だろうか……。",
      "text": "电源应该通着，可灯却灭着。\n是故障了吗……。"
    },
    {
      "name": "S13_MESSAGE002",
      "src": "古びた雑誌がある。",
      "text": "有一座老旧的杂屋。"
    },
    {
      "name": "S13_MESSAGE003",
      "src": "ランプが消えている。エレベーターの電源が入っていないようだ。",
      "text": "灯灭着。\n电梯的电源好像没开。"
    },
    {
      "name": "S99_AREA_OVER1",
      "src": "戻る訳にはいかない。",
      "text": "不能回头。"
    },
    {
      "name": "S99_AREA_OVER10",
      "src": "サムを置いていく訳にはいかない……。",
      "text": "不能丢下山姆……。"
    },
    {
      "name": "S99_AREA_OVER11",
      "src": "この先には用がない……。",
      "text": "前方没有事情要办……。"
    },
    {
      "name": "S99_AREA_OVER2",
      "src": "この先は危険だ……。",
      "text": "前面很危险……。"
    },
    {
      "name": "S99_AREA_OVER3",
      "src": "目的を果たさなければならない。",
      "text": "必须达成目的。"
    },
    {
      "name": "S99_AREA_OVER4",
      "src": "美耶古を置いていく訳にはいかない……。",
      "text": "不能丢下美耶古……。"
    },
    {
      "name": "S99_AREA_OVER5",
      "src": "メリッサを置いていく訳にはいかない……。",
      "text": "不能丢下梅丽莎……。"
    },
    {
      "name": "S99_AREA_OVER6",
      "src": "アマナを置いていく訳にはいかない……。",
      "text": "不能丢下阿玛娜……。"
    },
    {
      "name": "S99_AREA_OVER7",
      "src": "ベラを置いていく訳にはいかない……。",
      "text": "不能丢下贝拉……。"
    },
    {
      "name": "S99_AREA_OVER8",
      "src": "ベラを探さなければ……。",
      "text": "必须去找贝拉……。"
    },
    {
      "name": "S99_AREA_OVER9",
      "src": "技が折れている。ここからは戻れそうにない。",
      "text": "树枝断了。从这里似乎回不去了。"
    },
