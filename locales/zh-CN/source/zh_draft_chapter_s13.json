    {
      "name": "EP08_CP2_1_01",
      "src": "「サム？ おいサムなのか？ サムだよな？」",
      "text": "「山姆？喂，是山姆吗？是山姆吧？」"
    },
    {
      "name": "EP08_CP2_1_02",
      "src": "「ソルか？」",
      "text": "「索尔吗？」"
    },
    {
      "name": "EP08_CP2_1_03",
      "src": "「ソル！ メリッサとベラは一緒か？」「サム！ メリッサとベラはそこに？」",
      "text": "「索尔！梅丽莎和贝拉跟你在一起吗？」\n「山姆！梅丽莎和贝拉在你那儿吗？」"
    },
    {
      "name": "EP08_CP2_1_04",
      "src": "「一体何が起きてるんだ……くそっ！」",
      "text": "「到底发生了什么……可恶！」"
    },
    {
      "name": "EP08_CP2_1_05",
      "src": "「おい この扉そっちから開いたりは」",
      "text": "「喂，这扇门能不能从你那边打开」"
    },
    {
      "name": "EP08_CP2_1_06",
      "src": "「しなそうだね」",
      "text": "「好像不行呢。」"
    },
    {
      "name": "EP08_CP2_1_07",
      "src": "「参ったな」",
      "text": "伤脑筋。"
    },
    {
      "name": "EP08_CP2_1_08",
      "src": "「優しいお友達ってタイプじやなさそうだ」",
      "text": "「看起来不像是友善的朋友那种类型。」"
    },
    {
      "name": "EP08_CP2_1_09",
      "src": "「気をつけろ！ とにかく合流出来そうな場所を探そう！」",
      "text": "「小心点！总之先找个能会合的地方！」"
    },
    {
      "name": "EP08_CP2_1_10",
      "src": "「ＯK！」",
      "text": "「OK！」"
    },
    {
      "name": "EP08_CP2_2_01",
      "src": "「くそっ！ 必要な時に限ってこれだよ」",
      "text": "「可恶！偏偏这种时候掉链子。」"
    },
    {
      "name": "EP08_CP2_2_02",
      "src": "「このままじや埒が明かない 何とかしないとな」",
      "text": "「这样下去没个完，得想个办法。」"
    },
    {
      "name": "EP08_CP2_3_01",
      "src": "「ああ くそっ！」",
      "text": "「啊啊，可恶！」"
    },
    {
      "name": "EP08_CP2_3_02",
      "src": "「ＯK！ その調子だ！」",
      "text": "「OK！就这样！」"
    },
