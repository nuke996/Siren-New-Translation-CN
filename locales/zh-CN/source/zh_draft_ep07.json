  "glossary": {
    "ハワート・ライト": "霍华德·莱特",
    "メリッサ・ゲイル": "梅丽莎·盖尔",
    "サム・モンロー": "山姆·门罗",
    "ベラ・モンロー": "贝拉·门罗",
    "ソル・ジャクソン": "索尔·杰克逊",
    "美耶古": "美耶古",
    "アマナ": "阿玛娜",
