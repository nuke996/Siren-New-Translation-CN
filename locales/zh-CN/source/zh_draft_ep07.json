  "lines": [
    {
      "name": "EP07_CP1_01",
      "src": "「私よ ベラよ！ 私よ！」",
      "text": "是我，是贝拉！是我！"
    },
    {
      "name": "EP07_CP1_02",
      "src": "「ベラ！」",
      "text": "贝拉！"
    },
    {
      "name": "EP07_CP1_03",
      "src": "「ダディ！ マミィ！ 私よ！ダディ！ マミィ！ お願いここを開けて！」",
      "text": "爸爸！妈妈！是我！\n爸爸！妈妈！求你们把门打开！"
    },
    {
      "name": "EP07_CP1_04",
      "src": "「メリッサ！ 駄目だ！」",
      "text": "梅丽莎！不行！"
    },
    {
      "name": "EP07_CP1_05",
      "src": "「ダディィィマミィィィ」",
      "text": "爸爸——妈妈——"
    },
    {
      "name": "EP07_CP1_06",
      "src": "「嫌……私 死にたくない」",
      "text": "不要……我不想死。"
    },
    {
      "name": "EP07_CP1_07",
      "src": "「あれは？」",
      "text": "那是？"
    },
    {
      "name": "EP07_CP1_08",
      "src": "「近くにいるの？ お願い……早く！」",
      "text": "你在附近吗？求你了……快点！"
    },
    {
      "name": "EP07_CP1_09",
      "src": "「ミヤコ ここにいるのか？」",
      "text": "美耶古，你在这里吗？"
    },
    {
      "name": "EP07_CP3_01",
      "src": "「ベラ……メリッサ……」",
      "text": "贝拉……梅丽莎……"
    },
    {
      "name": "EP07_CP3_02",
      "src": "「どうして？ 実を捧げたのに」",
      "text": "「为什么？明明献上果实了……」"
    },
    {
      "name": "EP07_CP3_03",
      "src": "「ここは？」",
      "text": "这里是？"
    },
    {
      "name": "EP07_CP3_04",
      "src": "「ミヤコ？」",
      "text": "美耶古？"
    },
    {
      "name": "EP07_CP5_01",
      "src": "「こども？ 酷すきる……」",
      "text": "孩子？太过分了……"
    },
    {
      "name": "EP07_CP5_02",
      "src": "「ベラから離れて」",
      "text": "离贝拉远点。"
    },
    {
      "name": "EP07_CP5_03",
      "src": "「もう大丈夫 マミィはどこにも行かない」",
      "text": "没事了，妈妈哪儿也不去。"
    },
    {
      "name": "EP07_CP5_04",
      "src": "「これでは違う」",
      "text": "这样不对。"
    },
    {
      "name": "EP07_CP5_05",
      "src": "「ウロボロスの輪は義がらない……」",
      "text": "乌洛波洛斯之轮不会终结……"
    },
    {
      "name": "EP07_CP5_06",
      "src": "「何だよこの感じ 気持ち悪りい……くそっ！」",
      "text": "这什么感觉，好恶心……混蛋！"
    },
    {
      "name": "EP07_CP5_07",
      "src": "「くそっ！ なんだ今の？」",
      "text": "混蛋！刚才那是什么？"
    },
    {
      "name": "EP07_CP5_08",
      "src": "「あなた大丈夫？」",
      "text": "你没事吧？"
    }
  ]
}
