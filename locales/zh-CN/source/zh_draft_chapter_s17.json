    {
      "name": "CHA_AFTERDRAT_CAS_0",
      "src": "「やっと会えたね！」",
      "text": "「终于见到你了！」"
    },
    {
      "name": "CHA_AFTERDRAT_CAS_1",
      "src": "「ベイビーちやん 手間かけさぜないでおくれよ」",
      "text": "「宝贝，可别让我费心啊」"
    },
    {
      "name": "CHA_AFTERDRAT_CAS_2",
      "src": "「惜しかったな！」",
      "text": "「真可惜啊！」"
    },
    {
      "name": "CHA_BATTLE_CAS_0",
      "src": "「ベラ！ ベラ～！ ベラ～！」",
      "text": "「贝拉！贝拉～！贝拉～！」"
    },
    {
      "name": "CHA_BATTLE_CAS_1",
      "src": "「もう逃がさないそお～」",
      "text": "「不会再让你逃了哦～」"
    },
    {
      "name": "CHA_CAUTION1_CAS_1",
      "src": "「聞こえるよ～！」",
      "text": "「听得见哦～！」"
    },
    {
      "name": "CHA_CAUTION1_CAS_2",
      "src": "「わかったそ！ そこにいるんだね！」",
      "text": "「我知道了！你在那儿吧！」"
    },
    {
      "name": "CHA_CAUTION1_CHU_0",
      "src": "「大人しく出てきなさい」",
      "text": "「乖乖出来」"
    },
    {
      "name": "CHA_CAUTION1_CHU_1",
      "src": "「そこかっ？ 動くんじやないそ」",
      "text": "「在那儿吗？别动！」"
    },
    {
      "name": "CHA_CAUTION1_CHU_2",
      "src": "「そこにいるのはわかってるんだそ」",
      "text": "「我知道你就在那儿」"
    },
    {
      "name": "CHA_CAUTION1_HNM_1",
      "src": "「怪シィジオオ？」",
      "text": "「好奇怪啊？」"
    },
    {
      "name": "CHA_CAUTION1_HNM_2",
      "src": "「誰ダ？ 誰ダア！」",
      "text": "「谁？谁啊！」"
    },
    {
      "name": "CHA_CAUTION1_SM2_0",
      "src": "「ん～？ 誰だあ～？」",
      "text": "「嗯～？是谁呀～？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_1",
      "src": "「おい……誰かいるのかあ？」",
      "text": "「喂……有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_2",
      "src": "「何だあ？ おい？」",
      "text": "「干什么？喂？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_1",
      "src": "「そこかあ～？」",
      "text": "「在那边吗～？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_2",
      "src": "「ああ？ 誰だあ？」",
      "text": "「啊？是谁？」"
    },
    {
      "name": "CHA_CAUTION2_CAS_0",
      "src": "「お～い 逃げないでくれよ」",
      "text": "「喂～别逃啊」"
    },
    {
      "name": "CHA_CAUTION2_CAS_1",
      "src": "「冗談きついせ……」",
      "text": "这玩笑太过分了…"
    },
    {
      "name": "CHA_CAUTION2_CAS_2",
      "src": "「出ておいで～子猫ちやん～」",
      "text": "「出来吧～小猫咪～」"
    },
    {
      "name": "CHA_CAUTION2_CHU_0",
      "src": "「くそっ！ 逃げ足の速いヤツだ」",
      "text": "「可恶！跑得真快的家伙」"
    },
    {
      "name": "CHA_CAUTION2_CHU_1",
      "src": "「逃げられたか……俺もそろそろ歳かな……」",
      "text": "「让他跑了……我也差不多该上年纪了吧……」"
    },
    {
      "name": "CHA_CAUTION2_CHU_2",
      "src": "「次は絶対捕まえるからなあ」",
      "text": "「下次绝对要抓住你」"
    },
    {
      "name": "CHA_CAUTION2_HNM_0",
      "src": "「イナイ！ イナイジオ！」",
      "text": "「不在！不在这儿啊！」"
    },
    {
      "name": "CHA_CAUTION2_HNM_1",
      "src": "「オイ！ ドコダア！」",
      "text": "「喂！在哪儿啊！」"
    },
    {
      "name": "CHA_CAUTION2_HNM_2",
      "src": "「戻レ！ 卑怯ダジオ！」",
      "text": "「回来！卑怯的达里奥！」"
    },
    {
      "name": "CHA_CAUTION2_SM2_0",
      "src": "「戻って……来いよお」",
      "text": "「回来……啊」"
    },
    {
      "name": "CHA_CAUTION2_SM2_1",
      "src": "「どこ……行ったあ？」",
      "text": "「跑哪……去了？」"
    },
    {
      "name": "CHA_CAUTION2_SM2_2",
      "src": "「無駄だよお」",
      "text": "「没用的」"
    },
    {
      "name": "CHA_CAUTION2_SM4_0",
      "src": "「こらあ！ 出て来いい！」",
      "text": "「喂！出来！」"
    },
    {
      "name": "CHA_CAUTION2_SM4_1",
      "src": "「どこ行ったあ……」",
      "text": "「跑哪去了……」"
    },
    {
      "name": "CHA_CAUTION2_SM4_2",
      "src": "「くそお……逃げ足の早い……」",
      "text": "「可恶……跑得真快……」"
    },
    {
      "name": "CHA_DIE_MUS",
      "src": "「いやあ一一！」",
      "text": "「不要啊——！」"
    },
    {
      "name": "CHA_FINISH_DOC_0",
      "src": "「どうした？」",
      "text": "「怎么了？」"
    },
    {
      "name": "CHA_FINISH_DOC_1",
      "src": "「こんなものか？」",
      "text": "「就这种程度吗？」"
    },
    {
      "name": "CHA_FINISH_DOC_2",
      "src": "「化け物め」",
      "text": "「怪物」"
    },
    {
      "name": "CHA_PATROL_CAS_0",
      "src": "「ベラ……もう大丈夫だよ」",
      "text": "「贝拉……已经没事了」"
    },
    {
      "name": "CHA_PATROL_CAS_1",
      "src": "「信じてくれよ……ボクが守ってあげるよ」",
      "text": "「相信我吧……我会保护你的」"
    },
    {
      "name": "CHA_PATROL_CAS_2",
      "src": "「ベラ ボク メリッサ 幸ぜな家族になろうせ」",
      "text": "「贝拉、我、梅丽莎，组成幸福的一家人吧」"
    },
    {
      "name": "CHA_PATROL_CAS_4",
      "src": "「眺ずかしがらないで出ておいで……」",
      "text": "「别害羞，出来吧……」"
    },
    {
      "name": "CHA_SCREAM_DOC_0",
      "src": "「良い気はしないな」",
      "text": "「感觉不太妙啊」"
    },
    {
      "name": "CHA_SCREAM_DOC_1",
      "src": "「運が無かったようだな」",
      "text": "「看来你运气不好啊」"
    },
    {
      "name": "CHA_SCREAM_DOC_2",
      "src": "「ここまでか」",
      "text": "到此为止了吗"
    },
    {
      "name": "CHA_ST06EVENT1_CHU_0",
      "src": "「おっ？ 羽生蛇じやないか……いいねえ！」",
      "text": "「哦？这不是羽生吗……不错啊！」"
    },
    {
      "name": "CHA_ST06EVENT2_CHU_0",
      "src": "「ご馳走になりますよ……頂きまあ～す」",
      "text": "「那我就不客气了……收下啦～」"
    },
    {
      "name": "CHA_ST06EVENT3_CHU_0",
      "src": "「ふう……腹いっぱい……」",
      "text": "「呼……吃得好饱……」"
    },
    {
      "name": "CHA_ST06EVENT5_CHU_0",
      "src": "「ああ……飯でも食うかあ」",
      "text": "「啊……去吃点东西吧」"
    },
    {
      "name": "CHA_ST06EVENT5_CHU_1",
      "src": "「腹が減っては戦は出来ん」",
      "text": "「肚子饿了可没法打仗」"
    },
    {
      "name": "CHA_ST06EVENT5_CHU_2",
      "src": "「何か食い物……食い物……」",
      "text": "「找点吃的……吃的……」"
    },
    {
      "name": "CHA_ST14EVENT1_MUS_0",
      "src": "「いやっ！ あっちいけ！」",
      "text": "「不要！滚那边去！」"
    },
    {
      "name": "CHA_ST14EVENT1_MUS_1",
      "src": "「助けてっ！」",
      "text": "「救命！」"
    },
    {
      "name": "CHA_ST14EVENT1_MUS_2",
      "src": "「マミィ 助けて！ どこ！？」",
      "text": "「妈妈，救我！你在哪！？」"
    },
    {
      "name": "CHA_STARTST17_DOC_0",
      "src": "「子供とはな……」",
      "text": "「小孩子啊……」"
    },
    {
      "name": "CHA_STARTST17_DOC_1",
      "src": "「なせ こんなところに……？」",
      "text": "「为什么……会在这种地方？」"
    },
    {
      "name": "CHA_STARTST17_DOC_2",
      "src": "「この感覚……前にも？」",
      "text": "这种感觉……以前有过？"
