    {
      "name": "CHA_FINISH_DOC_0",
      "src": "「どうした？」",
      "text": "「怎么了？」"
    },
    {
      "name": "CHA_FINISH_DOC_1",
      "src": "「こんなものか？」",
      "text": "「就这样而已吗？」"
    },
    {
      "name": "CHA_FINISH_SHU_0",
      "src": "「くたばれ！」",
      "text": "「去死吧！」"
    },
    {
      "name": "CHA_FINISH_SHU_1",
      "src": "「二度と起き上がるなよ」",
      "text": "「别再爬起来了」"
    },
    {
      "name": "CHA_FINISH_SHU_2",
      "src": "「どうだっ！？」",
      "text": "「怎么样！？」"
    },
    {
      "name": "CHA_FINISH_SHU_3",
      "src": "「くそったれ！」",
      "text": "「混蛋！」"
    },
    {
      "name": "CHA_FINISH_SHU_4",
      "src": "「そのまま消えてくれ……」",
      "text": "「就这样消失吧……」"
    },
    {
      "name": "CHA_SCREAM_DOC_0",
      "src": "「良い気はしないな」",
      "text": "「真让人不舒服啊」"
    },
    {
      "name": "CHA_SCREAM_DOC_1",
      "src": "「運が無かったようだな」",
      "text": "「看来是运气不好啊」"
    },
    {
      "name": "CHA_SCREAM_DOC_2",
      "src": "「ここまでか」",
      "text": "到此为止了吗"
    },
    {
      "name": "CHA_SCREAM_SHU_0",
      "src": "「お おい！」",
      "text": "「喂、喂！」"
    },
    {
      "name": "CHA_SCREAM_SHU_1",
      "src": "「おい！ しっかりしてくれ！」",
      "text": "「喂！振作点！」"
    },
    {
      "name": "CHA_SCREAM_SHU_2",
      "src": "「ちくしよう！ 何で……！？」",
      "text": "「可恶！为什么……！？」"
    },
    {
      "name": "CHA_SCREAM_SHU_3",
      "src": "「ミヤコ！」",
      "text": "「美耶古！」"
    },
    {
      "name": "CHA_ST23EVENT1_DOC_0",
      "src": "「どこへ行った？」",
      "text": "「去哪了？」"
    },
    {
      "name": "CHA_ST23EVENT1_DOC_1",
      "src": "「運命からは逃げ出ぜない」",
      "text": "「无法逃脱命运」"
    },
    {
      "name": "CHA_ST23EVENT1_DOC_2",
      "src": "「期待に応えてくれよ」",
      "text": "「别辜负我的期待啊」"
    },
    {
      "name": "CHA_ST23EVENT1_MIY_0",
      "src": "「ねえ 気づいて？ 私はここにいるよ……」",
      "text": "「喂，你发现了吗？我就在这里哦……」"
    },
    {
      "name": "CHA_ST23EVENT2_DOC_0",
      "src": "「さあ これで最後だ」",
      "text": "来吧，就到最后了"
    },
    {
      "name": "CHA_ST23EVENT2_DOC_1",
      "src": "「戦え」",
      "text": "战斗"
    },
    {
      "name": "CHA_ST23EVENT2_DOC_2",
      "src": "「戦え」",
      "text": "战斗"
    },
    {
      "name": "CHA_ST23EVENT2_MIY_0",
      "src": "「お願い 私の目を使って！」",
      "text": "「求你了，用我的眼睛！」"
    },
    {
      "name": "CHA_ST23EVENT2_MIY_1",
      "src": "「ねえ 私の目を通して見て」",
      "text": "「喂，透过我的眼睛看」"
    },
    {
      "name": "CHA_ST23EVENT2_MIY_2",
      "src": "「私の目を使うの お願い！」",
      "text": "「用我的眼睛，求你了！」"
    },
    {
      "name": "CHA_ST23EVENT3_MIY_0",
      "src": "「私はいつでも傍にいるよ……◇お願い！ 私と一緒に依り代を探して」",
      "text": "「我随时都在你身边哦…\n…求你了！和我一起寻找凭依体」"
    },
    {
      "name": "CHA_ST23EVENT3_MIY_1",
      "src": "「私の目を使って 依り代を探すの」",
      "text": "「用我的眼睛，去寻找凭依体」"
    },
    {
      "name": "CHA_ST23EVENT3_MIY_2",
      "src": "「依り代を探して！ 私の目で……お願い！」",
      "text": "「去寻找凭依体！用我的眼睛……求你了！」"
    },
    {
      "name": "CHA_ST23EVENT3_MIY_3",
      "src": "「私には見える……依り代がこのどこかに……」",
      "text": "「我能看见……凭依体就在这里的某处……」"
    },
    {
      "name": "CHA_ST23EVENT4_MIY_0",
      "src": "「石碑へと炎を放って！」",
      "text": "「朝石碑放出火焰！」"
    },
    {
      "name": "CHA_ST23EVENT4_MIY_1",
      "src": "「依り代に炎を放って！」",
      "text": "「朝凭依体放出火焰！」"
    },
    {
      "name": "CHA_ST23EVENT4_MIY_2",
      "src": "「その炎で封印を解くの！」",
      "text": "「用那火焰解开封印！」"
    },
    {
      "name": "CHA_ST23EVENT5_MIY_0",
      "src": "「騙されないで！ 本物は一つ！」",
      "text": "「别被迷惑！真的只有一个！」"
    },
    {
      "name": "CHA_ST23EVENT5_MIY_1",
      "src": "「私には見える……あいつの本当の姿が……」",
      "text": "「我能看见……那家伙真正的样子……」"
    },
    {
      "name": "CHA_ST23EVENT5_MIY_2",
      "src": "「私の目で見て！ あいつの正体を見破って！」",
      "text": "「用我的眼睛看！看穿那家伙的真身！」"
    },
    {
      "name": "CHA_ST23EVENT6_MIY_0",
      "src": "「騙されないで！ それは偽物！」",
      "text": "「别被迷惑！那是冒牌货！」"
    },
    {
      "name": "CHA_ST23EVENT6_MIY_1",
      "src": "「幻影に騙されないで！」",
      "text": "「别被幻影迷惑！」"
    },
    {
      "name": "CHA_ST23EVENT6_MIY_2",
      "src": "「違う！ それは実体じやない！」",
      "text": "「不对！那没有实体！」"
    },
    {
      "name": "CHA_ST23EVENT7_MIY_0",
      "src": "「それよ！」",
      "text": "就是那个"
    },
    {
      "name": "CHA_ST23EVENT7_MIY_1",
      "src": "「近くにいる！」",
      "text": "「就在附近！」"
    },
    {
      "name": "CHA_ST23EVENT7_MIY_2",
      "src": "「こいつよ！」",
      "text": "「就是这个！」"
    },
    {
      "name": "CHA_ST23EVENT8_MIY_0",
      "src": "「今よ！」",
      "text": "就现在"
    },
    {
      "name": "CHA_ST23EVENT8_MIY_1",
      "src": "「消し去って！」",
      "text": "「抹消掉它！」"
    },
    {
      "name": "CHA_ST23EVENT8_MIY_2",
      "src": "「炎を放って！ 焼き払って！」",
      "text": "「放出火焰！烧尽它！」"
    },
    {
      "name": "CHA_ST23EVENT9_MIY_0",
      "src": "「今よ！ 炎を薙き払うの！」",
      "text": "「就是现在！用火焰烧尽它！」"
    },
    {
      "name": "CHA_ST23EVENT9_MIY_1",
      "src": "「あいつが害しんでる 早く炎を薙き払って！」",
      "text": "「那家伙在痛苦挣扎，快点用火焰烧尽它！」"
    },
    {
      "name": "CHA_ST23EVENT9_MIY_2",
      "src": "「炎を薙き払って！ お願い！」",
      "text": "「用火焰烧尽它！求你了！」"
    },
    {
