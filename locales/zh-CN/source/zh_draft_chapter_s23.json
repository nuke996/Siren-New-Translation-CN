    {
      "name": "S99_AREA_OVER1",
      "src": "戻る訳にはいかない。",
      "text": "不能回头。"
    },
    {
      "name": "S99_AREA_OVER10",
      "src": "サムを置いていく訳にはいかない……。",
      "text": "不能丢下山姆……"
    },
    {
      "name": "S99_AREA_OVER11",
      "src": "この先には用がない……。",
