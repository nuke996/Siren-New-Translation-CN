    {
      "name": "EP12_CP4_1_01",
      "src": "「あんた！？」",
      "text": "「是你！？」"
    },
    {
      "name": "EP12_CP4_1_02",
      "src": "「お前の役目だよ」",
      "text": "「这是你的职责」"
    },
    {
      "name": "EP12_CP4_1_03",
      "src": "「俺には少しばかり荷が重い」",
      "text": "「对我来说有点太沉重了」"
    },
    {
      "name": "EP12_CP4_2_01",
      "src": "「俺はダンテではない◇ベアトリーチエの導きは期待出来ない」",
      "text": "「我不是但丁\n无法期待贝阿特丽切的指引」"
    },
    {
      "name": "EP12_CP4_3_01",
      "src": "「私の血 私の命を使って力を解き放って」",
      "text": "「用我的血、我的命，释放力量吧」"
    },
    {
      "name": "EP12_CP4_3_02",
      "src": "「ミヤコ？」",
      "text": "「美耶古？」"
    },
    {
      "name": "EP12_CP4_4_01",
      "src": "「そう これで良い これで俺は退場だ」",
      "text": "「对，这样就好，这样我就该退场了」"
    },
    {
      "name": "EP12_CP4_4_02",
      "src": "「……幸江」",
      "text": "「……幸江」"
    },
    {
      "name": "EP12_CP4_4_03",
      "src": "「本当に実を盗んだのはあなたの方だったとはね」",
      "text": "「真正偷走果实的人竟然是你啊」"
    },
    {
      "name": "EP12_CP4_4_04",
      "src": "「神よ 盗まれし実の贖いとしてこの身を捧げます」",
      "text": "「神啊，作为被盗走之果实的赎罪，我献上此身」"
    },
    {
      "name": "EP12_CP4_6_01",
      "src": "「解き放たれた力が新しい依り代に宿った」",
      "text": "「被释放的力量寄宿到了新的凭依体上」"
    },
    {
      "name": "EP12_CP4_6_02",
      "src": "「炎を放ち その炎を薙き払って」",
      "text": "「放出火焰，将那火焰烧尽」"
    },
