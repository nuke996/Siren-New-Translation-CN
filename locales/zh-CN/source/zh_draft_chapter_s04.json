    {
      "name": "CHA_AFTERDRAT_CAS_0",
      "src": "「やっと会えたね！」",
      "text": "「终于见到你了！」"
    },
    {
      "name": "CHA_AFTERDRAT_CAS_1",
      "src": "「ベイビーちやん 手間かけさぜないでおくれよ」",
      "text": "「小宝贝，别让我费事啊」"
    },
    {
      "name": "CHA_AFTERDRAT_CAS_2",
      "src": "「惜しかったな！」",
      "text": "「真可惜啊！」"
    },
    {
      "name": "CHA_BATTLE_CAS_0",
      "src": "「ベラ！ ベラ～！ ベラ～！」",
      "text": "「贝拉！贝拉～！贝拉～！」"
    },
    {
      "name": "CHA_BATTLE_CAS_1",
      "src": "「もう逃がさないそお～」",
      "text": "「不会再让你逃了哦～」"
    },
    {
      "name": "CHA_CAUTION1_CAS_1",
      "src": "「聞こえるよ～！」",
      "text": "「我听得见哦～！」"
    },
    {
      "name": "CHA_CAUTION1_CAS_2",
      "src": "「わかったそ！ そこにいるんだね！」",
      "text": "「我知道了！你就在那儿吧！」"
    },
    {
      "name": "CHA_CAUTION1_SK1_0",
      "src": "「誰かいるの？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SK1_1",
      "src": "「いるんでしよ？」",
      "text": "「有人在吧？」"
    },
    {
      "name": "CHA_CAUTION1_SK1_2",
      "src": "「誰？ そこにいるの？」",
      "text": "「谁？在那儿吗？」"
    },
    {
      "name": "CHA_CAUTION1_SK2_0",
      "src": "「そこにいるの誰？」",
      "text": "「在那儿的，是谁？」"
    },
    {
      "name": "CHA_CAUTION1_SK2_1",
      "src": "「誰ですかあ？ 出てきなさいよお！」",
      "text": "「是谁呀？出来呀！」"
    },
    {
      "name": "CHA_CAUTION1_SK2_2",
      "src": "「いるのは分かってるわよお～」",
      "text": "「我知道你在哦～」"
    },
    {
      "name": "CHA_CAUTION1_SM3_1",
      "src": "「何だってえ？」",
      "text": "「你说什么？」"
    },
    {
      "name": "CHA_CAUTION1_SM3_2",
      "src": "「誰じやあ！ 出て来い！」",
      "text": "「是谁！出来！」"
    },
    {
      "name": "CHA_CAUTION2_CAS_0",
      "src": "「お～い 逃げないでくれよ」",
      "text": "「喂～别逃啊」"
    },
    {
      "name": "CHA_CAUTION2_CAS_1",
      "src": "「冗談きついせ……」",
      "text": "「玩笑开过头了……」"
    },
    {
      "name": "CHA_CAUTION2_CAS_2",
      "src": "「出ておいで～子猫ちやん～」",
      "text": "「出来吧～小猫咪～」"
    },
    {
      "name": "CHA_CAUTION2_SK1_0",
      "src": "「どこ……いっちやったの？」",
      "text": "「跑哪……去了？」"
    },
    {
      "name": "CHA_CAUTION2_SK1_1",
      "src": "「出てきなさいよ！」",
      "text": "「给我出来！」"
    },
    {
      "name": "CHA_CAUTION2_SK1_2",
      "src": "「馬鹿にしないで！」",
      "text": "「别小看我！」"
    },
    {
      "name": "CHA_CAUTION2_SK2_0",
      "src": "「こらっ！ どこに行った！」",
      "text": "「喂！跑哪去了！」"
    },
    {
      "name": "CHA_CAUTION2_SK2_1",
      "src": "「絶対見つけてやる！」",
      "text": "「我一定会找到你！」"
    },
    {
      "name": "CHA_CAUTION2_SK2_2",
      "src": "「遊びじやないのよ！」",
      "text": "「这可不是在玩！」"
    },
    {
      "name": "CHA_CAUTION2_SM3_0",
      "src": "「年寄りだと思って馬鹿にしおって！」",
      "text": "「竟敢把我当老人耍！」"
    },
    {
      "name": "CHA_CAUTION2_SM3_1",
      "src": "「どこじや！ 馬鹿もん！」",
      "text": "「在哪！混账！」"
    },
    {
      "name": "CHA_CAUTION2_SM3_2",
      "src": "「次は見逃してやらんからな！」",
      "text": "「下次可不会放过你！」"
    },
    {
      "name": "CHA_DIE_MUS",
      "src": "「いやあ一一！」",
      "text": "「不要——！」"
    },
    {
      "name": "CHA_PATROL_CAS_0",
      "src": "「ベラ……もう大丈夫だよ」",
      "text": "「贝拉……已经没事了」"
    },
    {
      "name": "CHA_PATROL_CAS_1",
      "src": "「信じてくれよ……ボクが守ってあげるよ」",
      "text": "「相信我吧……我会保护你的」"
    },
    {
      "name": "CHA_PATROL_CAS_2",
      "src": "「ベラ ボク メリッサ 幸ぜな家族になろうせ」",
      "text": "「贝拉，我，还有梅丽莎，组成幸福的家庭吧」"
    },
    {
      "name": "CHA_PATROL_CAS_4",
      "src": "「眺ずかしがらないで出ておいで……」",
      "text": "「别害羞，出来吧……」"
    },
    {
      "name": "CHA_ST04EVENT1_CAS_0",
      "src": "「良かった！ 無事だったんだね！」",
      "text": "「太好了！你没事！」"
    },
    {
      "name": "CHA_ST04EVENT1_CAS_1",
      "src": "「ベラ……ここを開けてくれよお！」",
      "text": "「贝拉……把这里打开啊！」"
    },
    {
      "name": "CHA_ST04EVENT1_CAS_2",
      "src": "「なあ……開けておくれよ……開けろっってば！」",
      "text": "「喂……开开门啊……我叫你打开！」"
    },
    {
      "name": "CHA_ST04EVENT2_CAS_0",
      "src": "「いたっ！」",
      "text": "「好痛！」"
    },
    {
      "name": "CHA_ST04EVENT2_CAS_1",
      "src": "「ベラ～！」",
      "text": "「贝拉～！」"
    },
    {
      "name": "CHA_ST04EVENT2_CAS_2",
      "src": "「ここにいたのかい お姪さま……」",
      "text": "「原来你在这儿啊，小侄女……」"
    },
    {
      "name": "CHA_ST04EVENT2_SK1_0",
      "src": "「いやあねえ……何の音？」",
      "text": "「真讨厌……什么声音？」"
    },
    {
      "name": "CHA_ST04EVENT2_SK2_0",
      "src": "「誰え？ 勝手にスイッチ入れたのは……」",
      "text": "「谁呀？擅自打开开关的是……」"
    },
    {
      "name": "CHA_ST04EVENT3_SK1_0",
      "src": "「開けてえ……お願い……早く……」",
      "text": "「开开门……求你了……快点……」"
    },
    {
      "name": "CHA_ST04EVENT3_SK1_1",
      "src": "「はあ……どうしよう……お手洗い行きたい……」",
      "text": "「唉……怎么办……我想上厕所……」"
    },
    {
      "name": "CHA_ST04EVENT3_SK2_0",
      "src": "「どうしましたかあ？」",
      "text": "「怎么了？」"
    },
    {
      "name": "CHA_ST04EVENT3_SK2_1",
      "src": "「何ですかあ？ 何も無いなら戻りますよお？」",
      "text": "「什么事啊？没事的话我要回去了哦？」"
    },
    {
      "name": "CHA_ST04EVENT4_SK2_0",
      "src": "「開けなさい！ 早く開けなさいってば！」",
      "text": "「打开！我叫你快点打开！」"
    },
    {
      "name": "CHA_ST04EVENT4_SK2_1",
      "src": "「誰かあ～！ 誰かあ開けてえ～！ 誰かあ～！」",
      "text": "「有人吗～！谁来开开门啊～！有人吗～！」"
    },
    {
      "name": "CHA_ST99EVENT1_CAS_0",
      "src": "「はいチ～ズ～」",
      "text": "来，说茄子～"
    },
    {
      "name": "CHA_ST99EVENT1_CAS_1",
      "src": "「笑っておくれよお～」",
      "text": "「笑一个嘛～」"
    },
    {
      "name": "CHA_STARTST19_MUS_0",
