    {
      "name": "S99_AREA_OVER1",
      "src": "戻る訳にはいかない。",
      "text": "不能回头。"
    },
    {
      "name": "S99_AREA_OVER10",
      "src": "サムを置いていく訳にはいかない……。",
      "text": "不能丢下山姆……"
    },
    {
      "name": "S99_AREA_OVER11",
      "src": "この先には用がない……。",
      "text": "前方没有要办的事……"
    },
    {
      "name": "S99_AREA_OVER2",
      "src": "この先は危険だ……。",
      "text": "前方危险……"
    },
    {
      "name": "S99_AREA_OVER3",
      "src": "目的を果たさなければならない。",
      "text": "必须完成目的。"
    },
    {
      "name": "S99_AREA_OVER4",
      "src": "美耶古を置いていく訳にはいかない……。",
