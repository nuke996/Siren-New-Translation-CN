    {
      "name": "S12_MESSAGE002",
      "src": "「うらない」と書かれた缶詰が放置されている。缶切りがないので開けられない。",
      "text": "写着「占卜」的罐头被放在那里。\n因为没有开罐器，打不开。"
    },
    {
      "name": "S12_MESSAGE004",
      "src": "占いの結果が入っている。",
      "text": "里面装着占卜的结果。"
    },
    {
      "name": "S12_MESSAGE005",
      "src": "錆びた南京錠だ。衝撃を与えれば壊ぜそうだ。",
      "text": "生锈的挂锁。\n似乎只要弄坏锁就能打开。"
    },
    {
      "name": "S99_AREA_OVER1",
      "src": "戻る訳にはいかない。",
      "text": "不能回头。"
    },
    {
      "name": "S99_AREA_OVER10",
      "src": "サムを置いていく訳にはいかない……。",
      "text": "不能丢下山姆……。"
    },
    {
      "name": "S99_AREA_OVER11",
      "src": "この先には用がない……。",
      "text": "前方没有事情要办……。"
    },
    {
      "name": "S99_AREA_OVER2",
      "src": "この先は危険だ……。",
      "text": "前面很危险……。"
    },
    {
      "name": "S99_AREA_OVER3",
      "src": "目的を果たさなければならない。",
      "text": "必须达成目的。"
    },
    {
      "name": "S99_AREA_OVER4",
      "src": "美耶古を置いていく訳にはいかない……。",
      "text": "不能丢下美耶古……。"
    },
    {
      "name": "S99_AREA_OVER5",
      "src": "メリッサを置いていく訳にはいかない……。",
      "text": "不能丢下梅丽莎……。"
    },
    {
      "name": "S99_AREA_OVER6",
      "src": "アマナを置いていく訳にはいかない……。",
      "text": "不能丢下阿玛娜……。"
    },
    {
      "name": "S99_AREA_OVER7",
      "src": "ベラを置いていく訳にはいかない……。",
      "text": "不能丢下贝拉……。"
    },
    {
      "name": "S99_AREA_OVER8",
      "src": "ベラを探さなければ……。",
      "text": "必须去找贝拉……。"
    },
    {
      "name": "S99_AREA_OVER9",
      "src": "技が折れている。ここからは戻れそうにない。",
      "text": "树枝断了。从这里似乎回不去了。"
    },
    {
      "name": "S99_BUSY",
      "src": "今はそれどころではない。",
      "text": "现在不是做这个的时候。"
    },
    {
      "name": "S99_MESSAGE001",
      "src": "扉は固く閉じられている。中からは物音も聞こえない。",
      "text": "门紧闭着。\n里面也听不到任何声响。"
    },
