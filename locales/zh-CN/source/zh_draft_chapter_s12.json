    {
      "name": "CHA_BATTLE_GKK_0",
      "src": "「娘ハドコダ……？」",
      "text": "「女儿在哪儿……？」"
    },
    {
      "name": "CHA_BATTLE_GKK_1",
      "src": "「楽シイナア！」",
      "text": "「好开心啊！」"
    },
    {
      "name": "CHA_CAUTION1_GKK_0",
      "src": "「ドコダイ？」",
      "text": "「在哪儿？」"
    },
    {
      "name": "CHA_CAUTION1_GKK_1",
      "src": "「ベラ……オ前カイ？」",
      "text": "「贝拉……是你吗？」"
    },
    {
      "name": "CHA_CAUTION1_GKK_2",
      "src": "「返事シテクレヨ……」",
      "text": "「回个话啊……」"
    },
    {
      "name": "CHA_CAUTION1_KAF_0",
      "src": "「ナア～ニィ～？」",
      "text": "「哪～儿～？」"
    },
    {
      "name": "CHA_CAUTION1_KAF_1",
      "src": "「誰カシラア？」",
      "text": "「是谁呀～？」"
    },
    {
      "name": "CHA_CAUTION1_KAF_2",
      "src": "「ニオイ ガ スルワネエ～」",
      "text": "「有东西在动呢～」"
    },
    {
      "name": "CHA_CAUTION1_KMF_0",
      "src": "「ソコニイルノオ？」",
      "text": "「那边有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_KMF_1",
      "src": "「ドコニイルノオ？」",
      "text": "「哪里有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_KMF_2",
      "src": "「誰カシラア？」",
      "text": "「是谁呀？」"
    },
    {
      "name": "CHA_CAUTION1_KMM_0",
      "src": "「誰ダア？」",
      "text": "「是谁啊？」"
    },
    {
      "name": "CHA_CAUTION1_KMM_1",
      "src": "「ドコニイルウ？」",
      "text": "「在哪儿？」"
    },
    {
      "name": "CHA_CAUTION1_KMM_2",
      "src": "「今行クジオ！」",
      "text": "「这就过去！」"
    },
    {
      "name": "CHA_CAUTION2_GKK_0",
      "src": "「スバシッコイナ」",
      "text": "「真机灵啊」"
    },
    {
      "name": "CHA_CAUTION2_GKK_1",
      "src": "「ヤレヤレ……」",
      "text": "「真是的……」"
    },
    {
      "name": "CHA_CAUTION2_GKK_2",
      "src": "「マタ カクレンボ カイ？」",
      "text": "「又要玩捉迷藏吗？」"
    },
    {
      "name": "CHA_CAUTION2_KAF_0",
      "src": "「ネエ……ドコナノオ？」",
      "text": "「喂……哪里有人吗？」"
    },
    {
      "name": "CHA_CAUTION2_KAF_1",
      "src": "「帰ッテ来テヨオ～」",
      "text": "「快回来啊～」"
    },
    {
      "name": "CHA_CAUTION2_KAF_2",
      "src": "「淋シイワア～」",
      "text": "「好寂寞啊～」"
    },
    {
      "name": "CHA_CAUTION2_KMF_0",
      "src": "「ドコニ行ッタノヨオ！」",
      "text": "「人去哪儿了！」"
    },
    {
      "name": "CHA_CAUTION2_KMF_1",
      "src": "「ドコ隠レタノヨオ！」",
      "text": "「藏哪儿了！」"
    },
    {
      "name": "CHA_CAUTION2_KMF_2",
      "src": "「戻ッテキナサイヨオ！」",
      "text": "「快回来！」"
    },
    {
      "name": "CHA_CAUTION2_KMM_0",
      "src": "「ドコダッ！ ドコダッ」",
      "text": "「在哪儿！在哪儿！」"
    },
    {
      "name": "CHA_CAUTION2_KMM_1",
      "src": "「出テ来イ！ 出テ来イ！」",
      "text": "「出来！出来！」"
    },
    {
      "name": "CHA_CAUTION2_KMM_2",
      "src": "「隠レテモ無駄ダジオ！」",
      "text": "「躲着也没用哦！」"
    },
    {
      "name": "CHA_FINISH_SHU_0",
      "src": "「くたばれ！」",
      "text": "「去死吧！」"
    },
    {
      "name": "CHA_FINISH_SHU_1",
      "src": "「二度と起き上がるなよ」",
      "text": "「别再爬起来了。」"
    },
    {
      "name": "CHA_FINISH_SHU_2",
      "src": "「どうだっ！？」",
      "text": "「怎么样！？」"
    },
    {
      "name": "CHA_FINISH_SHU_3",
      "src": "「くそったれ！」",
      "text": "「混蛋！」"
    },
    {
      "name": "CHA_FINISH_SHU_4",
      "src": "「そのまま消えてくれ……」",
      "text": "「就那样消失吧……」"
    },
    {
      "name": "CHA_PATROL_GKK_0",
      "src": "「ベラ……メリッサ……」",
      "text": "「贝拉……梅丽莎……」"
    },
    {
      "name": "CHA_PATROL_GKK_1",
      "src": "「ダディガ助ケニキタヨ」",
      "text": "「爸爸来救你们了。」"
    },
    {
      "name": "CHA_PATROL_GKK_2",
      "src": "「シャレニナラン」",
      "text": "这可不是闹着玩"
    },
    {
      "name": "CHA_PATROL_GKK_3",
      "src": "「全テノ力ガ……ココニ」",
      "text": "「所有人都在……这里」"
    },
    {
      "name": "CHA_PATROL_GKK_4",
      "src": "「素晴ラシイ世界ダ」",
      "text": "真是美好的世界啊"
    },
    {
      "name": "CHA_SCREAM_SHU_0",
      "src": "「お おい！」",
      "text": "「喂、喂！」"
    },
    {
      "name": "CHA_SCREAM_SHU_1",
      "src": "「おい！ しっかりしてくれ！」",
      "text": "「喂！振作点！」"
    },
    {
      "name": "CHA_SCREAM_SHU_2",
      "src": "「ちくしよう！ 何で……！？」",
      "text": "「可恶！为什么……！？」"
    },
    {
      "name": "CHA_SCREAM_SHU_3",
      "src": "「ミヤコ！」",
      "text": "「美耶古！」"
    },
    {
      "name": "CHA_SPEAK_MSB_0",
      "src": "「お願い……誰か来てよ……」",
      "text": "「求你了……谁来啊……」"
    },
    {
      "name": "CHA_SPEAK_MSB_1",
      "src": "「ダディ……マミィ……」",
      "text": "「爸爸……妈妈……」"
    },
    {
      "name": "CHA_STARTST12_SHU_0",
      "src": "「さっきのは……何なんだ？」",
      "text": "「刚才那是……什么？」"
    },
    {
      "name": "CHA_STARTST12_SHU_1",
      "src": "「俺は……生きているのか……？」",
      "text": "「我……还活着吗……？」"
    },
    {
      "name": "CHA_STARTST12_SHU_2",
      "src": "「ミヤコ……」",
      "text": "「美耶古……」"
    },
