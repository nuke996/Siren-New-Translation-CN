    {
      "name": "CHA_AFTERDRAT_DOS_0",
      "src": "「非力だな」",
      "text": "没力气了。"
    },
    {
      "name": "CHA_AFTERDRAT_DOS_1",
      "src": "「総わりだ」",
      "text": "「结束了。」"
    },
    {
      "name": "CHA_AFTERDRAT_DOS_2",
      "src": "「甘い」",
      "text": "太嫩了。"
    },
    {
      "name": "CHA_BATTLE_DOS_0",
      "src": "「ふん 隙だらけだそ」",
      "text": "「哼，破绽百出。」"
    },
    {
      "name": "CHA_BATTLE_DOS_1",
      "src": "「ふん 幸運も総わりだ」",
      "text": "哼，你好运到头了。"
    },
    {
      "name": "CHA_CAUTION1_BR8_1",
      "src": "「何ダッテエ？」",
      "text": "「你说什么？」"
    },
    {
      "name": "CHA_CAUTION1_BR8_2",
      "src": "「誰ジャア！ 出テ来イ！」",
      "text": "「是谁啊！出来！」"
    },
    {
      "name": "CHA_CAUTION1_CHH_0",
      "src": "「ンア？ 誰ダッ？」",
      "text": "「嗯啊？是谁？」"
    },
    {
      "name": "CHA_CAUTION1_CHH_1",
      "src": "「キンキュー！ 累急事熊発生！」",
      "text": "「紧急事态发生！」"
    },
    {
      "name": "CHA_CAUTION1_CHH_2",
      "src": "「怪シィジオ……」",
      "text": "「好可疑哦……」"
    },
    {
      "name": "CHA_CAUTION1_DOS_0",
      "src": "「そこか？」",
      "text": "在吗？"
    },
    {
      "name": "CHA_CAUTION1_DOS_1",
      "src": "「いるな？」",
      "text": "「在吧？」"
    },
    {
      "name": "CHA_CAUTION1_DOS_2",
      "src": "「時間の無駄だ」",
      "text": "「浪费时间。」"
    },
    {
      "name": "CHA_CAUTION1_HNM_1",
      "src": "「怪シィジオオ？」",
      "text": "「有点可疑啊？」"
    },
    {
      "name": "CHA_CAUTION1_HNM_2",
      "src": "「誰ダ？ 誰ダア！」",
      "text": "「是谁？是谁啊！」"
    },
    {
      "name": "CHA_CAUTION1_SM2_0",
      "src": "「ん～？ 誰だあ～？」",
      "text": "「嗯～？是谁啊～？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_1",
      "src": "「おい……誰かいるのかあ？」",
      "text": "「喂……有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_2",
      "src": "「何だあ？ おい？」",
      "text": "「什么啊？喂？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_1",
      "src": "「そこかあ～？」",
      "text": "「在那儿吗～？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_2",
      "src": "「ああ？ 誰だあ？」",
      "text": "「啊啊？是谁啊？」"
    },
    {
      "name": "CHA_CAUTION2_BR8_0",
      "src": "「年寄リダト思ッテ馬鹿ニシオッテエ！」",
      "text": "「竟敢把我当傻子耍！」"
    },
    {
      "name": "CHA_CAUTION2_BR8_1",
      "src": "「ドコジャ！ 馬鹿モン！」",
      "text": "「在哪儿！蠢货！」"
    },
    {
      "name": "CHA_CAUTION2_BR8_2",
      "src": "「次ハ見逃シテヤランカラナア！」",
      "text": "「下次可不会放过你！」"
    },
    {
      "name": "CHA_CAUTION2_CHH_0",
      "src": "「Ｙｏｕ！ 戻レ！ 戻レエ！」",
      "text": "「You！回来！回来啊！」"
    },
    {
      "name": "CHA_CAUTION2_CHH_1",
      "src": "「Ｙｏｕ！ ドコ行ッタア！」",
      "text": "「You！你去哪儿了！」"
    },
    {
      "name": "CHA_CAUTION2_CHH_2",
      "src": "「プリーズ！ 出て来いコラ！」",
      "text": "「Please！出来，喂！」"
    },
    {
      "name": "CHA_CAUTION2_DOS_0",
      "src": "「しぶとい鼠だ……」",
      "text": "「真顽固的老鼠……」"
    },
    {
      "name": "CHA_CAUTION2_DOS_1",
      "src": "「もう縮めろ」",
      "text": "「快放弃吧。」"
    },
    {
      "name": "CHA_CAUTION2_DOS_2",
      "src": "「馬鹿な奴だ」",
      "text": "愚蠢的家伙"
    },
    {
      "name": "CHA_CAUTION2_HNM_0",
      "src": "「イナイ！ イナイジオ！」",
      "text": "「没有！没有哦！」"
    },
    {
      "name": "CHA_CAUTION2_HNM_1",
      "src": "「オイ！ ドコダア！」",
      "text": "「喂！在哪儿！」"
    },
    {
      "name": "CHA_CAUTION2_HNM_2",
      "src": "「戻レ！ 卑怯ダジオ！」",
      "text": "「回来！卑怯的达里奥！」"
    },
    {
      "name": "CHA_CAUTION2_SM2_0",
      "src": "「戻って……来いよお」",
      "text": "「回来……啊。」"
    },
    {
      "name": "CHA_CAUTION2_SM2_1",
      "src": "「どこ……行ったあ？」",
      "text": "「去哪儿……了？」"
    },
    {
      "name": "CHA_CAUTION2_SM2_2",
      "src": "「無駄だよお」",
      "text": "「没用的哦。」"
    },
    {
      "name": "CHA_CAUTION2_SM4_0",
      "src": "「こらあ！ 出て来いい！」",
      "text": "「喂！快出来！」"
    },
    {
      "name": "CHA_CAUTION2_SM4_1",
      "src": "「どこ行ったあ……」",
      "text": "「跑哪儿去了……」"
    },
    {
      "name": "CHA_CAUTION2_SM4_2",
      "src": "「くそお……逃げ足の早い……」",
      "text": "「可恶……跑得真快……」"
    },
    {
      "name": "CHA_FINISH_SHU_0",
      "src": "「くたばれ！」",
      "text": "「去死吧！」"
    },
    {
      "name": "CHA_FINISH_SHU_1",
      "src": "「二度と起き上がるなよ」",
      "text": "「别再爬起来了。」"
    },
    {
      "name": "CHA_FINISH_SHU_2",
      "src": "「どうだっ！？」",
      "text": "「怎么样！？」"
    },
    {
      "name": "CHA_FINISH_SHU_3",
      "src": "「くそったれ！」",
      "text": "「混蛋！」"
    },
    {
      "name": "CHA_FINISH_SHU_4",
      "src": "「そのまま消えてくれ……」",
      "text": "「就那样消失吧……」"
    },
    {
      "name": "CHA_PATROL_DOS_0",
      "src": "「この村は 総わりだ」",
      "text": "「这个村子完了。」"
    },
    {
      "name": "CHA_PATROL_DOS_1",
      "src": "「もう縮めろ 無駄だ 流れに身を任ぜろ」",
      "text": "「快放弃吧，没用的，顺从潮流吧。」"
    },
    {
      "name": "CHA_PATROL_DOS_2",
      "src": "「全てが永遠に……」",
      "text": "「一切归于永恒……」"
    },
    {
      "name": "CHA_SCREAM_SHU_0",
      "src": "「お おい！」",
      "text": "「喂、喂！」"
    },
    {
      "name": "CHA_SCREAM_SHU_1",
      "src": "「おい！ しっかりしてくれ！」",
      "text": "「喂！振作点！」"
    },
    {
      "name": "CHA_SCREAM_SHU_2",
      "src": "「ちくしよう！ 何で……！？」",
      "text": "「可恶！为什么……！？」"
    },
    {
      "name": "CHA_SCREAM_SHU_3",
      "src": "「ミヤコ！」",
      "text": "「美耶古！」"
    },
    {
      "name": "CHA_ST11EVENT2_CHH_0",
