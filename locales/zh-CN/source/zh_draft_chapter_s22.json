    {
      "name": "CHA_BATTLE_CMK_0",
      "src": "「早ク 仲間ニナッテクレヨ！」",
      "text": "「快点成为同伴吧！」"
    },
    {
      "name": "CHA_BATTLE_CMK_1",
      "src": "「シブトイネエ！」",
      "text": "「真顽固啊！」"
    },
    {
      "name": "CHA_BATTLE_RPK_0",
      "src": "「ベラ！ ベラ ラ返シテ！」",
      "text": "「贝拉！把贝拉还给我！」"
    },
    {
      "name": "CHA_BATTLE_RPK_1",
      "src": "「頭ラ潰シテアゲルッ！」",
      "text": "「我来把你的脑袋砸烂！」"
    },
    {
      "name": "CHA_CAUTION1_CMK_0",
      "src": "「ソコダア～！」",
      "text": "「在那边～！」"
    },
    {
      "name": "CHA_CAUTION1_CMK_1",
      "src": "「聞コエルジオ……」",
      "text": "「听得见哦……」"
    },
    {
      "name": "CHA_CAUTION1_CMK_2",
      "src": "「ソコニイルンダネエ～」",
      "text": "「你在那儿吧～」"
    },
    {
      "name": "CHA_CAUTION1_KMM_0",
      "src": "「誰ダア？」",
      "text": "「谁呀？」"
    },
    {
      "name": "CHA_CAUTION1_KMM_1",
      "src": "「ドコニイルウ？」",
      "text": "「在哪呢？」"
    },
    {
      "name": "CHA_CAUTION1_KMM_2",
      "src": "「今行クジオ！」",
      "text": "「现在过去哦！」"
    },
    {
      "name": "CHA_CAUTION1_RPK_0",
      "src": "「イタア～！」",
      "text": "「好痛～！」"
    },
    {
      "name": "CHA_CAUTION1_RPK_1",
      "src": "「ソコニイルノ誰～？」",
      "text": "「那边的人是谁～？」"
    },
    {
      "name": "CHA_CAUTION1_RPK_2",
      "src": "「ベラ？ ベラ ナノオ！？」",
      "text": "「贝拉？是贝拉吗！？」"
    },
    {
      "name": "CHA_CAUTION2_CMK_0",
      "src": "「逃ゲナイデクレヨ」",
      "text": "「别逃啊」"
    },
    {
      "name": "CHA_CAUTION2_CMK_1",
      "src": "「眺ズガシガリ屋サンダネ？」",
      "text": "「还挺害羞的呢？」"
    },
    {
      "name": "CHA_CAUTION2_CMK_2",
      "src": "「出テオイデ！」",
      "text": "「出来啊！」"
    },
    {
      "name": "CHA_CAUTION2_KMM_0",
      "src": "「ドコダッ！ ドコダッ」",
      "text": "「在哪！在哪」"
    },
    {
      "name": "CHA_CAUTION2_KMM_1",
      "src": "「出テ来イ！ 出テ来イ！」",
      "text": "「出来！出来！」"
    },
    {
      "name": "CHA_CAUTION2_KMM_2",
      "src": "「隠レテモ無駄ダジオ！」",
      "text": "「躲也没用哦！」"
    },
    {
      "name": "CHA_CAUTION2_RPK_0",
      "src": "「ドコニ隠レタノオ～？」",
      "text": "「你躲哪了～？」"
    },
    {
      "name": "CHA_CAUTION2_RPK_1",
      "src": "「チヨコマカ ウットオシィワネエ……」",
      "text": "「这么东躲西窜的，真是可惜呢……」"
    },
    {
      "name": "CHA_CAUTION2_RPK_2",
      "src": "「カクレンボ ハ オシマイヨオ！」",
      "text": "「捉迷藏到此结束哦！」"
    },
    {
      "name": "CHA_DEAD_RPK_0",
      "src": "「ベラ！」",
      "text": "「贝拉！」"
    },
    {
      "name": "CHA_DIE_MUS",
      "src": "「いやあ一一！」",
      "text": "「不要啊——！」"
    },
    {
      "name": "CHA_FINISH_GAK_0",
      "src": "「どうだ！？」",
      "text": "「怎么样！？」"
    },
    {
      "name": "CHA_FINISH_GAK_1",
      "src": "「悪く思うな……！」",
      "text": "「别怪我……！」"
    },
    {
      "name": "CHA_PATROL_CMK_0",
      "src": "「ベラ～！ メリッサ～！」",
      "text": "「贝拉～！梅丽莎～！」"
    },
    {
      "name": "CHA_PATROL_CMK_1",
      "src": "「ボク ダヨ……ソル ダヨ……」",
      "text": "「是我呀……是索尔呀……」"
    },
    {
      "name": "CHA_PATROL_CMK_2",
      "src": "「アイツサエイナケレバ……」",
      "text": "「要是那家伙不在就好了……」"
    },
    {
      "name": "CHA_PATROL_CMK_3",
      "src": "「良イ感ジダゼ」",
      "text": "「感觉不错哦」"
    },
    {
      "name": "CHA_PATROL_CMK_4",
      "src": "「イカシタトコダゼ……」",
      "text": "「真是个好地方啊……」"
    },
    {
      "name": "CHA_PATROL_RPK_0",
      "src": "「ドコニイルノオ～？」",
      "text": "「人在哪呢～？」"
    },
    {
      "name": "CHA_PATROL_RPK_1",
      "src": "「ベラ ラ ドコニ隠シタノ！？」",
      "text": "「你把贝拉藏哪了！？」"
    },
    {
      "name": "CHA_PATROL_RPK_2",
      "src": "「ベラ～！ ベラ～！」",
      "text": "「贝拉～！贝拉～！」"
    },
    {
      "name": "CHA_PATROL_RPK_3",
      "src": "「娘ラ返シテヨオ！」",
      "text": "「把女儿还给我！」"
    },
    {
      "name": "CHA_PATROL_RPK_4",
      "src": "「邪鬼シナイデヨオ！」",
      "text": "「别碍事啊！」"
    },
    {
      "name": "CHA_SCREAM_GAK_0",
      "src": "「おい！ 大丈夫か！？」",
      "text": "「喂！没事吧！？」"
    },
    {
      "name": "CHA_SCREAM_GAK_1",
      "src": "「立て！ 逃げるんだ！」",
      "text": "「站起来！快逃！」"
    },
    {
      "name": "CHA_SCREAM_GAK_2",
      "src": "「おい！ ふざけてる場合じやないそ！？」",
      "text": "「喂！这不是开玩笑的时候吧！？」"
    },
    {
      "name": "CHA_SCREAM_GAK_3",
      "src": "「ソル！」",
      "text": "「索尔！」"
    },
    {
      "name": "CHA_SCREAM_GAK_4",
      "src": "「メリッサ！」",
      "text": "「梅丽莎！」"
    },
    {
      "name": "CHA_ST22EVENT1_CMK_0",
      "src": "「マミィ ハ モウ ボクラノ ナカマダヨ……」",
      "text": "「妈妈和森他们，都是我们的同伴哦……」"
    },
    {
      "name": "CHA_ST22EVENT1_CMK_1",
      "src": "「メリッサ ガ マミィ……ボク ガ ダディ……」",
      "text": "「梅丽莎是妈妈……我就是爸爸……」"
    },
    {
      "name": "CHA_ST22EVENT1_CMK_2",
      "src": "「ボクノ娘ニ ナルンダ……」",
      "text": "「我要变成女儿了……」"
    },
    {
      "name": "CHA_ST22EVENT1_MUS_0",
      "src": "「たすけて！ ダディ！」",
      "text": "「救命！爸爸！」"
    },
    {
      "name": "CHA_ST22EVENT1_MUS_1",
      "src": "「マミィ……！」",
      "text": "「妈妈……！」"
    },
    {
      "name": "CHA_ST22EVENT1_MUS_2",
      "src": "「お化けにつかまっちやう……」",
      "text": "「会被怪物抓住的……」"
    },
    {
      "name": "CHA_ST22EVENT1_RPK_0",
      "src": "「邪鬼シナイデッ！」",
      "text": "「别碍事！」"
    },
    {
      "name": "CHA_ST22EVENT1_RPK_1",
      "src": "「ソコニイタア～！」",
      "text": "「你在这儿～！」"
    },
    {
      "name": "CHA_ST22EVENT1_RPK_2",
      "src": "「見ツケタワ！」",
      "text": "「找到你了！」"
    },
    {
      "name": "CHA_ST22EVENT2_MUS_0",
      "src": "「あっち行け！」",
      "text": "「走开！」"
    },
    {
      "name": "CHA_ST22EVENT2_MUS_1",
      "src": "「助けて！」",
      "text": "「救救我！」"
    },
    {
      "name": "CHA_ST22EVENT2_MUS_2",
      "src": "「ダディ！ 助けて一！」",
      "text": "「爸爸！救救我！」"
    },
    {
      "name": "CHA_ST22EVENT2_RPK_0",
      "src": "「見ナイデエ！」",
      "text": "「别看啊！」"
    },
    {
      "name": "CHA_STARTST22_GAK_0",
      "src": "「頼む 無事でいてくれ」",
      "text": "「希望大家都平安无事」"
    },
    {
      "name": "CHA_STARTST22_GAK_1",
      "src": "「ベラ……ああ……ベラ……」",
      "text": "「贝拉……啊啊……贝拉……」"
    },
    {
      "name": "CHA_STARTST22_GAK_2",
      "src": "「迷宮だな……ここは」",
      "text": "「这里……是座迷宫啊」"
    },
