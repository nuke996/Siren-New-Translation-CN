    },
    {
      "name": "CHA_SCREAM_DOC_0",
      "src": "「良い気はしないな」",
      "text": "「感觉不太好啊」"
    },
    {
      "name": "CHA_SCREAM_DOC_1",
      "src": "「運が無かったようだな」",
      "text": "「看来运气不好啊」"
    },
    {
      "name": "CHA_SCREAM_DOC_2",
      "src": "「ここまでか」",
      "text": "到此为止了吗"
    },
    {
      "name": "CHA_ST06EVENT1_CHU_0",
      "src": "「おっ？ 羽生蛇じやないか……いいねえ！」",
      "text": "「哦？这不是羽生蛇吗……不错啊！」"
    },
    {
      "name": "CHA_ST06EVENT2_CHU_0",
      "src": "「ご馳走になりますよ……頂きまあ～す」",
      "text": "「要承蒙款待了哦……我收下啦～」"
    },
    {
      "name": "CHA_ST06EVENT3_CHU_0",
      "src": "「ふう……腹いっぱい……」",
      "text": "「呼……吃得好饱……」"
    },
    {
      "name": "CHA_ST06EVENT3_GAK_0",
      "src": "「……こいつ信用出来るのか？」",
      "text": "「……这家伙能借用吗？」"
    },
    {
      "name": "CHA_ST06EVENT5_CHU_0",
      "src": "「ああ……飯でも食うかあ」",
      "text": "「啊啊……吃点什么吧」"
    },
    {
      "name": "CHA_ST06EVENT5_CHU_1",
      "src": "「腹が減っては戦は出来ん」",
      "text": "「肚子空了可打不了仗」"
    },
    {
      "name": "CHA_ST06EVENT5_CHU_2",
      "src": "「何か食い物……食い物……」",
      "text": "「有什么吃的……吃的……」"
    },
    {
      "name": "CHA_ST99EVENT2_GAK_0",
      "src": "「く 来るな！ あっち行け！」",
      "text": "「别、别过来！滚开！」"
    },
    {
      "name": "CHA_STARTST06_DOC_0",
      "src": "「奴ら どこから来た？」",
      "text": "「那些家伙从哪来的？」"
    },
    {
      "name": "CHA_STARTST06_DOC_1",
      "src": "「何者だ？ あいつは」",
      "text": "「他是什么人？」"
    },
    {
      "name": "CHA_STARTST06_DOC_2",
      "src": "「大人しくしておいてくれよ……」",
      "text": "「乖乖待着别动啊……」"
    },
    {
      "name": "CHA_WAITLONG_GAK_0",
      "src": "「どうすりやいいんだ……」",
      "text": "「该怎么办才好……」"
    },
    {
      "name": "CHA_WAITLONG_GAK_1",
      "src": "「何なんだこの村は……」",
      "text": "这村子到底怎么回事…"
    },
    {
      "name": "CHA_WAITNEAR_GAK_0",
      "src": "「おい？ 何してるんだ？」",
      "text": "「喂？你在干什么？」"
    },
    {
      "name": "CHA_WAITNEAR_GAK_1",
      "src": "「何とか言えよ？」",
      "text": "你倒是说话啊？"
    },
    {
      "name": "CHA_WAITNEAR_GAK_2",
      "src": "「おい！ ……って英語通じないんじやな……」",
      "text": "「喂！……不过英语你也听不懂啊……」"
    },
