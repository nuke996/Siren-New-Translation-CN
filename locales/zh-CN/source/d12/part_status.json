    "menu/jp/main_status/item_text/exp_i_b_01.dds": { "lines": ["霰弹。属于发射不足10发、被称为鹿弹的弹丸的类型。", "可装填于狩猎用散弹枪。"] },
    "menu/jp/main_status/item_text/exp_i_b_02.dds": { "lines": ["步枪弹。", "可装填于狩猎用狙击枪。"] },
    "menu/jp/main_status/item_text/exp_i_b_03.dds": { "lines": ["手枪弹。", "可装填于38口径短枪。"] },
    "menu/jp/main_status/item_text/exp_i_ev_01.dds": { "lines": ["在一楼储藏室捡到的损坏的钳子。", "这样下去派不上用场。"] },
    "menu/jp/main_status/item_text/exp_i_ev_02.dds": { "lines": ["在二楼空房间捡到的损坏的钳子。", "这样下去派不上用场。"] },
    "menu/jp/main_status/item_text/exp_i_ev_03.dds": { "lines": ["用于剪断金属线的工具。", "将两个损坏的钳子组合而成。"] },
    "menu/jp/main_status/item_text/exp_i_ev_04.dds": { "lines": ["座钟的发条钥匙。", "原本放在二楼儿童房的书桌上。"] },
    "menu/jp/main_status/item_text/exp_i_ev_05.dds": { "lines": ["在合石4号东坑捡到的保险丝。", "是开启矿山电梯电源所必需的。"] },
    "menu/jp/main_status/item_text/exp_i_ev_06.dds": { "lines": ["以高抗风性能著称的煤油打火机。", "是贝拉在抵达不入谷圣堂之前捡到的。"] },
    "menu/jp/main_status/item_text/exp_i_ev_07.dds": { "text": "空" },
    "menu/jp/main_status/item_text/exp_i_ev_08.dds": { "lines": ["阿玛娜的胸针。在波罗宿祈祷所的地下祭坛，尸人们曾将其供奉。", "取回的瞬间，脑海中浮现出神秘的影像……。"] },
    "menu/jp/main_status/item_text/exp_i_ev_09.dds": { "lines": ["在合石1号坑捡到的木桩。", "尖锐锋利。"] },
    "menu/jp/main_status/item_text/exp_i_ev_10.dds": { "lines": ["在排水泵室捡到的钉剪。", "矿山工人使用过的日用品。"] },
    "menu/jp/main_status/item_text/exp_i_ev_11.dds": { "text": "空" },
    "menu/jp/main_status/item_text/exp_i_ev_12.dds": { "text": "空" },
    "menu/jp/main_status/item_text/exp_i_ev_13.dds": { "lines": ["在仓库捡到的点火装置。", "在引爆炸药时需要。"] },
    "menu/jp/main_status/item_text/exp_i_ev_14.dds": { "lines": ["在儿童房得到的玩具。", "能轻松编织织物，昭和时期在女孩间大为流行。"] },
    "menu/jp/main_status/item_text/exp_i_ev_15.dds": { "lines": ["在储藏室捡到的捉虫游戏用具套装。", "可用附带的饵料招引昆虫。"] },
    "menu/jp/main_status/item_text/exp_i_ev_16.dds": { "lines": ["在院子里抓到的独角仙。", "是羽生蛇村特有物种，抓附力非常强。"] },
    "menu/jp/main_status/item_text/exp_i_ev_50.dds": { "text": "空" },
