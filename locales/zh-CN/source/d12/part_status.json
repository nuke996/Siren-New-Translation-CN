    "menu/jp/main_status/item_text/exp_i_key_01.dds": { "lines": ["被放置在地下焚烧炉上的钥匙。", "可以打开一楼前台入口的门。"] },
    "menu/jp/main_status/item_text/exp_i_key_02.dds": { "lines": ["尸人随身携带的钥匙。", "可以打开二楼寝室的房门。"] },
    "menu/jp/main_status/item_text/exp_i_key_03.dds": { "lines": ["在别屋捡到的钥匙。", "可以打开一楼储藏室的门。"] },
    "menu/jp/main_status/item_text/exp_i_key_04.dds": { "lines": ["在一楼诊室捡到的钥匙。", "可以打开通往屋顶的门。"] },
    "menu/jp/main_status/item_text/exp_i_key_05.dds": { "lines": ["掉落在合石2号东坑的钥匙。", "在鸣响警笛时需要。"] },
    "menu/jp/main_status/item_text/exp_i_key_06.dds": { "lines": ["曾装在大吟酿酒「南京锁」瓶中的钥匙。", "可以打开排水泵室的门。"] },
    "menu/jp/main_status/item_text/exp_i_key_07.dds": { "lines": ["掉落在一楼前台地板上的钥匙。", "可以打开地下电源室的门。"] },
    "menu/jp/main_status/item_text/exp_i_key_08.dds": { "lines": ["藏在壁橱里的头脑尸人掉落的钥匙。", "可以打开波罗宿祈祷所的大门。"] },
    "menu/jp/main_status/item_text/exp_i_key_09.dds": { "text": "空" },
    "menu/jp/main_status/item_text/exp_i_key_10.dds": { "text": "空" },
    "menu/jp/main_status/item_text/exp_i_l_99.dds": { "lines": ["在暗处作业时使用的手电筒。", "通过方向键的副指令可以点亮・熄灭。"] },
    "menu/jp/main_status/item_text/exp_i_sp_01.dds": { "lines": ["狩猎时使用的铁夹陷阱。", "脚被夹住后，一定时间内无法自由行动。"] },
    "menu/jp/main_status/item_text/exp_i_sp_02.dds": { "lines": ["以大量烟雾告知紧急情况、引起注意的器具。", "不仅能吸引注意，还能用烟雾笼罩来迷惑视线。"] },
    "menu/jp/main_status/item_text/exp_i_sp_03.dds": { "lines": ["犀贺在羽生蛇矿山最深处发现的神秘物体。", "据说部分文献中留有关于它的传承……。"] },
    "menu/jp/main_status/item_text/exp_i_sp_04.dds": { "lines": ["用于接收电视电波的天线。", "附近没有避雷针时，可能成为雷击事故的起因。"] },

