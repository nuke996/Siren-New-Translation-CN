    "menu/jp/main_status/weapon_text/exp_i_sp_01.dds": { "lines": ["狩猎时使用的铁夹陷阱。", "脚被夹住后，一定时间内无法自由行动。"] },
    "menu/jp/main_status/weapon_text/exp_i_sp_02.dds": { "lines": ["以大量烟雾告知紧急情况、引起注意的器具。", "不仅能吸引注意，还能用烟雾笼罩来迷惑视线。"] },
    "menu/jp/main_status/weapon_text/exp_i_sp_03.dds": { "lines": ["犀贺在羽生蛇矿山最深处发现的神秘物体。", "据说部分文献中留有关于它的传承……。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_bk_01.dds": { "lines": ["较大的玻璃瓶。用于保存・搬运日本酒、酱油、果汁等。", "因可装入一升＝1.8升液体而得名。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_bk_02.dds": { "lines": ["啤酒用玻璃瓶中，被称为大瓶的633毫升规格之物。", "偶尔也用于在烤肉前敲打使其变软等用途。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_bk_03.dds": { "lines": ["在医疗・护理现场使用的小便用玻璃容器。", "供难以去厕所的伤者或病人等使用。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_bk_04.dds": { "lines": ["在涂有荧光涂料并低压化的玻璃管内封入水银蒸气，", "是利用电弧放电产生紫外线的照明器具之一。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_bk_05.dds": { "lines": ["用于保存・搬运威士忌的玻璃瓶。", "与其他酒类的瓶子一样，为防止直射日光影响而使用了有色玻璃。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_bk_06.dds": { "text": "空" },
    "menu/jp/main_status/weapon_text/exp_i_w_gun.dds": { "lines": ["标准的38口径左轮手枪。", "装弹数6。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hc_01.dds": { "lines": ["在新月形金属刀刃上装上长柄之物。", "用于站着割草或修剪高处树枝等用途。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hc_02.dds": { "lines": ["犀贺持有的打刀。刻有「焰薙」的铭文。", "似乎是自古流传之物，但被精心保养着。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hc_03.dds": { "lines": ["林业使用的一种斧头。用于伐木。", "在用锯伐倒树木时，用于朝想倒下的方向刻出切口。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hc_04.dds": { "lines": ["刃幅宽、靠近柄的一侧收窄的斧头。也称「大斧」。", "用于从原木中切出木材等用途。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hc_05.dds": { "text": "空" },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_01.dds": { "lines": ["用于砸碎岩石或挖起砂石的工具。", "柄的前端装有尖端如鹤嘴般尖锐的金属。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_02.dds": { "lines": ["在土木、建筑等作业现场作为材料、临时构件使用的配管用圆管。", "为防腐蚀而镀了锌，但因镀层剥落而生了锈。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_03.dds": { "lines": ["在柄的前端装上勺形金属的工具。", "用于挖洞或舀起・搅拌土砂等用途。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_04.dds": { "lines": ["在木柄前端装上金属单片刀刃的农具。", "用于耕作田地。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_05.dds": { "lines": ["在木柄前端装上叉状刀刃的农具。", "适合耕作湿地、黏土层等沉重的土壤。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_06.dds": { "lines": ["用于拔钉等的棒状万能金属工具。", "因利用杠杆原理，即使很小的力也能获得很大的力量。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_07.dds": { "lines": ["铁制的大型锤子。", "用于工地的破坏作业或打桩等。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_08.dds": { "lines": ["索尔为采访羽生蛇村而特别定制的业务用摄像机。", "凭借新开发的3CCD系统可进行高画质录像。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_09.dds": { "lines": ["形状类似锤子的木制工具。用于为臼中的谷物脱壳等。", "在日本一般作为捣年糕的工具而为人所知。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_10.dds": { "lines": ["受伤时等使用的步行辅助器具。", "因其分叉的形状让人联想到松叶而得名。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_11.dds": { "lines": ["用于切断粗钢丝或坚硬钢琴线的工具。", "连普通钳子等无法对付的东西也能切断。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_hh_12.dds": { "lines": ["70年代大为流行的白色外观的6弦吉他。", "与喇叭裤、伦敦靴一同是当时年轻人憧憬的象征。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lc_01.dds": { "lines": ["用于割草或收割作物等作业的农具。", "木柄的前端装有新月形的金属刀刃。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lc_02.dds": { "lines": ["在木制短柄的前端装上宽而厚的金属刀刃之物。", "用于劈柴或木工作业等多用途。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lc_03.dds": { "lines": ["在刻有锯齿刀刃的金属板上装柄的木材切断用工具。", "日本锯通过拉时施力来切断。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lc_04.dds": { "lines": ["细长的斧头。", "主要用于在木材上开孔等用途。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lc_05.dds": { "lines": ["用于把擀开的荞麦面皮切开、做成面条状的菜刀。", "特征是前端不尖的方形，以及延伸到柄根部的长刀刃。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_01.dds": { "lines": ["用于转动螺栓和螺母的工具。", "长度被调整为能获得适当的紧固力。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_02.dds": { "lines": ["在柄的前端放射状装上爪状金属棒的园艺用具。", "用于耙集落叶等。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_03.dds": { "lines": ["前端弯曲的金属棒。", "用于拨动炉中的炭火或柴火、调节火势等。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_04.dds": { "lines": ["玻璃制、较重的烟灰缸。", "主要用于盛放香烟的烟灰和烟蒂。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_05.dds": { "lines": ["表示禁止停车的标识。", "金属板部分较软，但支柱部分相当沉重坚固。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_06.dds": { "lines": ["用于炒菜等的烹调器具。", "带柄的金属浅锅。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_07.dds": { "lines": ["ABS树脂制的竖笛。属于木管乐器。", "在日本的中、小学音乐课上使用。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_08.dds": { "lines": ["前端是两个环的竹制棒状器具。", "用于拍打被子表面、掸落灰尘。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_09.dds": { "lines": ["内部为双层构造的壶。", "在层间设置真空部分，并对内面作镜面处理以提高保温效果。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_10.dds": { "lines": ["头部为铁制、一面是锤、一面是拔钉器的欧美传来的工具。", "日本自古流传的两面呈锤状的小型锤被称为「玄翁」。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_11.dds": { "lines": ["截成适当长度、粗度的燃料用木。", "能源效率虽差，但易得的传统燃料。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_12.dds": { "text": "空" },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_13.dds": { "lines": ["在碗状容器上装柄之物。用于舀水等用途。", "前端的容器由木、金属、塑料等制成，总体较轻。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_14.dds": { "text": "空" },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_15.dds": { "text": "空" },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_16.dds": { "lines": ["羽生蛇村保龄球大赛的冠军奖杯。", "据说得到它的人会遭遇不幸，附有来历。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_17.dds": { "lines": ["雨具。即所谓的洋伞，在日本也被称为蝙蝠伞。", "在带柄的金属骨架上张布，举于头顶遮挡雨水。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lh_18.dds": { "text": "空" },
    "menu/jp/main_status/weapon_text/exp_i_w_lk_01.dds": { "lines": ["医疗现场使用的锋利小型刀。", "一般为一次性，但过去曾煮沸・研磨后重复使用。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lk_02.dds": { "lines": ["俗称万能菜刀、文化菜刀类型的菜刀。", "因用途广泛，在全国家庭中被普遍使用。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lk_03.dds": { "lines": ["装有白木柄、没有护手的短刀。也称匕首。", "据说语源是「威胁」，故有亡命之徒随身之物的强烈印象。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_lk_04.dds": { "lines": ["破碎的啤酒瓶。", "经常出现在老动作片的乱斗场景等中。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_sg_01.dds": { "lines": ["用于猎鹿等中型动物的水平双管散弹枪。", "装弹数2。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_sg_02.dds": { "lines": ["把狩猎用散弹枪的枪身与枪托截短、便于携带之物。", "装弹数2。"] },
    "menu/jp/main_status/weapon_text/exp_i_w_sg_03.dds": { "lines": ["狩猎用的杠杆式步枪。", "装弹数1。"] }
  }
}
