      "src": "「ちよっとお！ 早く出てきなさいよ！」",
      "text": "「喂！快点出来啊！」"
    },
    {
      "name": "CHA_ST05EVENT1_SF1_1",
      "src": "「鍵がかかってる！ 開けなさいよお！」",
      "text": "「锁上了！给我打开呀！」"
    },
    {
      "name": "CHA_ST05EVENT1_SF1_2",
      "src": "「この泥棒猫お！ 出て来い！」",
      "text": "「你这偷腥猫！出来！」"
    },
    {
      "name": "CHA_ST05EVENT1_SF2_0",
      "src": "「こらっ！ 出て来い！」",
      "text": "「喂！出来！」"
    },
    {
      "name": "CHA_ST05EVENT1_SF2_1",
      "src": "「鍵を開けろお！」",
      "text": "「把锁打开！」"
    },
    {
      "name": "CHA_ST05EVENT1_SF2_2",
      "src": "「ここを開けろお！ 早く開けろお！」",
      "text": "「把这里打开！快点打开！」"
    },
    {
      "name": "CHA_ST05EVENT1_SM2_1",
      "src": "「ああ わかった わかった 行ってやるよ……」",
      "text": "「啊啊，知道了知道了，我去就是了……」"
    },
    {
      "name": "CHA_ST05EVENT2_MIY_0",
      "src": "「これで向こうへ……」",
      "text": "这样就能到对面……"
    },
    {
      "name": "CHA_ST05EVENT2_SF2_0",
      "src": "「大変なんだよお……来ておくれよお……」",
      "text": "「出大事了啊……过来呀……」"
    },
    {
      "name": "CHA_ST05EVENT3_MIY_0",
      "src": "「いやっ！ 入って来るな！」",
      "text": "「不要！别进来！」"
    },
    {
      "name": "CHA_ST05EVENT3_MIY_1",
      "src": "「お前らなんか大嫌いだ！」",
      "text": "我最讨厌你们这些家伙！"
    },
    {
      "name": "CHA_ST05EVENT3_MIY_2",
      "src": "「あっちに行け！」",
      "text": "「滚那边去！」"
    },
    {
      "name": "CHA_ST05EVENT4_MIY_0",
      "src": "「退い！ ……愚図」",
      "text": "「迟钝！……蠢货」"
    },
    {
      "name": "CHA_ST99EVENT1_MIY_1",
      "src": "「来るな！ 来るなあ！」",
      "text": "「别过来！别过来啊！」"
    },
    {
      "name": "CHA_ST99EVENT1_MIY_2",
      "src": "「あっちに行け！」",
      "text": "「滚那边去！」"
    },
    {
      "name": "CHA_ST99EVENT2_MIY_1",
      "src": "「助けてっ！」",
      "text": "「救命！」"
    },
    {
      "name": "CHA_ST99EVENT2_MIY_2",
      "src": "「いやっ！ 死にたくないっ！」",
      "text": "「不要！我不想死！」"
    },
    {
      "name": "CHA_THANKS_MIY_1",
      "src": "「壁れた……」",
      "text": "上来了……"
    },
    {
      "name": "CHA_THANKS_MIY_2",
      "src": "「ありがとう……」",
      "text": "「谢谢……」"
    },
    {
      "name": "CHA_WAITLONG_MIY_0",
      "src": "「私は……生け贄なんかじやない」",
      "text": "「我……才不是什么祭品」"
    },
    {
      "name": "CHA_WAITLONG_MIY_1",
      "src": "「死ぬなんて……もう絶対に嫌」",
      "text": "「我才不要死……绝对不要」"
    },
    {
      "name": "CHA_WAITLONG_MIY_2",
      "src": "「私の血の杯……永遠の契約の血」",
      "text": "「我的血之杯……永远之契约之血」"
    },
    {
      "name": "CHA_WAITNEAR_MIY_0",
      "src": "「これからどうする？」",
      "text": "「接下来怎么办？」"
    },
    {
      "name": "CHA_WAITNEAR_MIY_1",
      "src": "「急がないと……！」",
      "text": "「不快点不行……！」"
    },
    {
      "name": "CHA_WAITNEAR_MIY_2",
      "src": "「早く……早く村から出たい」",
      "text": "「快点……我想快点离开村子」"
