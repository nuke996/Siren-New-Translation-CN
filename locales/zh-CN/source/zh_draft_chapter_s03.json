    {
      "name": "CHA_BATTLEEND_KYU_0",
      "src": "「無事ですか？」",
      "text": "「您没事吗？」"
    },
    {
      "name": "CHA_BATTLEEND_KYU_1",
      "src": "「ああ 神よ……」",
      "text": "「啊啊，神啊……」"
    },
    {
      "name": "CHA_BATTLEEND_KYU_2",
      "src": "「どうしてこんなことに……」",
      "text": "「怎么会变成这样……」"
    },
    {
      "name": "CHA_CAHURRYUP_KYU_0",
      "src": "「急いで！ 隠れましよう！」",
      "text": "「快点！躲起来吧！」"
    },
    {
      "name": "CHA_CAHURRYUP_KYU_1",
      "src": "「早く！ 逃げましよう！」",
      "text": "「快！逃吧！」"
    },
    {
      "name": "CHA_CAHURRYUP_KYU_2",
      "src": "「ああ……どうしたの？」",
      "text": "「啊啊……怎么了？」"
    },
    {
      "name": "CHA_CAUTION1_KYU_2",
      "src": "「見つかった！？」",
      "text": "「被发现了！？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_0",
      "src": "「んっ？ 誰だい？」",
      "text": "「嗯？是谁？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_1",
      "src": "「誰かいるのかあ？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_2",
      "src": "「そこに誰かいるねえ？」",
      "text": "「那边是不是有人？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_0",
      "src": "「ん～？ 誰だあ～？」",
      "text": "「嗯～？是谁呀～？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_1",
      "src": "「おい……誰かいるのかあ？」",
      "text": "「喂……有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_2",
      "src": "「何だあ？ おい？」",
      "text": "「干什么？喂？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_1",
      "src": "「そこかあ～？」",
      "text": "「在那边吗～？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_2",
      "src": "「ああ？ 誰だあ？」",
      "text": "「啊？是谁？」"
    },
    {
      "name": "CHA_CAUTION2_SF2_0",
      "src": "「ああっ！ 頭に来るねえ……」",
      "text": "「啊啊！真气人……」"
    },
    {
      "name": "CHA_CAUTION2_SF2_1",
      "src": "「こらあ！ 出て来い」",
      "text": "「喂！出来」"
    },
    {
      "name": "CHA_CAUTION2_SF2_2",
      "src": "「じっとしてなって言ってんだよお！」",
      "text": "「叫你别动啊！」"
    },
    {
      "name": "CHA_CAUTION2_SM2_0",
      "src": "「戻って……来いよお」",
      "text": "「回来……啊」"
    },
    {
      "name": "CHA_CAUTION2_SM2_1",
      "src": "「どこ……行ったあ？」",
      "text": "「跑哪……去了？」"
    },
    {
      "name": "CHA_CAUTION2_SM2_2",
      "src": "「無駄だよお」",
      "text": "「没用的」"
    },
    {
      "name": "CHA_CAUTION2_SM4_0",
      "src": "「こらあ！ 出て来いい！」",
      "text": "「喂！出来！」"
    },
    {
      "name": "CHA_CAUTION2_SM4_1",
      "src": "「どこ行ったあ……」",
      "text": "「跑哪去了……」"
    },
    {
      "name": "CHA_CAUTION2_SM4_2",
      "src": "「くそお……逃げ足の早い……」",
      "text": "「可恶……跑得真快……」"
    },
    {
      "name": "CHA_COUNTER_KYU_0",
