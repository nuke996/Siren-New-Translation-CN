    },
    {
      "name": "CHA_ST03EVENT21_KYU",
      "src": "「裏口を探して外へ出てください！ 見つからない様に気をつけて」",
      "text": "「找找后门到外面去！小心别被发现」"
    },
    {
      "name": "CHA_ST03EVENT22_KYU",
      "src": "「良かった 無事だったんですね……」",
      "text": "「太好了，你没事啊……」"
    },
    {
      "name": "CHA_ST03EVENT23_KYU_0",
      "src": "「あそこを何とかやり過ごす方法は……」",
      "text": "「有没有办法通过那里……」"
    },
    {
      "name": "CHA_ST03EVENT23_KYU_1",
      "src": "「あの看板……使えないでしようか？」",
      "text": "「那个招牌……能不能用上？」"
    },
    {
      "name": "CHA_ST03EVENT23_KYU_2",
      "src": "「何か考えないと一一」",
      "text": "「得想想办法——」"
    },
    {
      "name": "CHA_ST03EVENT24_KYU",
      "src": "「どこに行っていたのですか？」",
      "text": "「你去哪了？」"
    },
    {
      "name": "CHA_ST03EVENT25_KYU_0",
      "src": "「あともう少しなのに……何とかできないでしようか？」",
      "text": "「就差一点了……不能想想办法吗？」"
    },
    {
      "name": "CHA_ST03EVENT25_KYU_1",
      "src": "「罠をしかけられないでしようか？」",
      "text": "「能不能设个陷阱？」"
    },
    {
      "name": "CHA_ST03EVENT25_KYU_2",
      "src": "「何か出来ることは一一」",
      "text": "「有没有能做的事——」"
    },
    {
      "name": "CHA_ST03EVENT26_KYU_0",
      "src": "「一緒に行きましよう」",
      "text": "「一起走吧」"
    },
    {
      "name": "CHA_ST03EVENT26_KYU_1",
      "src": "「後についてきてください」",
      "text": "「请跟在我后面」"
    },
    {
      "name": "CHA_ST03EVENT26_KYU_2",
      "src": "「こっちです」",
      "text": "「这边」"
    },
    {
      "name": "CHA_ST03EVENT2_KYU_0",
      "src": "「目を閉じて 意識を集中してください」",
      "text": "「闭上眼睛，集中意识」"
    },
    {
      "name": "CHA_ST03EVENT2_KYU_1",
      "src": "「何か見えますか？」",
      "text": "「看到什么了吗？」"
    },
    {
      "name": "CHA_ST03EVENT3_KYU_0",
      "src": "「私に意識を集中してください」",
      "text": "「把意识集中到我身上」"
    },
    {
      "name": "CHA_ST03EVENT3_KYU_1",
      "src": "「私の意識を探して」",
      "text": "「寻找我的意识」"
    },
    {
      "name": "CHA_ST03EVENT3_KYU_2",
