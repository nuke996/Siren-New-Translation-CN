    {
      "name": "CHA_AFTERDRAT_CAS_0",
      "src": "「やっと会えたね！」",
      "text": "「终于见到你了！」"
    },
    {
      "name": "CHA_AFTERDRAT_CAS_1",
      "src": "「ベイビーちやん 手間かけさぜないでおくれよ」",
      "text": "「小宝贝，别让叔叔费事啊。」"
    },
    {
      "name": "CHA_AFTERDRAT_CAS_2",
      "src": "「惜しかったな！」",
      "text": "「真可惜啊！」"
    },
    {
      "name": "CHA_BATTLE_CAS_0",
      "src": "「ベラ！ ベラ～！ ベラ～！」",
      "text": "「贝拉！贝拉～！贝拉～！」"
    },
    {
      "name": "CHA_BATTLE_CAS_1",
      "src": "「もう逃がさないそお～」",
      "text": "「不会再让你逃了哦～」"
    },
    {
      "name": "CHA_CAUTION1_CAS_1",
      "src": "「聞こえるよ～！」",
      "text": "「听得见哦～！」"
    },
    {
      "name": "CHA_CAUTION1_CAS_2",
      "src": "「わかったそ！ そこにいるんだね！」",
      "text": "「我知道了！你就在那儿吧！」"
    },
    {
      "name": "CHA_CAUTION1_HNF_0",
      "src": "「誰カイルウ？」",
      "text": "「有人吗……？」"
    },
    {
      "name": "CHA_CAUTION1_HNF_1",
      "src": "「アヤシィワ！ アヤシィワ！」",
      "text": "「好可疑啊！好可疑啊！」"
    },
    {
      "name": "CHA_CAUTION1_HNF_2",
      "src": "「誰ダア～！」",
      "text": "「是谁啊～！」"
    },
    {
      "name": "CHA_CAUTION1_KAF_0",
      "src": "「ナア～ニィ～？」",
      "text": "「哪～儿～？」"
    },
    {
      "name": "CHA_CAUTION1_KAF_1",
      "src": "「誰カシラア？」",
      "text": "「是谁呀～？」"
    },
    {
      "name": "CHA_CAUTION1_KAF_2",
      "src": "「ニオイ ガ スルワネエ～」",
      "text": "「有东西在动呢～」"
    },
    {
      "name": "CHA_CAUTION1_SF1_0",
      "src": "「ん？ 何の音？」",
      "text": "「嗯？什么声音？」"
    },
    {
      "name": "CHA_CAUTION1_SF1_1",
      "src": "「誰かいるのお？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SF1_2",
      "src": "「だあーれ？ 誰かしらあ？」",
      "text": "「是～谁啊？是哪位呀？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_0",
      "src": "「んっ？ 誰だい？」",
      "text": "「嗯？是谁啊？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_1",
      "src": "「誰かいるのかあ？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_2",
      "src": "「そこに誰かいるねえ？」",
      "text": "「那边有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_1",
      "src": "「そこかあ～？」",
      "text": "「在那儿吗～？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_2",
      "src": "「ああ？ 誰だあ？」",
      "text": "「啊啊？是谁啊？」"
    },
    {
      "name": "CHA_CAUTION2_CAS_0",
      "src": "「お～い 逃げないでくれよ」",
      "text": "「喂～别跑啊。」"
    },
    {
      "name": "CHA_CAUTION2_CAS_1",
      "src": "「冗談きついせ……」",
      "text": "这玩笑太过分了…"
    },
    {
      "name": "CHA_CAUTION2_CAS_2",
      "src": "「出ておいで～子猫ちやん～」",
      "text": "「出来呀～小猫咪～」"
    },
    {
      "name": "CHA_CAUTION2_HNF_0",
      "src": "「イナイッ！ イナイィ～」",
      "text": "「没有！没有啊～」"
    },
    {
      "name": "CHA_CAUTION2_HNF_1",
      "src": "「ドコオ？ ドコオ？」",
      "text": "「在哪儿？在哪儿？」"
    },
    {
      "name": "CHA_CAUTION2_HNF_2",
      "src": "「コラ！ 出テ来イィ～！」",
      "text": "「喂！出来啊～！」"
    },
    {
      "name": "CHA_CAUTION2_KAF_0",
      "src": "「ネエ……ドコナノオ？」",
      "text": "「喂……哪里有人吗？」"
    },
    {
      "name": "CHA_CAUTION2_KAF_1",
      "src": "「帰ッテ来テヨオ～」",
      "text": "「快回来啊～」"
    },
    {
      "name": "CHA_CAUTION2_KAF_2",
      "src": "「淋シイワア～」",
      "text": "「好寂寞啊～」"
    },
    {
      "name": "CHA_CAUTION2_SF1_0",
      "src": "「ああ……もう嫌ねえ」",
      "text": "「啊啊……真受不了。」"
    },
    {
      "name": "CHA_CAUTION2_SF1_1",
      "src": "「どこに行ったのよお」",
      "text": "「跑哪儿去了呀。」"
    },
    {
      "name": "CHA_CAUTION2_SF1_2",
      "src": "「もお……出て来なさいよお」",
      "text": "「真是的……出来啊。」"
    },
    {
      "name": "CHA_CAUTION2_SF2_0",
      "src": "「ああっ！ 頭に来るねえ……」",
      "text": "「啊啊！真让人火大……」"
    },
    {
      "name": "CHA_CAUTION2_SF2_1",
      "src": "「こらあ！ 出て来い」",
      "text": "「喂！出来！」"
    },
    {
      "name": "CHA_CAUTION2_SF2_2",
      "src": "「じっとしてなって言ってんだよお！」",
      "text": "「叫你别动听不懂吗！」"
    },
    {
      "name": "CHA_CAUTION2_SM4_0",
      "src": "「こらあ！ 出て来いい！」",
      "text": "「喂！快出来！」"
    },
    {
      "name": "CHA_CAUTION2_SM4_1",
      "src": "「どこ行ったあ……」",
      "text": "「跑哪儿去了……」"
    },
    {
      "name": "CHA_CAUTION2_SM4_2",
      "src": "「くそお……逃げ足の早い……」",
      "text": "「可恶……跑得真快……」"
    },
    {
      "name": "CHA_DIE_MUS",
      "src": "「いやあ一一！」",
      "text": "「不要啊——！」"
    },
    {
      "name": "CHA_PATROL_CAS_0",
      "src": "「ベラ……もう大丈夫だよ」",
      "text": "「贝拉……已经没事了。」"
    },
    {
      "name": "CHA_PATROL_CAS_1",
      "src": "「信じてくれよ……ボクが守ってあげるよ」",
      "text": "「相信我吧……我会保护你的。」"
    },
    {
      "name": "CHA_PATROL_CAS_2",
      "src": "「ベラ ボク メリッサ 幸ぜな家族になろうせ」",
      "text": "「贝拉、我、梅丽莎，组成幸福的一家人吧。」"
    },
    {
      "name": "CHA_PATROL_CAS_4",
      "src": "「眺ずかしがらないで出ておいで……」",
      "text": "「别害羞，出来吧……」"
    },
    {
      "name": "CHA_ST99EVENT1_CAS_0",
      "src": "「はいチ～ズ～」",
      "text": "「来，茄～子～」"
    },
    {
      "name": "CHA_ST99EVENT1_CAS_1",
      "src": "「笑っておくれよお～」",
      "text": "「笑一个嘛～」"
    },
    {
      "name": "CHA_STARTST10_MUS_0",
      "src": "「すっごくきれい……！」",
      "text": "「非常漂亮……！」"
    },
    {
      "name": "CHA_STARTST10_MUS_1",
      "src": "「天使……？」",
      "text": "「天使……？」"
    },
    {
      "name": "CHA_STARTST10_MUS_2",
      "src": "「ハックシヨン ハックシヨン 転んじやおう」",
      "text": "「啊嚏、啊嚏，干脆摔一跤算了」"
    },
