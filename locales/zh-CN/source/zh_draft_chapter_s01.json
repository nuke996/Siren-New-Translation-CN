      "name": "S01_MESSAGE_001",
      "src": "建て付けが悪いのか、開かないようだ。",
      "text": "可能装得不好，似乎打不开。"
    },
    {
      "name": "S99_AREA_OVER1",
      "src": "戻る訳にはいかない。",
      "text": "不能回头。"
    },
    {
      "name": "S99_AREA_OVER10",
      "src": "サムを置いていく訳にはいかない……。",
      "text": "不能丢下山姆……"
    },
    {
      "name": "S99_AREA_OVER11",
      "src": "この先には用がない……。",
      "text": "前方没有要办的事……"
    },
    {
      "name": "S99_AREA_OVER2",
      "src": "この先は危険だ……。",
      "text": "前方危险……"
    },
    {
      "name": "S99_AREA_OVER3",
      "src": "目的を果たさなければならない。",
      "text": "必须完成目的。"
    },
    {
      "name": "S99_AREA_OVER4",
      "src": "美耶古を置いていく訳にはいかない……。",
      "text": "不能丢下美耶古……"
    },
    {
      "name": "S99_AREA_OVER5",
      "src": "メリッサを置いていく訳にはいかない……。",
      "text": "不能丢下梅丽莎……"
    },
    {
      "name": "S99_AREA_OVER6",
      "src": "アマナを置いていく訳にはいかない……。",
      "text": "不能丢下阿玛娜……"
    },
    {
      "name": "S99_AREA_OVER7",
      "src": "ベラを置いていく訳にはいかない……。",
      "text": "不能丢下贝拉……"
    },
    {
      "name": "S99_AREA_OVER8",
      "src": "ベラを探さなければ……。",
      "text": "必须找到贝拉……"
    },
    {
      "name": "S99_AREA_OVER9",
      "src": "技が折れている。ここからは戻れそうにない。",
      "text": "树枝折断了，从这里似乎回不去了。"
    },
    {
      "name": "S99_BUSY",
