    {
      "name": "CHA_CAUTION1_CHU_ST01_0",
      "src": "「ん～？ そこかなあ～？」",
      "text": "「嗯～？是在那边吗～？」"
    },
    {
      "name": "CHA_CAUTION1_CHU_ST01_1",
      "src": "「Ｙｏｕ！ 大人しく出てきなさい」",
      "text": "「You！乖乖出来」"
    },
    {
      "name": "CHA_CAUTION1_CHU_ST01_2",
      "src": "「おい……そこから動くなよお？」",
      "text": "「喂……别从那儿动啊？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_0",
      "src": "「んっ？ 誰だい？」",
      "text": "「嗯？是谁？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_1",
      "src": "「誰かいるのかあ？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_2",
      "src": "「そこに誰かいるねえ？」",
      "text": "「那边是不是有人？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_0",
      "src": "「ん～？ 誰だあ～？」",
      "text": "「嗯～？是谁呀～？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_1",
      "src": "「おい……誰かいるのかあ？」",
      "text": "「喂……有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_2",
      "src": "「何だあ？ おい？」",
      "text": "「干什么？喂？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_1",
      "src": "「そこかあ～？」",
      "text": "「在那边吗～？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_2",
      "src": "「ああ？ 誰だあ？」",
      "text": "「啊？是谁？」"
    },
    {
      "name": "CHA_CAUTION2_CHU_ST01_0",
      "src": "「くそっ！ 馬鹿にしやがって」",
      "text": "「可恶！竟敢耍我」"
    },
    {
      "name": "CHA_CAUTION2_CHU_ST01_1",
      "src": "「カムバックだよ！ カムバック！」",
      "text": "「Come back！回来！」"
    },
    {
      "name": "CHA_CAUTION2_CHU_ST01_2",
      "src": "「絶対に見つけてやるからな！」",
      "text": "「我一定会找到你的！」"
    },
    {
      "name": "CHA_CAUTION2_SF2_0",
      "src": "「ああっ！ 頭に来るねえ……」",
      "text": "「啊啊！真气人……」"
    },
    {
      "name": "CHA_CAUTION2_SF2_1",
      "src": "「こらあ！ 出て来い」",
      "text": "「喂！出来」"
    },
    {
      "name": "CHA_CAUTION2_SF2_2",
      "src": "「じっとしてなって言ってんだよお！」",
      "text": "「叫你别动啊！」"
    },
    {
      "name": "CHA_CAUTION2_SM2_0",
      "src": "「戻って……来いよお」",
      "text": "「回来……啊」"
    },
    {
      "name": "CHA_CAUTION2_SM2_1",
      "src": "「どこ……行ったあ？」",
      "text": "「跑哪……去了？」"
    },
    {
      "name": "CHA_CAUTION2_SM2_2",
      "src": "「無駄だよお」",
      "text": "「没用的」"
    },
    {
      "name": "CHA_CAUTION2_SM4_0",
      "src": "「こらあ！ 出て来いい！」",
      "text": "「喂！出来！」"
    },
    {
      "name": "CHA_CAUTION2_SM4_1",
      "src": "「どこ行ったあ……」",
      "text": "「跑哪去了……」"
    },
    {
      "name": "CHA_CAUTION2_SM4_2",
      "src": "「くそお……逃げ足の早い……」",
      "text": "「可恶……跑得真快……」"
    },
    {
      "name": "CHA_FINISH_SHU_0",
      "src": "「くたばれ！」",
      "text": "「去死吧！」"
    },
    {
      "name": "CHA_FINISH_SHU_1",
      "src": "「二度と起き上がるなよ」",
      "text": "「别再爬起来了」"
    },
    {
      "name": "CHA_FINISH_SHU_2",
      "src": "「どうだっ！？」",
      "text": "「怎么样！？」"
    },
    {
      "name": "CHA_FINISH_SHU_3",
      "src": "「くそったれ！」",
      "text": "「混蛋！」"
    },
    {
      "name": "CHA_FINISH_SHU_4",
      "src": "「そのまま消えてくれ……」",
      "text": "「就这样消失吧……」"
    },
    {
      "name": "CHA_SCREAM_SHU_0",
      "src": "「お おい！」",
      "text": "「喂、喂！」"
    },
    {
      "name": "CHA_SCREAM_SHU_1",
      "src": "「おい！ しっかりしてくれ！」",
      "text": "「喂！振作点！」"
    },
    {
      "name": "CHA_SCREAM_SHU_2",
      "src": "「ちくしよう！ 何で……！？」",
      "text": "「可恶！为什么……！？」"
    },
    {
      "name": "CHA_SCREAM_SHU_3",
      "src": "「ミヤコ！」",
      "text": "「美耶古！」"
    },
    {
      "name": "CHA_ST01EVENT1_CHU_0",
      "src": "「おい！ お前 待ちなさい」",
      "text": "「喂！你给我站住」"
    },
    {
      "name": "CHA_ST01EVENT1_CHU_1",
      "src": "「ストップ！ ストップって言ってんだよ！」",
      "text": "「Stop！叫你给我停下！」"
    },
    {
      "name": "CHA_ST01EVENT1_CHU_2",
      "src": "「大人しくしろこの野郎！」",
      "text": "「老实点，你这混蛋！」"
    },
    {
      "name": "CHA_ST01EVENT1_SHU_0",
      "src": "「う 嘘だろ……！？」",
      "text": "「不、不会吧……！？」"
    },
    {
      "name": "CHA_ST01EVENT2_CHU_0",
      "src": "「どこだあ？ どこいったあ？」",
      "text": "「在哪？去哪了？」"
    },
    {
      "name": "CHA_ST01EVENT2_CHU_1",
      "src": "「おい！ こら！ 出てこい！」",
      "text": "「喂！站住！出来！」"
    },
    {
      "name": "CHA_ST01EVENT2_CHU_2",
      "src": "「絶対に逃がさないそお～」",
      "text": "「绝对不放过你哦～」"
    },
    {
      "name": "CHA_ST01EVENT3_CHU_0",
      "src": "「すいまぜん……怪しい男を見まぜんでしたかあ？」",
      "text": "「不好意思……有没有看到一个可疑的男人？」"
    },
    {
      "name": "CHA_ST01EVENT4_CHU_0",
      "src": "「Ｙｏｕ！ そこにいるんだろ？」",
      "text": "「You！你在那儿吧？」"
    },
    {
      "name": "CHA_STARTST01_SHU_0",
      "src": "「勘弁してくれよ……」",
      "text": "「饶了我吧……」"
    },
