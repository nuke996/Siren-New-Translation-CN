    {
      "name": "CHA_AFTERDRAT_RPS_0",
      "src": "「ベラ！ マミィよ！」",
      "text": "「贝拉！是妈妈呀！」"
    },
    {
      "name": "CHA_AFTERDRAT_RPS_1",
      "src": "「やっぱりベラはまだ赤ちやんね」",
      "text": "「贝拉果然还是个孩子呢」"
    },
    {
      "name": "CHA_BATTLE_RPS_0",
      "src": "「こっちにおいで！」",
      "text": "「到这边来！」"
    },
    {
      "name": "CHA_BATTLE_RPS_1",
      "src": "「ずっと一緒よ！」",
      "text": "我们永远一起！"
    },
    {
      "name": "CHA_CAUTION1_RPS_0",
      "src": "「ハニー そこにいるの？」",
      "text": "「宝贝～你在那儿吗？」"
    },
    {
      "name": "CHA_CAUTION1_RPS_1",
      "src": "「ベラ そこにいるのね？」",
      "text": "「贝拉，你在那儿吧？」"
    },
    {
      "name": "CHA_CAUTION1_SF3_0",
      "src": "「え？ なあに？ 誰？」",
      "text": "「咦？什么？谁？」"
    },
    {
      "name": "CHA_CAUTION1_SF3_1",
      "src": "「やだあ！ 怖い！」",
      "text": "「讨厌！好可怕！」"
    },
    {
      "name": "CHA_CAUTION1_SF3_2",
      "src": "「ねえ？ 誰かいるのお？」",
      "text": "「喂？有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_0",
      "src": "「ん～？ 誰だあ～？」",
      "text": "「嗯～？是谁呀～？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_1",
      "src": "「おい……誰かいるのかあ？」",
      "text": "「喂……有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_2",
      "src": "「何だあ？ おい？」",
      "text": "「干什么？喂？」"
    },
    {
      "name": "CHA_CAUTION1_SM3_1",
      "src": "「何だってえ？」",
      "text": "「你说什么？」"
    },
    {
      "name": "CHA_CAUTION1_SM3_2",
      "src": "「誰じやあ！ 出て来い！」",
      "text": "「是谁！出来！」"
    },
    {
      "name": "CHA_CAUTION2_RPS_0",
      "src": "「どこに隠れたの？」",
      "text": "「你躲哪去了？」"
    },
    {
      "name": "CHA_CAUTION2_RPS_1",
      "src": "「かくれんぼはおしまいよ」",
      "text": "「捉迷藏结束了哦」"
    },
    {
      "name": "CHA_CAUTION2_RPS_2",
      "src": "「出てきなさい」",
      "text": "「出来」"
    },
    {
      "name": "CHA_CAUTION2_SF3_0",
      "src": "「ねえ～？ どこいったのお？」",
      "text": "「喂～？去哪了呀？」"
    },
    {
      "name": "CHA_CAUTION2_SF3_1",
      "src": "「一緒に遊ばないのお～？」",
      "text": "「一起玩好不好～？」"
    },
    {
      "name": "CHA_CAUTION2_SF3_2",
      "src": "「あ～あ つまんないのお」",
      "text": "「啊～真无聊呀」"
    },
    {
      "name": "CHA_CAUTION2_SM2_0",
      "src": "「戻って……来いよお」",
      "text": "「回来……啊」"
    },
    {
      "name": "CHA_CAUTION2_SM2_1",
      "src": "「どこ……行ったあ？」",
      "text": "「跑哪……去了？」"
    },
    {
      "name": "CHA_CAUTION2_SM2_2",
      "src": "「無駄だよお」",
      "text": "「没用的」"
    },
    {
      "name": "CHA_CAUTION2_SM3_0",
      "src": "「年寄りだと思って馬鹿にしおって！」",
      "text": "「竟敢把我当老人耍！」"
    },
    {
      "name": "CHA_CAUTION2_SM3_1",
      "src": "「どこじや！ 馬鹿もん！」",
      "text": "「在哪！混账！」"
    },
    {
      "name": "CHA_CAUTION2_SM3_2",
      "src": "「次は見逃してやらんからな！」",
      "text": "「下次可不会放过你！」"
    },
    {
      "name": "CHA_DIE_MUS",
      "src": "「いやあ一一！」",
      "text": "「不要啊——！」"
    },
    {
      "name": "CHA_PATROL_RPS_0",
      "src": "「おうちに帰る時間よ」",
      "text": "「该回家了哦」"
    },
    {
      "name": "CHA_PATROL_RPS_1",
      "src": "「もう目を離さないからね」",
      "text": "「我不会再离开你身边了」"
    },
    {
      "name": "CHA_PATROL_RPS_2",
      "src": "「マミィを許して」",
      "text": "「原谅妈妈吧」"
    },
    {
      "name": "CHA_PATROL_RPS_3",
      "src": "「ベラ 遊びに行きましよう」",
      "text": "「贝拉，我们去玩吧」"
    },
    {
      "name": "CHA_ST07EVENT1_SM2_0",
      "src": "「ふあ～生き返るなあ～」",
      "text": "呼啊～真是活过来一样～"
    },
    {
      "name": "CHA_ST07EVENT1_SM2_1",
      "src": "「ふう～良い湯だねえ～」",
      "text": "「呼～好舒服的热水啊～」"
    },
    {
      "name": "CHA_ST07EVENT1_SM3_0",
      "src": "「ふあ～生き返るなあ～」",
      "text": "呼啊～真是活过来一样～"
    },
    {
      "name": "CHA_ST07EVENT1_SM3_1",
      "src": "「おおう～良い湯だなあ～」",
      "text": "「哦～好舒服的热水啊～」"
    },
    {
      "name": "CHA_ST19EVEMT1_PRS_0",
      "src": "「イタズラしちや駄目よ！」",
      "text": "「不可以恶作剧哦！」"
    },
    {
      "name": "CHA_ST19EVENT1_MUS",
      "src": "「ダディが言ってた 木に密を塗ったら虫が集まるって」",
      "text": "「爸爸说过，往树上涂蜜，虫子就会聚集过来。」"
    },
    {
      "name": "CHA_ST19EVENT1_SM3_2",
      "src": "「んん？ ばあさんかあ？ 生きとったんかあ？」",
      "text": "「嗯嗯？是老太婆吗？你还活着啊？」"
    },
    {
      "name": "CHA_ST19EVENT2_SF1_0",
      "src": "「んん？ はーい どちらさまですかあ？」",
      "text": "「嗯？你好～是哪位呀？」"
    },
    {
      "name": "CHA_ST19EVENT2_SM3_0",
      "src": "「飯かっ！ 飯の時間かあ～？」",
      "text": "「吃饭？到吃饭时间了吗～？」"
    },
    {
      "name": "CHA_STARTST19_MUS_0",
      "src": "「マミィ……」",
      "text": "「妈妈……」"
    },
    {
      "name": "CHA_STARTST19_MUS_1",
      "src": "「どうしよう……」",
      "text": "「怎么办……」"
    },
    {
      "name": "CHA_STARTST19_MUS_2",
      "src": "「もうこんなとこいやだよ……」",
      "text": "「我讨厌这种地方了……」"
    },
