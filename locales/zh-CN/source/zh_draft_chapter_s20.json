    {
      "name": "CHA_CAUTION1_KAB_0",
      "src": "「あはっ！ 見つけたあ！」",
      "text": "「啊哈！找到你啦！」"
    },
    {
      "name": "CHA_CAUTION1_KAB_1",
      "src": "「先生でしよ？ わかるんだから！」",
      "text": "「是老师吧？我一眼就知道！」"
    },
    {
      "name": "CHA_CAUTION1_KAM_0",
      "src": "「ナンダア？」",
      "text": "「什么人啊？」"
    },
    {
      "name": "CHA_CAUTION1_KAM_1",
      "src": "「誰カイルノカア？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_KAM_2",
      "src": "「怪シイナア……」",
      "text": "「好奇怪啊……」"
    },
    {
      "name": "CHA_CAUTION1_KMM_0",
      "src": "「誰ダア？」",
      "text": "「谁呀？」"
    },
    {
      "name": "CHA_CAUTION1_KMM_1",
      "src": "「ドコニイルウ？」",
      "text": "「在哪呢？」"
    },
    {
      "name": "CHA_CAUTION1_KMM_2",
      "src": "「今行クジオ！」",
      "text": "「现在过去哦！」"
    },
    {
      "name": "CHA_CAUTION1_SM1_0",
      "src": "「誰かいるのかあ？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM1_1",
      "src": "「ん？ 誰だあ？」",
      "text": "「嗯？是谁？」"
    },
    {
      "name": "CHA_CAUTION1_SM1_2",
      "src": "「ああ？ 何だあ？」",
      "text": "「啊？干什么？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_1",
      "src": "「そこかあ～？」",
      "text": "「在那边吗～？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_2",
      "src": "「ああ？ 誰だあ？」",
      "text": "「啊？是谁？」"
    },
    {
      "name": "CHA_CAUTION2_KAB_0",
      "src": "「意地悪……嫌いっ……」",
      "text": "「坏心眼……讨厌……」"
    },
    {
      "name": "CHA_CAUTION2_KAB_1",
      "src": "「先生の馬鹿っ！」",
      "text": "「老师你个笨蛋！」"
    },
    {
      "name": "CHA_CAUTION2_KAB_2",
      "src": "「もう知らないんだからっ！」",
      "text": "「我不管你了！」"
    },
    {
      "name": "CHA_CAUTION2_KAM_0",
      "src": "「カクレンボ カア？」",
      "text": "「捉迷藏呀？」"
    },
    {
      "name": "CHA_CAUTION2_KAM_1",
      "src": "「ドコ行ッタア？」",
      "text": "「去哪了？」"
    },
    {
      "name": "CHA_CAUTION2_KAM_2",
      "src": "「オオィ！ 出テ来イヨオ！」",
      "text": "「喂！出来呀！」"
    },
    {
      "name": "CHA_CAUTION2_KMM_0",
      "src": "「ドコダッ！ ドコダッ」",
      "text": "「在哪！在哪」"
    },
    {
      "name": "CHA_CAUTION2_KMM_1",
      "src": "「出テ来イ！ 出テ来イ！」",
      "text": "「出来！出来！」"
    },
    {
      "name": "CHA_CAUTION2_KMM_2",
      "src": "「隠レテモ無駄ダジオ！」",
      "text": "「躲也没用哦！」"
    },
    {
      "name": "CHA_CAUTION2_SM1_0",
      "src": "「出てこいよお～」",
      "text": "「出来呀～」"
    },
    {
      "name": "CHA_CAUTION2_SM1_1",
      "src": "「どこ行ったあ？」",
      "text": "「跑哪去了？」"
    },
    {
      "name": "CHA_CAUTION2_SM1_2",
      "src": "「隠れても無駄だそお～」",
      "text": "「躲也没用的哦～」"
    },
    {
      "name": "CHA_CAUTION2_SM4_0",
      "src": "「こらあ！ 出て来いい！」",
      "text": "「喂！出来！」"
    },
    {
      "name": "CHA_CAUTION2_SM4_1",
      "src": "「どこ行ったあ……」",
      "text": "「跑哪去了……」"
    },
    {
      "name": "CHA_CAUTION2_SM4_2",
      "src": "「くそお……逃げ足の早い……」",
      "text": "「可恶……跑得真快……」"
    },
    {
      "name": "CHA_FINISH_DOC_0",
      "src": "「どうした？」",
      "text": "「怎么了？」"
    },
    {
      "name": "CHA_FINISH_DOC_1",
      "src": "「こんなものか？」",
      "text": "「就这样而已吗？」"
    },
    {
      "name": "CHA_FINISH_DOC_2",
      "src": "「化け物め」",
      "text": "「你这怪物」"
    },
    {
      "name": "CHA_SCREAM_DOC_0",
      "src": "「良い気はしないな」",
      "text": "「真让人不舒服啊」"
    },
    {
      "name": "CHA_SCREAM_DOC_1",
      "src": "「運が無かったようだな」",
      "text": "「看来是运气不好啊」"
    },
    {
      "name": "CHA_SCREAM_DOC_2",
      "src": "「ここまでか」",
      "text": "到此为止了吗"
    },
    {
      "name": "CHA_ST20EVENT1_DOC_1",
      "src": "「これは……」",
      "text": "「这是……」"
    },
    {
      "name": "CHA_STARTST20_DOC_0",
      "src": "「運命に抗う……か」",
      "text": "「反抗命运……吗」"
    },
    {
      "name": "CHA_STARTST20_DOC_1",
      "src": "「もう 時間がない」",
      "text": "「已经没有时间了」"
    },
    {
      "name": "CHA_STARTST20_DOC_2",
      "src": "「やるべき事……か」",
      "text": "「该做的事……吗」"
    },
