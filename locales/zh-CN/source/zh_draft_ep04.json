  "lines": [
    {
      "name": "EP04_CP1_01",
      "src": "「助けて！ ダディ！ マミィ！ どこにいるの？」",
      "text": "「救命！爸爸！妈妈！你们在哪？」"
    },
    {
      "name": "EP04_CP1_02",
      "src": "「おいでベラ 僕だよ？」",
      "text": "「过来，贝拉，是我啊？」"
    },
    {
      "name": "EP04_CP1_03",
      "src": "「いやっ！」",
      "text": "「不要！」"
    },
    {
      "name": "EP04_CP1_04",
      "src": "「また外国人か？」",
      "text": "「又是外国人吗？」"
    },
    {
      "name": "EP04_CP1_05",
      "src": "「うわっ！ 来るな！ この野郎！」",
      "text": "「哇啊！别过来！你这混蛋！」"
    },
    {
      "name": "EP04_CP1_06",
      "src": "「いつの間に紛れ込んだ？」",
      "text": "「什么时候混进来的？」"
    },
    {
      "name": "EP04_CP3_01",
      "src": "「お おい！」",
      "text": "「喂、喂！」"
    },
    {
      "name": "EP04_CP3_02",
      "src": "「念の為に確認しないとな」",
      "text": "保险起见，得确认一下。"
    },
    {
      "name": "EP04_CP3_03",
      "src": "「人間だと思って助けたら怪物だったなんて全く笑えん」",
      "text": "要是救的其实是怪物，那可一点都笑不出来。"
    },
    {
      "name": "EP04_CP3_04",
      "src": "「俺を怪物と疑ってるのか？このクレイジー野郎！」",
      "text": "「你以为我是怪物吗？\n这疯家伙！」"
    },
    {
      "name": "EP04_CP3_05",
      "src": "「申し訳ありまぜんミスター」",
      "text": "「真是抱歉，先生。」"
    },
    {
      "name": "EP04_CP3_06",
      "src": "「命に関わる問題なのでね」",
      "text": "毕竟是性命攸关的问题。"
    },
    {
      "name": "EP04_CP3_07",
      "src": "「クレイジーなりに命は惜しいんですよ」",
      "text": "「就算是疯子，也是惜命的啊。」"
    },
    {
      "name": "EP04_CP3_08",
      "src": "「クレイジーなりに命は惜しいんですよ」",
      "text": "「就算是疯子，也是惜命的啊。」"
    },
    {
      "name": "EP04_CP3_09",
      "src": "「やってられんな……」",
      "text": "「真是干不下去了……」"
    },
    {
      "name": "EP04_CP3_10",
      "src": "「……ごめんね」",
      "text": "……对不起。"
    },
    {
      "name": "EP04_CP5_01",
      "src": "「誰か！ 誰かいまぜんか？」",
      "text": "「有人吗！有没有人在？」"
    }
  ]
}
