    {
      "name": "CHA_ASSISTTEXT_MIY_0",
      "src": "「一人じや無理」",
      "text": "「一个人不行」"
    },
    {
      "name": "CHA_ASSISTTEXT_MIY_1",
      "src": "「一人じや壁れない」",
      "text": "「一个人逃不掉」"
    },
    {
      "name": "CHA_ASSISTTEXT_MIY_2",
      "src": "「お願い 手を貸して」",
      "text": "「求你了，帮我一把」"
    },
    {
      "name": "CHA_BATTLEEND_MIY_0",
      "src": "「総わった？」",
      "text": "「结束了吗？」"
    },
    {
      "name": "CHA_BATTLEEND_MIY_1",
      "src": "「あいつらの気配が消えた」",
      "text": "「那些家伙的气息消失了」"
    },
    {
      "name": "CHA_BATTLEEND_MIY_2",
      "src": "「助かったの？」",
      "text": "「得救了吗？」"
    },
    {
      "name": "CHA_CACOMELONG_MIY_3",
      "src": "「早く助けて！」",
      "text": "「快来救我！」"
    },
    {
      "name": "CHA_CACOMELONG_MIY_4",
      "src": "「どこ？ どこにいるの？」",
      "text": "「哪里？你在哪里？」"
    },
    {
      "name": "CHA_CACOMELONG_MIY_5",
      "src": "「お願い！ 一緒にいて！」",
      "text": "「求你了！待在我身边！」"
    },
    {
      "name": "CHA_CAHURRYUP_MIY_3",
      "src": "「ねえ？ ねえってば！」",
      "text": "「喂？喂，听见没！」"
    },
    {
      "name": "CHA_CAHURRYUP_MIY_4",
      "src": "「どうしちやったの？」",
      "text": "「你怎么了？」"
    },
    {
      "name": "CHA_CAHURRYUP_MIY_5",
      "src": "「ねえ？ 大丈夫？」",
      "text": "「喂？你没事吧？」"
    },
    {
      "name": "CHA_CAMEET_MIY_3",
      "src": "「帰ってきた……」",
      "text": "「我回来了……」"
    },
    {
      "name": "CHA_CAMEET_MIY_4",
      "src": "「あまり離れないで……」",
      "text": "「别离我太远……」"
    },
    {
      "name": "CHA_CAMEET_MIY_5",
      "src": "「恐い……そばに居て」",
      "text": "「好可怕……在我身边」"
    },
    {
      "name": "CHA_CAUTION1_BRF_1",
      "src": "「何ダッテエ？」",
      "text": "「你说什么？」"
    },
    {
      "name": "CHA_CAUTION1_BRF_2",
      "src": "「誰ジャア！ 出テ来イ！」",
      "text": "「谁啊！滚出来！」"
    },
    {
      "name": "CHA_CAUTION1_HNF_0",
      "src": "「誰カイルウ？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_HNF_1",
      "src": "「アヤシィワ！ アヤシィワ！」",
      "text": "「好可疑啊！好可疑啊！」"
    },
    {
      "name": "CHA_CAUTION1_HNF_2",
      "src": "「誰ダア～！」",
      "text": "「谁啊～！」"
    },
    {
      "name": "CHA_CAUTION1_HNM_1",
      "src": "「怪シィジオオ？」",
      "text": "「很可疑吗？」"
    },
    {
      "name": "CHA_CAUTION1_HNM_2",
      "src": "「誰ダ？ 誰ダア！」",
      "text": "「谁？谁啊！」"
    },
    {
      "name": "CHA_CAUTION1_SF1_0",
      "src": "「ん？ 何の音？」",
      "text": "「嗯？什么声音？」"
    },
    {
      "name": "CHA_CAUTION1_SF1_1",
      "src": "「誰かいるのお？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SF1_2",
      "src": "「だあーれ？ 誰かしらあ？」",
      "text": "「是～谁呀？有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_0",
      "src": "「んっ？ 誰だい？」",
      "text": "「嗯？是谁？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_1",
      "src": "「誰かいるのかあ？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_2",
      "src": "「そこに誰かいるねえ？」",
      "text": "「那边有人吧？」"
    },
    {
      "name": "CHA_CAUTION2_BRF_0",
      "src": "「年寄リダト思ッテ馬鹿ニシオッテエ！」",
      "text": "「竟敢把老人当傻子耍！」"
    },
    {
      "name": "CHA_CAUTION2_BRF_1",
      "src": "「ドコジャ！ 馬鹿モン！」",
      "text": "「在哪儿！蠢货！」"
    },
    {
      "name": "CHA_CAUTION2_BRF_2",
      "src": "「次ハ見逃シテヤランカラナア！」",
      "text": "「下次可不会放过你！」"
    },
    {
      "name": "CHA_CAUTION2_HNF_0",
      "src": "「イナイッ！ イナイィ～」",
      "text": "「不在！不在了～」"
    },
    {
      "name": "CHA_CAUTION2_HNF_1",
      "src": "「ドコオ？ ドコオ？」",
      "text": "「哪儿？哪儿？」"
    },
    {
      "name": "CHA_CAUTION2_HNF_2",
      "src": "「コラ！ 出テ来イィ～！」",
      "text": "「喂！快出来～！」"
    },
    {
      "name": "CHA_CAUTION2_HNM_0",
      "src": "「イナイ！ イナイジオ！」",
      "text": "「不在！没人啊！」"
    },
    {
      "name": "CHA_CAUTION2_HNM_1",
      "src": "「オイ！ ドコダア！」",
      "text": "「喂！在哪儿！」"
    },
    {
      "name": "CHA_CAUTION2_HNM_2",
      "src": "「戻レ！ 卑怯ダジオ！」",
      "text": "「回来！卑怯的达里奥！」"
    },
    {
      "name": "CHA_CAUTION2_SF1_0",
      "src": "「ああ……もう嫌ねえ」",
      "text": "「啊……真讨厌」"
    },
    {
      "name": "CHA_CAUTION2_SF1_1",
      "src": "「どこに行ったのよお」",
      "text": "「跑哪儿去了呀」"
    },
    {
      "name": "CHA_CAUTION2_SF1_2",
      "src": "「もお……出て来なさいよお」",
      "text": "「真是的……快出来呀」"
    },
    {
      "name": "CHA_CAUTION2_SF2_0",
      "src": "「ああっ！ 頭に来るねえ……」",
      "text": "「啊！真气人……」"
    },
    {
      "name": "CHA_CAUTION2_SF2_1",
      "src": "「こらあ！ 出て来い」",
      "text": "「喂！出来」"
    },
    {
      "name": "CHA_CAUTION2_SF2_2",
      "src": "「じっとしてなって言ってんだよお！」",
      "text": "「都说了让你别动！」"
    },
    {
      "name": "CHA_CAWAITLONG_MIY_3",
      "src": "「ああ……どうしよう……」",
      "text": "「啊……怎么办……」"
    },
    {
      "name": "CHA_CAWAITLONG_MIY_4",
      "src": "「早く！ 早く助けに来て……！」",
      "text": "「快点！快点来救我……！」"
    },
    {
      "name": "CHA_CAWAITLONG_MIY_5",
      "src": "「どこにいるの？ 早く迎えに来て……！」",
      "text": "「你在哪里？快点来接我……！」"
    },
    {
      "name": "CHA_CAWAITNEAR_MIY_3",
      "src": "「いる！ どうしよう……」",
      "text": "「有人！怎么办……」"
    },
    {
      "name": "CHA_CAWAITNEAR_MIY_4",
