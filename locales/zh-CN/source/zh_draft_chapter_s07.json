    {
      "name": "S07_MESSAGE_002",
      "src": "理解できないものが記られている。",
      "text": "摆放着让人无法理解的东西。"
    },
    {
      "name": "S07_MESSAGE_004",
      "src": "針金を切る道具が必要だ。",
      "text": "需要有切断铁丝的工具。"
    },
    {
      "name": "S07_MESSAGE_005",
      "src": "針金が邪鬼で開けることができない。",
      "text": "铁丝挡着，打不开。"
    },
    {
      "name": "S07_MESSAGE_008",
      "src": "振り子時計がある。12時直前で針が止まっている。",
      "text": "有一座摆钟。指针停在快到12点的位置。"
    },
    {
      "name": "S07_MESSAGE_009",
      "src": "時計が動き出した。間もなく鳴りそうだ。",
      "text": "钟动起来了。似乎马上就要响了。"
    },
    {
      "name": "S07_MESSAGE_010",
      "src": "正常に稼動して、時を刻んでいる。",
      "text": "正常运转着，正在记录时间。"
    },
    {
      "name": "S07_MESSAGE_015",
      "src": "薪の火が弱々しく燃えている。これで風呂を沸かすのだろうか。",
      "text": "柴火熊熊燃烧着。是要用它来烧洗澡水吗。"
    },
    {
      "name": "S07_MESSAGE_018",
      "src": "板が打ち付けられている。ここから入ることは出来ない。",
      "text": "木板被钉住了。\n没法从这里进去。"
    },
    {
      "name": "S07_MESSAGE_021",
      "src": "火の勢いが強くなってきた。",
      "text": "火势变强了。"
    },
    {
      "name": "S07_MESSAGE_023",
      "src": "強い炎を放ち燃えている。",
      "text": "猛烈地喷着火焰燃烧着。"
    },
    {
      "name": "S07_MESSAGE_024",
      "src": "門は固く閉じられている。他の道を探すしかないようだ。",
      "text": "门紧闭着。看来只能找别的路了。"
    },
    {
      "name": "S99_AREA_OVER1",
      "src": "戻る訳にはいかない。",
      "text": "不能回头。"
    },
    {
      "name": "S99_AREA_OVER10",
      "src": "サムを置いていく訳にはいかない……。",
      "text": "不能丢下山姆……"
    },
    {
      "name": "S99_AREA_OVER11",
      "src": "この先には用がない……。",
      "text": "前方没有要办的事……"
    },
    {
      "name": "S99_AREA_OVER2",
      "src": "この先は危険だ……。",
      "text": "前方危险……"
    },
    {
      "name": "S99_AREA_OVER3",
      "src": "目的を果たさなければならない。",
      "text": "必须完成目的。"
    },
    {
      "name": "S99_AREA_OVER4",
      "src": "美耶古を置いていく訳にはいかない……。",
      "text": "不能丢下美耶古……"
    },
    {
      "name": "S99_AREA_OVER5",
      "src": "メリッサを置いていく訳にはいかない……。",
      "text": "不能丢下梅丽莎……"
    },
    {
      "name": "S99_AREA_OVER6",
      "src": "アマナを置いていく訳にはいかない……。",
      "text": "不能丢下阿玛娜……"
    },
    {
      "name": "S99_AREA_OVER7",
      "src": "ベラを置いていく訳にはいかない……。",
      "text": "不能丢下贝拉……"
    },
    {
      "name": "S99_AREA_OVER8",
      "src": "ベラを探さなければ……。",
      "text": "必须找到贝拉……"
    },
    {
      "name": "S99_AREA_OVER9",
      "src": "技が折れている。ここからは戻れそうにない。",
      "text": "树枝折断了，从这里似乎回不去了。"
    },
    {
      "name": "S99_BUSY",
      "src": "今はそれどころではない。",
      "text": "现在不是做这个的时候。"
    },
    {
      "name": "S99_MESSAGE001",
      "src": "扉は固く閉じられている。中からは物音も聞こえない。",
      "text": "门紧闭着。\n里面也听不到任何声响。"
    },
