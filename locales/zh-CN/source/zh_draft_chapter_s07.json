    {
      "name": "CHA_ASSISTTEXT_MIY_0",
      "src": "「一人じや無理」",
      "text": "「一个人不行」"
    },
    {
      "name": "CHA_ASSISTTEXT_MIY_1",
      "src": "「一人じや壁れない」",
      "text": "「一个人爬不上去」"
    },
    {
      "name": "CHA_ASSISTTEXT_MIY_2",
      "src": "「お願い 手を貸して」",
      "text": "「拜托，拉我一把」"
    },
    {
      "name": "CHA_BATTLEEND_MIY_0",
      "src": "「総わった？」",
      "text": "「结束了吗？」"
    },
    {
      "name": "CHA_BATTLEEND_MIY_1",
      "src": "「あいつらの気配が消えた」",
      "text": "「那些家伙的气息消失了」"
    },
    {
      "name": "CHA_BATTLEEND_MIY_2",
      "src": "「助かったの？」",
      "text": "「得救了吗？」"
    },
    {
      "name": "CHA_CACOMELONG_MIY_0",
      "src": "「どこ？」",
      "text": "「在哪？」"
    },
    {
      "name": "CHA_CACOMELONG_MIY_1",
      "src": "「どこにいる？」",
      "text": "「你在哪？」"
    },
    {
      "name": "CHA_CACOMELONG_MIY_2",
      "src": "「どこかで呼んでる？」",
      "text": "「是不是在哪儿叫我？」"
    },
    {
      "name": "CHA_CAHURRYUP_MIY_0",
      "src": "「ねえ？ 何してるの？」",
      "text": "「喂？你在干什么？」"
    },
    {
      "name": "CHA_CAHURRYUP_MIY_1",
      "src": "「ねえ？ どうしたの？」",
      "text": "「喂？怎么了？」"
    },
    {
      "name": "CHA_CAHURRYUP_MIY_2",
      "src": "「早く逃げないと！」",
      "text": "「得快点逃！」"
    },
    {
      "name": "CHA_CAMEET_MIY_0",
      "src": "「やっと来た」",
      "text": "「终于来了」"
    },
    {
      "name": "CHA_CAMEET_MIY_1",
      "src": "「どこに行ってた？」",
      "text": "「你去哪了？」"
    },
    {
      "name": "CHA_CAMEET_MIY_2",
      "src": "「私を待たぜるな」",
      "text": "「别让我等」"
    },
    {
      "name": "CHA_CAUTION1_SF1_0",
      "src": "「ん？ 何の音？」",
      "text": "「嗯？什么声音？」"
    },
    {
      "name": "CHA_CAUTION1_SF1_1",
      "src": "「誰かいるのお？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SF1_2",
      "src": "「だあーれ？ 誰かしらあ？」",
      "text": "「是～谁呀？有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_0",
      "src": "「んっ？ 誰だい？」",
      "text": "「嗯？是谁？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_1",
      "src": "「誰かいるのかあ？」",
      "text": "「有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SF2_2",
      "src": "「そこに誰かいるねえ？」",
      "text": "「那边是不是有人？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_0",
      "src": "「ん～？ 誰だあ～？」",
      "text": "「嗯～？是谁呀～？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_1",
      "src": "「おい……誰かいるのかあ？」",
      "text": "「喂……有人吗？」"
    },
    {
      "name": "CHA_CAUTION1_SM2_2",
      "src": "「何だあ？ おい？」",
      "text": "「干什么？喂？」"
    },
    {
      "name": "CHA_CAUTION1_SM3_1",
      "src": "「何だってえ？」",
      "text": "「你说什么？」"
    },
    {
      "name": "CHA_CAUTION1_SM3_2",
      "src": "「誰じやあ！ 出て来い！」",
      "text": "「是谁！出来！」"
    },
    {
      "name": "CHA_CAUTION1_SM4_1",
      "src": "「そこかあ～？」",
      "text": "「在那边吗～？」"
    },
    {
      "name": "CHA_CAUTION1_SM4_2",
      "src": "「ああ？ 誰だあ？」",
      "text": "「啊？是谁？」"
    },
    {
      "name": "CHA_CAUTION2_SF1_0",
      "src": "「ああ……もう嫌ねえ」",
      "text": "「啊啊……真讨厌啊」"
    },
    {
      "name": "CHA_CAUTION2_SF1_1",
      "src": "「どこに行ったのよお」",
      "text": "「跑哪去了呀」"
    },
    {
      "name": "CHA_CAUTION2_SF1_2",
      "src": "「もお……出て来なさいよお」",
      "text": "「真是的……出来呀」"
    },
    {
      "name": "CHA_CAUTION2_SF2_0",
      "src": "「ああっ！ 頭に来るねえ……」",
      "text": "「啊啊！真气人……」"
    },
    {
      "name": "CHA_CAUTION2_SF2_1",
      "src": "「こらあ！ 出て来い」",
      "text": "「喂！出来」"
    },
    {
      "name": "CHA_CAUTION2_SF2_2",
      "src": "「じっとしてなって言ってんだよお！」",
      "text": "「叫你别动啊！」"
    },
    {
      "name": "CHA_CAUTION2_SM2_0",
      "src": "「戻って……来いよお」",
      "text": "「回来……啊」"
    },
    {
      "name": "CHA_CAUTION2_SM2_1",
      "src": "「どこ……行ったあ？」",
      "text": "「跑哪……去了？」"
    },
    {
      "name": "CHA_CAUTION2_SM2_2",
      "src": "「無駄だよお」",
      "text": "「没用的」"
    },
    {
      "name": "CHA_CAUTION2_SM3_0",
      "src": "「年寄りだと思って馬鹿にしおって！」",
      "text": "「竟敢把我当老人耍！」"
    },
    {
      "name": "CHA_CAUTION2_SM3_1",
      "src": "「どこじや！ 馬鹿もん！」",
      "text": "「在哪！混账！」"
    },
    {
      "name": "CHA_CAUTION2_SM3_2",
      "src": "「次は見逃してやらんからな！」",
      "text": "「下次可不会放过你！」"
    },
    {
      "name": "CHA_CAUTION2_SM4_0",
      "src": "「こらあ！ 出て来いい！」",
      "text": "「喂！出来！」"
    },
    {
      "name": "CHA_CAUTION2_SM4_1",
      "src": "「どこ行ったあ……」",
      "text": "「跑哪去了……」"
    },
    {
      "name": "CHA_CAUTION2_SM4_2",
      "src": "「くそお……逃げ足の早い……」",
      "text": "「可恶……跑得真快……」"
    },
    {
      "name": "CHA_CAWAITLONG_MIY_0",
      "src": "「今度こそ絶対に逃げ出すんだ」",
      "text": "「这次一定要逃出去」"
    },
    {
      "name": "CHA_CAWAITLONG_MIY_1",
      "src": "「どうしよう……どこに逃げよう」",
      "text": "「怎么办……往哪逃好」"
    },
    {
      "name": "CHA_CAWAITLONG_MIY_2",
      "src": "「怖くなんかない」",
      "text": "「我才不怕」"
    },
    {
      "name": "CHA_CAWAITNEAR_MIY_0",
      "src": "「どうする？」",
      "text": "「怎么办？」"
    },
    {
      "name": "CHA_CAWAITNEAR_MIY_1",
      "src": "「早く逃げないと」",
      "text": "「得快点逃」"
    },
    {
      "name": "CHA_CAWAITNEAR_MIY_2",
      "src": "「私達……気付かれるかも？」",
      "text": "「我们……可能会被发现？」"
    },
    {
      "name": "CHA_COMELONG_MIY_0",
